<!-- =========================================================
     JHARKHAND TOURISM — SMART TRAVEL TIPS
========================================================= -->

<section
    class="tips-section"
    aria-labelledby="tips-section-title"
>

    <!-- =====================================================
         SECTION INTRO
    ====================================================== -->

    <div class="section-heading">

        <span class="section-badge">
            <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
            Smart Travel Guide
        </span>

        <h2 id="tips-section-title">
            AI travel tips for your journey
        </h2>

        <p>
            Practical recommendations to help you travel more
            thoughtfully, comfortably and confidently.
        </p>

    </div>


    <%
        const tips = Array.isArray(travelTips)
            ? travelTips
            : [];

        const tipIcons = [
            "fa-car-side",
            "fa-leaf",
            "fa-camera",
            "fa-utensils",
            "fa-triangle-exclamation"
        ];

        const tipLabels = [
            "Getting Around",
            "Sustainable Travel",
            "Photography",
            "Local Experience",
            "Travel Awareness"
        ];
    %>


    <% if (tips.length) { %>

        <!-- =================================================
             TIPS GRID
        ================================================== -->

        <div class="tips-grid">

            <% tips.forEach((tip, index) => {

                const icon = tipIcons[index % tipIcons.length];
                const label = tipLabels[index % tipLabels.length];

            %>

                <article class="tip-card">

                    <!-- =====================================
                         TIP NUMBER
                    ====================================== -->

                    <div class="tip-number" aria-hidden="true">
                        <%= String(index + 1).padStart(2, "0") %>
                    </div>


                    <!-- =====================================
                         TIP ICON
                    ====================================== -->

                    <div class="tip-icon" aria-hidden="true">

                        <i class="fa-solid <%= icon %>"></i>

                    </div>


                    <!-- =====================================
                         TIP CONTENT
                    ====================================== -->

                    <div class="tip-content">

                        <div class="tip-meta">

                            <span>
                                <i
                                    class="fa-solid fa-wand-magic-sparkles"
                                    aria-hidden="true">
                                </i>

                                AI Guide
                            </span>

                            <span>
                                <%= label %>
                            </span>

                        </div>


                        <h3>
                            Travel Tip <%= index + 1 %>
                        </h3>


                        <p>
                            <%= tip %>
                        </p>


                        <div class="tip-footer">

                            <span>
                                <i
                                    class="fa-solid fa-check"
                                    aria-hidden="true">
                                </i>

                                Keep this in mind
                            </span>

                        </div>

                    </div>

                </article>

            <% }) %>

        </div>


        <!-- =================================================
             TRAVEL GUIDE NOTE
        ================================================== -->

        <div class="tips-guide-note">

            <div
                class="tips-guide-icon"
                aria-hidden="true"
            >
                <i class="fa-solid fa-compass"></i>
            </div>

            <div class="tips-guide-content">

                <strong>
                    A better journey starts with good preparation
                </strong>

                <p>
                    Review these recommendations alongside your
                    itinerary, weather information and destination
                    highlights before you begin your trip.
                </p>

            </div>

        </div>

    <% } else { %>

        <!-- =================================================
             EMPTY STATE
        ================================================== -->

        <div class="planner-empty-state tips-empty-state">

            <div class="planner-empty-icon" aria-hidden="true">
                <i class="fa-solid fa-lightbulb"></i>
            </div>

            <h3>
                No travel tips available
            </h3>

            <p>
                Travel guidance could not be generated for this plan.
                Please try creating the itinerary again.
            </p>

            <a
                href="/planner"
                class="hero-btn"
            >
                <i
                    class="fa-solid fa-rotate-right"
                    aria-hidden="true">
                </i>

                Generate New Plan
            </a>

        </div>

    <% } %>

</section>