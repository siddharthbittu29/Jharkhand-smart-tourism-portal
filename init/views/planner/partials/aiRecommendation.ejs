<!-- =========================================================
     JHARKHAND TOURISM — AI TRAVEL ADVISOR
========================================================= -->

<section class="ai-section" aria-labelledby="ai-section-title">

    <div class="section-heading">

        <span class="section-badge">
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
            Artificial Intelligence
        </span>

        <h2 id="ai-section-title">
            Your AI Travel Advisor
        </h2>

        <p>
            Personalized travel guidance generated around your
            destination, itinerary and trip preferences.
        </p>

    </div>


    <div class="ai-panel">

        <!-- =============================================
             AI HEADER
        ============================================== -->

        <div class="ai-top">

            <div class="ai-avatar" aria-hidden="true">
                <i class="fa-solid fa-robot"></i>
            </div>

            <div class="ai-heading-content">

                <span class="ai-kicker">
                    Intelligent Travel Guidance
                </span>

                <h3>
                    Smart Travel Recommendation
                </h3>

                <small>
                    <i class="fa-solid fa-sparkles" aria-hidden="true"></i>
                    Generated with Gemini AI
                </small>

            </div>

            <div class="ai-status">

                <span class="ai-status-dot" aria-hidden="true"></span>

                <span>
                    AI Ready
                </span>

            </div>

        </div>


        <!-- =============================================
             PRIMARY AI MESSAGE
        ============================================== -->

        <div class="ai-message">

            <div class="ai-message-icon" aria-hidden="true">
                <i class="fa-regular fa-lightbulb"></i>
            </div>

            <div class="ai-message-content">

                <span class="ai-message-label">
                    Personalized recommendation
                </span>

                <% if (typeof aiRecommendation === "string") { %>

                    <p>
                        <%= aiRecommendation %>
                    </p>

                <% } else if (aiRecommendation && aiRecommendation.summary) { %>

                    <p>
                        <%= aiRecommendation.summary %>
                    </p>

                <% } else { %>

                    <p>
                        Enjoy a well-balanced journey through Jharkhand
                        while following eco-friendly travel practices and
                        exploring local culture.
                    </p>

                <% } %>

            </div>

        </div>


        <div class="ai-divider" aria-hidden="true"></div>


        <!-- =============================================
             AI GUIDANCE CARDS
        ============================================== -->

        <div class="ai-grid">

            <!-- Eco Advice -->

            <article class="ai-box ai-box-eco">

                <div class="ai-box-icon" aria-hidden="true">
                    <i class="fa-solid fa-leaf"></i>
                </div>

                <div class="ai-box-content">

                    <span class="ai-box-label">
                        Sustainable Travel
                    </span>

                    <h4>
                        Eco Advice
                    </h4>

                    <p>
                        Prefer shared transport and avoid unnecessary
                        plastic waste while exploring natural destinations.
                    </p>

                </div>

            </article>


            <!-- Budget Advice -->

            <article class="ai-box ai-box-budget">

                <div class="ai-box-icon" aria-hidden="true">
                    <i class="fa-solid fa-indian-rupee-sign"></i>
                </div>

                <div class="ai-box-content">

                    <span class="ai-box-label">
                        Smart Spending
                    </span>

                    <h4>
                        Budget Advice
                    </h4>

                    <p>
                        Your itinerary is structured to help balance
                        experiences with the available trip budget.
                    </p>

                </div>

            </article>


            <!-- Photography -->

            <article class="ai-box ai-box-photo">

                <div class="ai-box-icon" aria-hidden="true">
                    <i class="fa-solid fa-camera"></i>
                </div>

                <div class="ai-box-content">

                    <span class="ai-box-label">
                        Capture the Journey
                    </span>

                    <h4>
                        Photography
                    </h4>

                    <p>
                        Sunrise and sunset locations are included to
                        help you experience memorable landscape moments.
                    </p>

                </div>

            </article>


            <!-- AI Confidence -->

            <article class="ai-box ai-box-confidence">

                <div class="ai-box-icon" aria-hidden="true">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <div class="ai-box-content">

                    <span class="ai-box-label">
                        Recommendation Signal
                    </span>

                    <h4>
                        AI Confidence
                    </h4>

                    <div class="ai-confidence-value">
                        <strong>96</strong>
                        <span>%</span>
                    </div>

                    <div
                        class="ai-confidence-bar"
                        role="progressbar"
                        aria-label="AI confidence"
                        aria-valuenow="96"
                        aria-valuemin="0"
                        aria-valuemax="100"
                    >
                        <span style="width:96%"></span>
                    </div>

                </div>

            </article>

        </div>


        <!-- =============================================
             AI FOOTER
        ============================================== -->

        <div class="ai-footer">

            <div class="ai-footer-icon" aria-hidden="true">
                <i class="fa-solid fa-circle-info"></i>
            </div>

            <p>
                AI-generated travel guidance is designed to complement
                your itinerary. Check local conditions and availability
                before making travel decisions.
            </p>

        </div>

    </div>

</section>