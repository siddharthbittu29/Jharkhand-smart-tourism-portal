      <button
        type="button"
        class="jt-gallery-lightbox-close"
        id="jtGalleryLightboxClose"
        aria-label="Close image viewer"
      >
        <i
          class="fa-solid fa-xmark"
          aria-hidden="true"
        ></i>
      </button>


      <img
        id="jtGalleryLightboxImage"
        class="jt-gallery-lightbox-image"
        src=""
        alt=""
      >


      <div class="jt-gallery-lightbox-bottom">

        <div>

          <h2
            id="jtGalleryLightboxTitle"
            class="jt-gallery-lightbox-title"
          >
            Destination
          </h2>

          <p
            id="jtGalleryLightboxCategory"
            class="jt-gallery-lightbox-category"
          >
            Jharkhand Tourism
          </p>

        </div>

      </div>

