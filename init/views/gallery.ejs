  <!-- ==========================================================
       GALLERY JAVASCRIPT
  =========================================================== -->

  <script>
    (() => {

      "use strict";


      const cards =
        Array.from(
          document.querySelectorAll(
            ".jt-gallery-card"
          )
        );


      const filters =
        Array.from(
          document.querySelectorAll(
            ".jt-gallery-filter"
          )
        );


      const count =
        document.getElementById(
          "jtGalleryCount"
        );


      const lightbox =
        document.getElementById(
          "jtGalleryLightbox"
        );


      const lightboxImage =
        document.getElementById(
          "jtGalleryLightboxImage"
        );


      const lightboxTitle =
        document.getElementById(
          "jtGalleryLightboxTitle"
        );


      const lightboxCategory =
        document.getElementById(
          "jtGalleryLightboxCategory"
        );


      const lightboxClose =
        document.getElementById(
          "jtGalleryLightboxClose"
        );


      let previousFocus =
        null;


      /* ==========================================================
         UPDATE COUNT
      ========================================================== */

      const updateCount =
        () => {

          const visible =
            cards.filter(
              (card) =>
                !card.classList.contains(
                  "is-hidden"
                )
            ).length;


          if (count) {

            count.textContent =
              `${visible} photograph${visible === 1 ? "" : "s"}`;

          }

        };


      /* ==========================================================
         FILTER
      ========================================================== */

      filters.forEach(
        (filterButton) => {

          filterButton.addEventListener(
            "click",
            () => {

              const selected =
                filterButton.dataset.filter;


              filters.forEach(
                (button) => {

                  button.classList.toggle(
                    "active",
                    button === filterButton
                  );

                }
              );


              cards.forEach(
                (card) => {

                  const category =
                    card.dataset.category;


                  const shouldShow =
                    selected === "all" ||
                    category === selected;


                  card.classList.toggle(
                    "is-hidden",
                    !shouldShow
                  );

                }
              );


              updateCount();

            }
          );

        }
      );


      /* ==========================================================
         OPEN LIGHTBOX
      ========================================================== */

      const openLightbox =
        (card) => {

          const image =
            card.dataset.image;


          const title =
            card.dataset.title ||
            "Jharkhand destination";


          const description =
            card.dataset.description ||
            "Jharkhand Tourism";


          if (!image) {
            return;
          }


          previousFocus =
            document.activeElement;


          lightboxImage.src =
            image;


          lightboxImage.alt =
            title;


          lightboxTitle.textContent =
            title;


          lightboxCategory.textContent =
            description;


          lightbox.hidden =
            false;


          document.body.style.overflow =
            "hidden";


          lightboxClose.focus();

        };


      cards.forEach(
        (card) => {

          card.addEventListener(
            "click",
            () => {
              openLightbox(
                card
              );
            }
          );

        }
      );


      /* ==========================================================
         CLOSE LIGHTBOX
      ========================================================== */

      const closeLightbox =
        () => {

          lightbox.hidden =
            true;


          document.body.style.overflow =
            "";


          lightboxImage.src =
            "";


          if (
            previousFocus &&
            typeof previousFocus.focus ===
              "function"
          ) {

            previousFocus.focus();

          }

        };


      lightboxClose?.addEventListener(
        "click",
        closeLightbox
      );


      lightbox?.addEventListener(
        "click",
        (event) => {

          if (
            event.target ===
            lightbox
          ) {

            closeLightbox();

          }

        }
      );


      document.addEventListener(
        "keydown",
        (event) => {

          if (
            lightbox.hidden
          ) {
            return;
          }


          if (
            event.key ===
            "Escape"
          ) {

            closeLightbox();

          }

        }
      );


      updateCount();

    })();
  </script>

