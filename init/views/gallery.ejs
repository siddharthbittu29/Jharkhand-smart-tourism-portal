<main
  class="jt-gallery-page"
  aria-labelledby="galleryPageTitle"
>

  <style>
    /* ============================================================
       JHARKHAND TOURISM — VISUAL GALLERY
    ============================================================ */

    .jt-gallery-page {
      --jt-deep: #0d3928;
      --jt-green: #236044;
      --jt-green-2: #2f7a56;
      --jt-mint: #b6dfc4;
      --jt-cream: #f7f3e8;
      --jt-ink: #19342a;
      --jt-muted: #687870;
      --jt-line: rgba(18,60,43,0.11);
      --jt-soft: #eef6f0;

      width:
        100%;

      color:
        var(--jt-ink);

      background:
        linear-gradient(
          180deg,
          #ffffff 0%,
          #f7f9f6 100%
        );
    }


    /* ============================================================
       HERO
    ============================================================ */

    .jt-gallery-hero {
      position:
        relative;

      overflow:
        hidden;

      background:
        linear-gradient(
          100deg,
          rgba(8,35,24,0.96),
          rgba(14,63,43,0.75)
        ),
        url("/images/betla-national-park.jpg")
        center / cover no-repeat;
    }


    .jt-gallery-hero-inner {
      width:
        min(1240px, calc(100% - 40px));

      margin:
        0 auto;

      padding:
        58px 0 52px;
    }


    .jt-gallery-eyebrow {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        8px 11px;

      border:
        1px solid
        rgba(255,255,255,0.18);

      border-radius:
        999px;

      background:
        rgba(255,255,255,0.07);

      color:
        #eaf5ed;

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.13em;

      text-transform:
        uppercase;
    }


    .jt-gallery-eyebrow i {
      color:
        var(--jt-mint);
    }


    .jt-gallery-hero h1 {
      max-width:
        790px;

      margin:
        16px 0 0;

      color:
        #ffffff;

      font-size:
        clamp(38px, 5.6vw, 64px);

      line-height:
        1.0;

      font-weight:
        900;

      letter-spacing:
        -0.045em;
    }


    .jt-gallery-hero p {
      max-width:
        720px;

      margin:
        16px 0 0;

      color:
        rgba(255,255,255,0.76);

      font-size:
        14px;

      line-height:
        1.7;
    }


    .jt-gallery-hero-meta {
      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        8px;

      margin-top:
        21px;
    }


    .jt-gallery-hero-meta span {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        6px;

      padding:
        7px 9px;

      border:
        1px solid
        rgba(255,255,255,0.12);

      border-radius:
        9px;

      background:
        rgba(255,255,255,0.06);

      color:
        rgba(255,255,255,0.72);

      font-size:
        9px;

      font-weight:
        700;
    }


    .jt-gallery-hero-meta i {
      color:
        var(--jt-mint);
    }


    /* ============================================================
       CONTENT
    ============================================================ */

    .jt-gallery-shell {
      width:
        min(1240px, calc(100% - 40px));

      margin:
        0 auto;

      padding:
        58px 0 76px;
    }


    .jt-gallery-head {
      display:
        flex;

      justify-content:
        space-between;

      align-items:
        flex-end;

      gap:
        20px;

      margin-bottom:
        23px;
    }


    .jt-gallery-kicker {
      color:
        var(--jt-green);

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.13em;

      text-transform:
        uppercase;
    }


    .jt-gallery-head h2 {
      margin:
        5px 0 0;

      color:
        var(--jt-deep);

      font-size:
        clamp(27px, 3.5vw, 38px);

      line-height:
        1.05;

      font-weight:
        900;

      letter-spacing:
        -0.035em;
    }


    .jt-gallery-head p {
      max-width:
        520px;

      margin:
        8px 0 0;

      color:
        var(--jt-muted);

      font-size:
        11px;

      line-height:
        1.65;
    }


    .jt-gallery-count {
      flex:
        0 0 auto;

      padding:
        8px 10px;

      border:
        1px solid
        rgba(35,96,68,0.10);

      border-radius:
        999px;

      background:
        #edf6ef;

      color:
        var(--jt-green);

      font-size:
        9px;

      font-weight:
        900;

      white-space:
        nowrap;
    }


    /* ============================================================
       FILTER BAR
    ============================================================ */

    .jt-gallery-filterbar {
      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        7px;

      margin-bottom:
        16px;
    }


    .jt-gallery-filter {
      min-height:
        36px;

      padding:
        8px 11px;

      border:
        1px solid
        rgba(35,96,68,0.10);

      border-radius:
        10px;

      background:
        #ffffff;

      color:
        #63756d;

      font:
        inherit;

      font-size:
        9px;

      font-weight:
        900;

      cursor:
        pointer;
    }


    .jt-gallery-filter.active,
    .jt-gallery-filter:hover {
      border-color:
        rgba(35,96,68,0.18);

      background:
        #edf6ef;

      color:
        var(--jt-green);
    }


    /* ============================================================
       GALLERY GRID
    ============================================================ */

    .jt-gallery-grid {
      display:
        grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap:
        12px;
    }


    .jt-gallery-card {
      position:
        relative;

      overflow:
        hidden;

      min-height:
        265px;

      border:
        1px solid
        var(--jt-line);

      border-radius:
        17px;

      background:
        #e6ece7;

      cursor:
        pointer;

      box-shadow:
        0 11px 27px
        rgba(13,57,40,0.07);

      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }


    .jt-gallery-card:hover {
      transform:
        translateY(-4px);

      box-shadow:
        0 18px 36px
        rgba(13,57,40,0.13);
    }


    .jt-gallery-card.featured {
      grid-column:
        span 2;

      grid-row:
        span 2;

      min-height:
        545px;
    }


    .jt-gallery-card img {
      width:
        100%;

      height:
        100%;

      min-height:
        265px;

      display:
        block;

      object-fit:
        cover;

      transition:
        transform 350ms ease;
    }


    .jt-gallery-card.featured img {
      min-height:
        545px;
    }


    .jt-gallery-card:hover img {
      transform:
        scale(1.045);
    }


    .jt-gallery-card::after {
      content:
        "";

      position:
        absolute;

      inset:
        0;

      background:
        linear-gradient(
          180deg,
          transparent 46%,
          rgba(4,22,14,0.76) 100%
        );

      pointer-events:
        none;
    }


    .jt-gallery-card-content {
      position:
        absolute;

      left:
        14px;

      right:
        14px;

      bottom:
        14px;

      z-index:
        2;

      color:
        #ffffff;
    }


    .jt-gallery-card-tag {
      display:
        inline-flex;

      padding:
        5px 7px;

      border:
        1px solid
        rgba(255,255,255,0.15);

      border-radius:
        999px;

      background:
        rgba(4,26,17,0.66);

      color:
        #d7eee0;

      backdrop-filter:
        blur(6px);

      font-size:
        8px;

      font-weight:
        900;

      letter-spacing:
        0.06em;

      text-transform:
        uppercase;
    }


    .jt-gallery-card-content h3 {
      margin:
        7px 0 0;

      color:
        #ffffff;

      font-size:
        15px;

      line-height:
        1.15;

      font-weight:
        900;
    }


    .jt-gallery-card-content p {
      margin:
        4px 0 0;

      color:
        rgba(255,255,255,0.72);

      font-size:
        9px;

      line-height:
        1.45;
    }


    .jt-gallery-open-icon {
      position:
        absolute;

      top:
        12px;

      right:
        12px;

      z-index:
        3;

      width:
        34px;

      height:
        34px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        rgba(255,255,255,0.16);

      border-radius:
        10px;

      background:
        rgba(4,25,16,0.58);

      color:
        #ffffff;

      backdrop-filter:
        blur(7px);

      font-size:
        11px;
    }


    /* ============================================================
       HIDDEN FILTER ITEMS
    ============================================================ */

    .jt-gallery-card.is-hidden {
      display:
        none;
    }


    /* ============================================================
       LIGHTBOX
    ============================================================ */

    .jt-gallery-lightbox[hidden] {
      display:
        none !important;
    }


    .jt-gallery-lightbox {
      position:
        fixed;

      inset:
        0;

      z-index:
        9999;

      display:
        grid;

      place-items:
        center;

      padding:
        20px;

      background:
        rgba(3,17,11,0.91);

      backdrop-filter:
        blur(8px);
    }


    .jt-gallery-lightbox-inner {
      position:
        relative;

      width:
        min(1050px, 96vw);

      max-height:
        92vh;

      display:
        flex;

      flex-direction:
        column;

      overflow:
        hidden;

      border:
        1px solid
        rgba(255,255,255,0.11);

      border-radius:
        20px;

      background:
        #071810;

      box-shadow:
        0 35px 100px
        rgba(0,0,0,0.45);
    }


    .jt-gallery-lightbox-image {
      width:
        100%;

      max-height:
        76vh;

      object-fit:
        contain;

      display:
        block;

      background:
        #04120c;
    }


    .jt-gallery-lightbox-bottom {
      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

      padding:
        14px 16px;

      background:
        #092b1c;
    }


    .jt-gallery-lightbox-title {
      margin:
        0;

      color:
        #ffffff;

      font-size:
        16px;

      font-weight:
        900;
    }


    .jt-gallery-lightbox-category {
      margin:
        3px 0 0;

      color:
        rgba(255,255,255,0.58);

      font-size:
        9px;
    }


    .jt-gallery-lightbox-close {
      flex:
        0 0 auto;

      width:
        40px;

      height:
        40px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        rgba(255,255,255,0.14);

      border-radius:
        11px;

      background:
        rgba(255,255,255,0.07);

      color:
        #ffffff;

      cursor:
        pointer;
    }


    /* ============================================================
       CTA
    ============================================================ */

    .jt-gallery-cta {
      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        20px;

      margin-top:
        45px;

      padding:
        23px 25px;

      border:
        1px solid
        rgba(35,96,68,0.09);

      border-radius:
        20px;

      background:
        #edf5ef;
    }


    .jt-gallery-cta h2 {
      margin:
        0;

      color:
        var(--jt-deep);

      font-size:
        22px;

      font-weight:
        900;
    }


    .jt-gallery-cta p {
      margin:
        5px 0 0;

      color:
        var(--jt-muted);

      font-size:
        10px;

      line-height:
        1.5;
    }


    .jt-gallery-cta a {
      flex:
        0 0 auto;

      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      min-height:
        41px;

      padding:
        10px 13px;

      border-radius:
        11px;

      background:
        var(--jt-green);

      color:
        #ffffff;

      text-decoration:
        none;

      font-size:
        10px;

      font-weight:
        900;
    }


    .jt-gallery-cta a:hover {
      background:
        var(--jt-green-2);

      color:
        #ffffff;

      text-decoration:
        none;
    }


    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @media (max-width: 1050px) {

      .jt-gallery-grid {
        grid-template-columns:
          repeat(3, minmax(0,1fr));
      }

    }


    @media (max-width: 760px) {

      .jt-gallery-shell,
      .jt-gallery-hero-inner {
        width:
          min(100% - 22px, 1240px);
      }


      .jt-gallery-grid {
        grid-template-columns:
          repeat(2, minmax(0,1fr));
      }


      .jt-gallery-card.featured {
        grid-column:
          span 2;
      }


      .jt-gallery-head,
      .jt-gallery-cta {
        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .jt-gallery-cta a {
        width:
          100%;

        justify-content:
          center;
      }

    }


    @media (max-width: 470px) {

      .jt-gallery-grid {
        grid-template-columns:
          1fr;
      }


      .jt-gallery-card,
      .jt-gallery-card.featured {
        grid-column:
          span 1;

        grid-row:
          span 1;

        min-height:
          300px;
      }


      .jt-gallery-card img,
      .jt-gallery-card.featured img {
        min-height:
          300px;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      .jt-gallery-card,
      .jt-gallery-card img {
        transition:
          none !important;
      }

    }
  </style>


  <!-- ==========================================================
       HERO
  =========================================================== -->

