<main
  class="jt-festivals-page"
  aria-labelledby="festivalPageTitle"
>

  <style>
    /* ============================================================
       JHARKHAND TOURISM — FESTIVALS
    ============================================================ */

    .jt-festivals-page {
      --jt-deep: #0d3928;
      --jt-deep-2: #123f2e;
      --jt-green: #236044;
      --jt-green-2: #2f7a56;
      --jt-mint: #b6dfc4;
      --jt-earth: #a67845;
      --jt-cream: #f7f3e8;
      --jt-ink: #19342a;
      --jt-muted: #687870;
      --jt-line: rgba(18,60,43,0.11);
      --jt-soft: #eef6f0;
      --jt-white: #ffffff;

      width: 100%;
      color: var(--jt-ink);
      background:
        linear-gradient(
          180deg,
          #ffffff 0%,
          #f7f9f6 100%
        );
    }

    /* ============================================================
       HERO
    ============================================================ */

    .jt-festivals-hero {
      position: relative;
      overflow: hidden;
      min-height: 500px;

      display: flex;
      align-items: center;

      background:
        linear-gradient(
          90deg,
          rgba(6,31,21,0.95) 0%,
          rgba(9,50,33,0.83) 53%,
          rgba(9,50,33,0.44) 100%
        ),
        url("/images/khunti-tribal-villages.jpg")
        center / cover no-repeat;
    }

    .jt-festivals-hero-overlay {
      position: absolute;
      inset: 0;

      background:
        radial-gradient(
          circle at 82% 35%,
          rgba(182,223,196,0.12),
          transparent 31%
        );

      pointer-events: none;
    }

    .jt-festivals-container {
      width:
        min(1240px, calc(100% - 40px));

      margin:
        0 auto;
    }

    .jt-festivals-hero-inner {
      position: relative;
      z-index: 1;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(230px, 0.38fr);

      gap: 35px;

      align-items: end;

      padding: 70px 0 76px;
    }

    .jt-festivals-eyebrow {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding: 8px 11px;

      border:
        1px solid
        rgba(255,255,255,0.19);

      border-radius: 999px;

      background:
        rgba(255,255,255,0.07);

      color: #eaf4ed;

      font-size: 9px;

      font-weight: 900;

      letter-spacing: 0.13em;

      text-transform: uppercase;
    }

    .jt-festivals-eyebrow i {
      color:
        var(--jt-mint);
    }

    .jt-festivals-hero-copy h1 {
      max-width: 760px;

      margin: 18px 0 0;

      color: #ffffff;

      font-size:
        clamp(40px, 6vw, 68px);

      line-height: 1;

      font-weight: 900;

      letter-spacing: -0.045em;
    }

    .jt-festivals-hero-copy h1 span {
      color:
        var(--jt-mint);
    }

    .jt-festivals-hero-copy p {
      max-width: 720px;

      margin: 18px 0 0;

      color:
        rgba(255,255,255,0.78);

      font-size: 15px;

      line-height: 1.7;
    }

    .jt-festivals-hero-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 9px;

      margin-top: 25px;
    }

    .jt-festivals-primary-btn,
    .jt-festivals-secondary-btn {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      min-height: 44px;

      padding: 10px 14px;

      border-radius: 12px;

      text-decoration: none;

      font-size: 10px;

      font-weight: 900;

      transition:
        transform 160ms ease,
        background 160ms ease;
    }

    .jt-festivals-primary-btn {
      background: #ffffff;
      color: var(--jt-deep);
    }

    .jt-festivals-secondary-btn {
      border:
        1px solid
        rgba(255,255,255,0.17);

      background:
        rgba(255,255,255,0.07);

      color: #ffffff;
    }

    .jt-festivals-primary-btn:hover,
    .jt-festivals-secondary-btn:hover {
      transform: translateY(-2px);
      text-decoration: none;
    }

    .jt-festivals-primary-btn:hover {
      background: #eef6f0;
      color: var(--jt-deep);
    }

    .jt-festivals-secondary-btn:hover {
      background:
        rgba(255,255,255,0.13);

      color: #ffffff;
    }

    .jt-festivals-hero-note {
      display: flex;

      align-items: flex-start;

      gap: 11px;

      padding: 16px;

      border:
        1px solid
        rgba(255,255,255,0.13);

      border-radius: 17px;

      background:
        rgba(255,255,255,0.07);

      color: #ffffff;

      backdrop-filter: blur(9px);
    }

    .jt-festivals-hero-note > i {
      color:
        var(--jt-mint);

      margin-top: 2px;
    }

    .jt-festivals-hero-note strong {
      display: block;

      font-size: 11px;

      font-weight: 900;
    }

    .jt-festivals-hero-note span {
      display: block;

      margin-top: 4px;

      color:
        rgba(255,255,255,0.64);

      font-size: 9px;

      line-height: 1.45;
    }

    /* ============================================================
       INTRO
    ============================================================ */

    .jt-festivals-intro {
      padding: 58px 0 20px;
    }

    .jt-festivals-intro-grid {
      display: grid;

      grid-template-columns:
        minmax(0, 0.8fr)
        minmax(0, 1.2fr);

      gap: 30px;

      align-items: start;
    }

    .jt-festivals-section-kicker {
      color:
        var(--jt-green);

      font-size: 9px;

      font-weight: 900;

      letter-spacing: 0.13em;

      text-transform: uppercase;
    }

    .jt-festivals-intro h2 {
      max-width: 500px;

      margin: 7px 0 0;

      color:
        var(--jt-deep);

      font-size:
        clamp(28px, 3.8vw, 42px);

      line-height: 1.06;

      font-weight: 900;

      letter-spacing: -0.035em;
    }

    .jt-festivals-intro p {
      max-width: 650px;

      margin: 0 0 11px;

      color:
        var(--jt-muted);

      font-size: 12px;

      line-height: 1.75;
    }

    .jt-festivals-intro p:last-child {
      margin-bottom: 0;
    }

    /* ============================================================
       FESTIVAL LIST
    ============================================================ */

    .jt-festivals-list {
      padding:
        35px 0 70px;
    }

    .jt-festivals-heading {
      display: flex;

      align-items: flex-end;

      justify-content: space-between;

      gap: 20px;

      margin-bottom: 23px;
    }

    .jt-festivals-heading h2 {
      margin: 6px 0 0;

      color:
        var(--jt-deep);

      font-size:
        clamp(27px, 3.4vw, 38px);

      line-height: 1.06;

      font-weight: 900;

      letter-spacing: -0.035em;
    }

    .jt-festivals-count {
      flex: 0 0 auto;

      padding: 8px 10px;

      border:
        1px solid
        rgba(35,96,68,0.10);

      border-radius: 999px;

      background:
        #edf6ef;

      color:
        var(--jt-green);

      font-size: 9px;

      font-weight: 900;
    }

    /* ============================================================
       GRID
    ============================================================ */

    .jt-festivals-grid {
      display:
        grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 13px;
    }

    .jt-festival-card {
      overflow: hidden;

      border:
        1px solid
        var(--jt-line);

      border-radius: 18px;

      background: #ffffff;

      box-shadow:
        0 12px 30px
        rgba(13,57,40,0.07);

      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .jt-festival-card:hover {
      transform:
        translateY(-5px);

      box-shadow:
        0 19px 38px
        rgba(13,57,40,0.12);
    }

    .jt-festival-image-wrap {
      position: relative;

      height: 230px;

      overflow: hidden;

      background:
        #e5ece6;
    }

    .jt-festival-image {
      width: 100%;
      height: 100%;

      display: block;

      object-fit: cover;

      transition:
        transform 350ms ease;
    }

    .jt-festival-card:hover
      .jt-festival-image {
      transform:
        scale(1.045);
    }

    .jt-festival-number {
      position: absolute;

      top: 12px;
      right: 12px;

      width: 34px;
      height: 34px;

      display: grid;

      place-items: center;

      border:
        1px solid
        rgba(255,255,255,0.18);

      border-radius: 10px;

      background:
        rgba(5,27,18,0.64);

      color: #ffffff;

      backdrop-filter: blur(6px);

      font-size: 9px;

      font-weight: 900;
    }

    .jt-festival-content {
      padding: 17px;
    }

    .jt-festival-type {
      display: inline-flex;

      align-items: center;

      gap: 6px;

      color:
        var(--jt-earth);

      font-size: 8px;

      font-weight: 900;

      letter-spacing: 0.08em;

      text-transform: uppercase;
    }

    .jt-festival-type i {
      color:
        var(--jt-green);
    }

    .jt-festival-content h3 {
      margin:
        8px 0 0;

      color:
        var(--jt-deep);

      font-size: 17px;

      font-weight: 900;
    }

    .jt-festival-content p {
      margin:
        7px 0 0;

      color:
        var(--jt-muted);

      font-size: 10px;

      line-height: 1.65;
    }

    /* ============================================================
       CULTURAL TAG STRIP
    ============================================================ */

    .jt-festivals-tag-strip {
      display:
        grid;

      grid-template-columns:
        repeat(4, minmax(0,1fr));

      gap: 9px;

      margin-top:
        17px;
    }

    .jt-festivals-tag {
      display:
        flex;

      align-items:
        center;

      gap: 9px;

      padding:
        12px;

      border:
        1px solid
        rgba(35,96,68,0.09);

      border-radius:
        13px;

      background:
        #f4f8f4;
    }

    .jt-festivals-tag-icon {
      width:
        33px;

      height:
        33px;

      flex:
        0 0 33px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        9px;

      background:
        #e9f4ec;

      color:
        var(--jt-green);

      font-size:
        11px;
    }

    .jt-festivals-tag strong {
      display:
        block;

      color:
        var(--jt-deep);

      font-size:
        10px;

      font-weight:
        900;
    }

    .jt-festivals-tag span {
      display:
        block;

      margin-top:
        2px;

      color:
        var(--jt-muted);

      font-size:
        8px;
    }

    /* ============================================================
       CTA
    ============================================================ */

    .jt-festivals-cta {
      padding:
        0 0 65px;
    }

    .jt-festivals-cta-inner {
      display:
        grid;

      grid-template-columns:
        47px
        minmax(0,1fr)
        auto;

      gap:
        15px;

      align-items:
        center;

      padding:
        24px 25px;

      border-radius:
        21px;

      background:
        linear-gradient(
          135deg,
          #103d2b,
          #1e6246
        );

      box-shadow:
        0 20px 46px
        rgba(13,57,40,0.13);
    }

    .jt-festivals-cta-icon {
      width:
        47px;

      height:
        47px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        rgba(255,255,255,0.12);

      border-radius:
        13px;

      background:
        rgba(255,255,255,0.07);

      color:
        #bce2c7;
    }

    .jt-festivals-cta-copy > span {
      color:
        #b9dfc5;

      font-size:
        8px;

      font-weight:
        900;

      letter-spacing:
        0.12em;

      text-transform:
        uppercase;
    }

    .jt-festivals-cta-copy h2 {
      margin:
        4px 0 0;

      color:
        #ffffff;

      font-size:
        22px;

      line-height:
        1.15;

      font-weight:
        900;
    }

    .jt-festivals-cta-copy p {
      margin:
        5px 0 0;

      color:
        rgba(255,255,255,0.66);

      font-size:
        9px;

      line-height:
        1.5;
    }

    .jt-festivals-cta-btn {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      min-height:
        41px;

      padding:
        10px 13px;

      border-radius:
        11px;

      background:
        #ffffff;

      color:
        var(--jt-deep);

      text-decoration:
        none;

      font-size:
        10px;

      font-weight:
        900;
    }

    .jt-festivals-cta-btn:hover {
      background:
        #eef6f0;

      color:
        var(--jt-deep);

      text-decoration:
        none;
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @media (max-width: 1050px) {

      .jt-festivals-grid {
        grid-template-columns:
          repeat(2, minmax(0,1fr));
      }

      .jt-festivals-tag-strip {
        grid-template-columns:
          repeat(2, minmax(0,1fr));
      }

    }

    @media (max-width: 760px) {

      .jt-festivals-container {
        width:
          min(100% - 22px, 1240px);
      }

      .jt-festivals-hero-inner {
        grid-template-columns:
          1fr;

        padding:
          52px 0 58px;
      }

      .jt-festivals-hero-note {
        max-width:
          360px;
      }

      .jt-festivals-intro-grid {
        grid-template-columns:
          1fr;

        gap:
          12px;
      }

      .jt-festivals-heading {
        align-items:
          flex-start;

        flex-direction:
          column;
      }

      .jt-festivals-cta-inner {
        grid-template-columns:
          42px
          1fr;
      }

      .jt-festivals-cta-btn {
        grid-column:
          1 / -1;

        justify-content:
          center;
      }

    }

    @media (max-width: 520px) {

      .jt-festivals-grid,
      .jt-festivals-tag-strip {
        grid-template-columns:
          1fr;
      }

      .jt-festival-image-wrap {
        height:
          260px;
      }

      .jt-festivals-hero-copy h1 {
        font-size:
          clamp(37px, 11vw, 51px);
      }

      .jt-festivals-cta-inner {
        padding:
          20px;
      }

    }

    @media (prefers-reduced-motion: reduce) {

      .jt-festival-card,
      .jt-festival-image,
      .jt-festivals-primary-btn,
      .jt-festivals-secondary-btn {
        transition:
          none !important;
      }

    }
  </style>


  <!-- ==========================================================
