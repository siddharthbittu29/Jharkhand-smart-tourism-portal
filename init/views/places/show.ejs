<%
  // ============================================================
  // JHARKHAND TOURISM
  // Destination Detail Page
  // ============================================================

  const destination =
    typeof place !== 'undefined' && place
      ? place
      : {};

  const nearbyPlaces =
    typeof nearby !== 'undefined' && Array.isArray(nearby)
      ? nearby
      : [];

  /*
   * IMPORTANT:
   * Do NOT declare `const nearbyHotels`.
   * The route already provides `nearbyHotels`.
   * We copy it to a different local variable to avoid the
   * "Cannot access 'nearbyHotels' before initialization" error.
   */
  const hotelSuggestions =
    typeof nearbyHotels !== 'undefined' &&
    Array.isArray(nearbyHotels)
      ? nearbyHotels
      : [];

  const destinationName =
    destination.name ||
    'Jharkhand Destination';

  const destinationCategory =
    destination.category ||
    'Destination';

  const destinationDistrict =
    destination.district ||
    'Jharkhand';

  const destinationImage =
    destination.image ||
    '/images/placeholder.jpg';

  const destinationDescription =
    destination.long_desc ||
    destination.description ||
    destination.short_desc ||
    'Explore this destination and experience the natural, cultural and heritage beauty of Jharkhand.';

  const mapUrl =
    destination.google_map ||
    destination.map ||
    '';

  const destinationId =
    destination.place_id ||
    destination.slug ||
    destination._id ||
    '';

  let embedMapUrl = '';

  if (mapUrl) {
    embedMapUrl =
      mapUrl +
      (mapUrl.includes('?') ? '&' : '?') +
      'output=embed';
  }
%>


<main class="jt-place-detail-page">

  <!-- ==========================================================
       BACK NAVIGATION
       ========================================================== -->

  <section class="jt-place-detail-top">

    <div class="jt-container">

      <a
        href="/places"
        class="jt-place-back"
      >
        <i
          class="fa-solid fa-arrow-left"
          aria-hidden="true"
        ></i>

        <span>
          Back to destinations
        </span>
      </a>

    </div>

  </section>


  <!-- ==========================================================
       DESTINATION HERO
       ========================================================== -->

  <section class="jt-place-detail-hero">

    <div class="jt-place-detail-hero-image">

      <img
        src="<%= destinationImage %>"
        alt="<%= destinationName %>"
        loading="eager"
        onerror="this.onerror=null;this.src='/images/placeholder.jpg';"
      >

      <div class="jt-place-detail-hero-overlay"></div>

    </div>


    <div class="jt-container jt-place-detail-hero-container">

      <div class="jt-place-detail-hero-content">

        <!-- Breadcrumb -->

        <nav
          class="jt-place-detail-breadcrumb"
          aria-label="Breadcrumb"
        >

          <a href="/">
            Home
          </a>

          <i
            class="fa-solid fa-chevron-right"
            aria-hidden="true"
          ></i>

          <a href="/places">
            Explore
          </a>

          <i
            class="fa-solid fa-chevron-right"
            aria-hidden="true"
          ></i>

          <span>
            <%= destinationName %>
          </span>

        </nav>


        <!-- Category -->

        <div class="jt-place-detail-category">

          <i
            class="fa-solid fa-location-dot"
            aria-hidden="true"
          ></i>

          <span>
            <%= destinationCategory %>
          </span>

        </div>


        <!-- Title -->

        <h1>
          <%= destinationName %>
        </h1>


        <!-- Location -->

        <div class="jt-place-detail-location">

          <i
            class="fa-solid fa-map-pin"
            aria-hidden="true"
          ></i>

          <span>
            <%= destinationDistrict %>, Jharkhand
          </span>

        </div>

      </div>

    </div>

  </section>


  <!-- ==========================================================
       MAIN DESTINATION CONTENT
       ========================================================== -->

  <section class="jt-section jt-place-detail-main">

    <div class="jt-container">

      <div class="jt-place-detail-layout">


        <!-- ====================================================
             PRIMARY COLUMN
             ==================================================== -->

        <div class="jt-place-detail-primary">


          <!-- ==================================================
               ABOUT
               ================================================== -->

          <article class="jt-place-detail-card">

            <div class="jt-detail-section-heading">

              <span class="jt-eyebrow jt-eyebrow-dark">

                <i
                  class="fa-solid fa-book-open"
                  aria-hidden="true"
                ></i>

                Discover

              </span>

              <h2>
                About this destination
              </h2>

            </div>


            <div class="jt-place-description">

              <p>
                <%= destinationDescription %>
              </p>

            </div>

          </article>


          <!-- ==================================================
               ACTIONS
               ================================================== -->

          <div class="jt-place-actions">


            <% if (mapUrl) { %>

              <a
                href="<%= mapUrl %>"
                class="jt-place-action jt-place-action-primary"
                target="_blank"
                rel="noopener noreferrer"
              >

                <span class="jt-place-action-icon">

                  <i
                    class="fa-solid fa-diamond-turn-right"
                    aria-hidden="true"
                  ></i>

                </span>

                <span class="jt-place-action-text">

                  <strong>
                    Plan your visit
                  </strong>

                  <small>
                    Open location in Maps
                  </small>

                </span>

                <i
                  class="fa-solid fa-arrow-up-right-from-square jt-action-arrow"
                  aria-hidden="true"
                ></i>

              </a>

            <% } %>


            <!-- Wishlist -->

            <button
              type="button"
              class="jt-place-action"
              id="wishlistBtn"
              data-place-id="<%= destinationId %>"
              aria-pressed="false"
            >

              <span class="jt-place-action-icon">

                <i
                  class="fa-regular fa-heart"
                  aria-hidden="true"
                ></i>

              </span>

              <span class="jt-place-action-text">

                <strong>
                  Save destination
                </strong>

                <small>
                  Add to your wishlist
                </small>

              </span>

            </button>


            <!-- Share -->

            <button
              type="button"
              class="jt-place-action"
              id="shareBtn"
            >

              <span class="jt-place-action-icon">

                <i
                  class="fa-solid fa-share-nodes"
                  aria-hidden="true"
                ></i>

              </span>

              <span class="jt-place-action-text">

                <strong>
                  Share
                </strong>

                <small>
                  Share this destination
                </small>

              </span>

            </button>

          </div>


          <!-- ==================================================
               LOCATION / MAP
               ================================================== -->

          <article class="jt-place-detail-card">

            <div class="jt-detail-section-heading">

              <span class="jt-eyebrow jt-eyebrow-dark">

                <i
                  class="fa-solid fa-map-location-dot"
                  aria-hidden="true"
                ></i>

                Location

              </span>

              <h2>
                Find your way here
              </h2>

            </div>


            <% if (embedMapUrl) { %>

              <div class="jt-place-map">

                <iframe
                  src="<%= embedMapUrl %>"
                  title="Map showing <%= destinationName %>"
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>

              </div>


              <div class="jt-map-footer">

                <div class="jt-map-location">

                  <span class="jt-map-icon">

                    <i
                      class="fa-solid fa-location-dot"
                      aria-hidden="true"
                    ></i>

                  </span>

                  <div>

                    <strong>
                      <%= destinationName %>
                    </strong>

                    <span>
                      <%= destinationDistrict %>, Jharkhand
                    </span>

                  </div>

                </div>


                <a
                  href="<%= mapUrl %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="jt-map-external"
                >

                  Open in Maps

                  <i
                    class="fa-solid fa-arrow-up-right-from-square"
                    aria-hidden="true"
                  ></i>

                </a>

              </div>

            <% } else { %>

              <div class="jt-place-map-empty">

                <span>

                  <i
                    class="fa-solid fa-map-location-dot"
                    aria-hidden="true"
                  ></i>

                </span>

                <h3>
                  Location map unavailable
                </h3>

                <p>
                  Map information is not currently
                  available for this destination.
                </p>

              </div>

            <% } %>

          </article>


          <!-- ==================================================
               NEARBY DESTINATIONS
               ================================================== -->

          <article class="jt-place-detail-card">

            <div class="jt-detail-section-heading">

              <span class="jt-eyebrow jt-eyebrow-dark">

                <i
                  class="fa-solid fa-compass"
                  aria-hidden="true"
                ></i>

                Continue exploring

              </span>

              <h2>
                Nearby destinations
              </h2>

            </div>


            <% if (nearbyPlaces.length === 0) { %>

              <div class="jt-detail-empty">

                <span>

                  <i
                    class="fa-solid fa-map-location-dot"
                    aria-hidden="true"
                  ></i>

                </span>

                <p>
                  No nearby destinations are available
                  right now.
                </p>

              </div>

            <% } else { %>

              <div class="jt-nearby-grid">

                <% nearbyPlaces.forEach(function (item) { %>

                  <a
                    href="/places/<%= encodeURIComponent(item.place_id || item.slug || item._id) %>"
                    class="jt-nearby-card"
                  >

                    <div class="jt-nearby-image">

                      <img
                        src="<%= item.image || '/images/placeholder.jpg' %>"
                        alt="<%= item.name || 'Destination' %>"
                        loading="lazy"
                        onerror="this.onerror=null;this.src='/images/placeholder.jpg';"
                      >

                    </div>


                    <div class="jt-nearby-content">

                      <span class="jt-nearby-category">
                        <%= item.category || 'Destination' %>
                      </span>

                      <h3>
                        <%= item.name || 'Destination' %>
                      </h3>

                      <span class="jt-nearby-location">

                        <i
                          class="fa-solid fa-location-dot"
                          aria-hidden="true"
                        ></i>

                        <%= item.district || 'Jharkhand' %>

                      </span>

                      <span class="jt-nearby-link">

                        Explore

                        <i
                          class="fa-solid fa-arrow-right"
                          aria-hidden="true"
                        ></i>

                      </span>

                    </div>

                  </a>

                <% }); %>

              </div>

            <% } %>

          </article>

        </div>


        <!-- ====================================================
             SIDEBAR
             ==================================================== -->

        <aside class="jt-place-detail-sidebar">


          <!-- ==================================================
               QUICK INFORMATION
               ================================================== -->

          <div class="jt-detail-sidebar-card">

            <div class="jt-sidebar-card-heading">

              <span class="jt-sidebar-icon">

                <i
                  class="fa-solid fa-circle-info"
                  aria-hidden="true"
                ></i>

              </span>

              <div>

                <span>
                  Destination
                </span>

                <h3>
                  Quick information
                </h3>

              </div>

            </div>


            <div class="jt-quick-info-list">


              <!-- Category -->

              <div class="jt-quick-info-item">

                <span class="jt-quick-info-icon">

                  <i
                    class="fa-solid fa-layer-group"
                    aria-hidden="true"
                  ></i>

                </span>

                <div>

                  <small>
                    Experience
                  </small>

                  <strong>
                    <%= destinationCategory %>
                  </strong>

                </div>

              </div>


              <!-- District -->

              <div class="jt-quick-info-item">

                <span class="jt-quick-info-icon">

                  <i
                    class="fa-solid fa-map-pin"
                    aria-hidden="true"
                  ></i>

                </span>

                <div>

                  <small>
                    District
                  </small>

                  <strong>
                    <%= destinationDistrict %>
                  </strong>

                </div>

              </div>


              <!-- Destination ID -->

              <% if (destinationId) { %>

                <div class="jt-quick-info-item">

                  <span class="jt-quick-info-icon">

                    <i
                      class="fa-solid fa-fingerprint"
                      aria-hidden="true"
                    ></i>

                  </span>

                  <div>

                    <small>
                      Destination ID
                    </small>

                    <strong class="jt-place-id">
                      <%= destinationId %>
                    </strong>

                  </div>

                </div>

              <% } %>


            </div>

          </div>


          <!-- ==================================================
               SMART TOURISM / PLANNER
               ================================================== -->

          <div class="jt-detail-sidebar-card jt-planner-sidebar">

            <div class="jt-planner-sidebar-icon">

              <i
                class="fa-solid fa-wand-magic-sparkles"
                aria-hidden="true"
              ></i>

            </div>

            <span class="jt-sidebar-label">
              Smart Tourism
            </span>

            <h3>
              Planning a Jharkhand trip?
            </h3>

            <p>
              Build a personalized itinerary
              around your interests and travel plans.
            </p>

            <a
              href="/planner"
              class="jt-btn jt-btn-sidebar"
            >

              Plan my trip

              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>

            </a>

          </div>


          <!-- ==================================================
               NEARBY HOTELS
               ================================================== -->

          <div class="jt-detail-sidebar-card">

            <div class="jt-sidebar-card-heading">

              <span class="jt-sidebar-icon">

                <i
                  class="fa-solid fa-hotel"
                  aria-hidden="true"
                ></i>

              </span>

              <div>

                <span>
                  Stay nearby
                </span>

                <h3>
                  Hotels
                </h3>

              </div>

            </div>


            <% if (hotelSuggestions.length === 0) { %>

              <div class="jt-sidebar-empty">

                <i
                  class="fa-solid fa-bed"
                  aria-hidden="true"
                ></i>

                <p>
                  No nearby hotels found.
                </p>

              </div>

            <% } else { %>

              <div class="jt-nearby-hotels">

                <% hotelSuggestions.forEach(function (hotel) { %>

                  <a
                    href="/hotels/<%= hotel.id %>"
                    class="jt-hotel-mini-card"
                  >

                    <div class="jt-hotel-mini-image">

                      <img
                        src="<%= hotel.image || '/images/placeholder.jpg' %>"
                        alt="<%= hotel.name || 'Hotel' %>"
                        loading="lazy"
                        onerror="this.onerror=null;this.src='/images/placeholder.jpg';"
                      >

                    </div>


                    <div class="jt-hotel-mini-content">

                      <h4>
                        <%= hotel.name || 'Hotel' %>
                      </h4>


                      <% if (hotel.rating) { %>

                        <span class="jt-hotel-rating">

                          <i
                            class="fa-solid fa-star"
                            aria-hidden="true"
                          ></i>

                          <%= hotel.rating %>

                        </span>

                      <% } %>


                      <% if (hotel.price_from) { %>

                        <span class="jt-hotel-price">

                          From ₹<%= hotel.price_from %>

                        </span>

                      <% } %>

                    </div>


                    <i
                      class="fa-solid fa-chevron-right jt-hotel-arrow"
                      aria-hidden="true"
                    ></i>

                  </a>

                <% }); %>

              </div>


              <a
                href="/hotels"
                class="jt-view-all-link"
              >

                View all hotels

                <i
                  class="fa-solid fa-arrow-right"
                  aria-hidden="true"
                ></i>

              </a>

            <% } %>

          </div>

        </aside>

      </div>

    </div>

  </section>


  <!-- ==========================================================
       BOTTOM CTA
       ========================================================== -->

  <section class="jt-place-detail-bottom-cta">

    <div class="jt-container">

      <div class="jt-place-cta-inner">

        <div class="jt-place-cta-content">

          <span class="jt-eyebrow">

            <i
              class="fa-solid fa-map-location-dot"
              aria-hidden="true"
            ></i>

            Explore more

          </span>

          <h2>
            There is more of Jharkhand to discover.
          </h2>

          <p>
            Explore more destinations, experiences
            and places to stay across the state.
          </p>

        </div>


        <div class="jt-place-cta-actions">

          <a
            href="/places"
            class="jt-btn jt-btn-light"
          >

            Explore destinations

            <i
              class="fa-solid fa-arrow-right"
              aria-hidden="true"
            ></i>

          </a>


          <a
            href="/hotels"
            class="jt-btn jt-btn-cta-outline"
          >

            Find a stay

            <i
              class="fa-solid fa-hotel"
              aria-hidden="true"
            ></i>

          </a>

        </div>

      </div>

    </div>

  </section>

</main>


<!-- ============================================================
     DESTINATION DETAIL JAVASCRIPT
     ============================================================ -->

<script>
(function () {

  'use strict';


  /*
   * Serialize server values safely into JavaScript.
   */

  const destinationName =
    <%- JSON.stringify(destinationName) %>;

  const destinationId =
    <%- JSON.stringify(destinationId) %>;

  const destinationDistrict =
    <%- JSON.stringify(destinationDistrict) %>;

  const destinationImage =
    <%- JSON.stringify(destinationImage) %>;


  /* ==========================================================
     SHARE
     ========================================================== */

  const shareButton =
    document.getElementById('shareBtn');


  if (shareButton) {

    shareButton.addEventListener(
      'click',
      async function () {

        const shareData = {
          title: destinationName,

          text:
            'Explore ' +
            destinationName +
            ' on Jharkhand Tourism.',

          url:
            window.location.href
        };


        /*
         * Native share
         */

        if (
          navigator.share &&
          typeof navigator.share === 'function'
        ) {

          try {

            await navigator.share(
              shareData
            );

            return;

          } catch (error) {

            /*
             * User cancelled the share dialog.
             */

            if (
              error &&
              error.name === 'AbortError'
            ) {

              return;

            }

          }

        }


        /*
         * Clipboard fallback
         */

        if (
          navigator.clipboard &&
          typeof navigator.clipboard.writeText ===
            'function'
        ) {

          try {

            await navigator.clipboard.writeText(
              window.location.href
            );

            showDetailToast(
              'Destination link copied.'
            );

            return;

          } catch (error) {

            /*
             * Continue to final fallback.
             */

          }

        }


        /*
         * Older browser fallback
         */

        window.prompt(
          'Copy this destination link:',
          window.location.href
        );

      }
    );

  }


  /* ==========================================================
     WISHLIST
     ========================================================== */

  const wishlistButton =
    document.getElementById(
      'wishlistBtn'
    );


  if (wishlistButton) {

    wishlistButton.addEventListener(
      'click',
      async function () {

        if (
          this.dataset.loading === 'true'
        ) {

          return;

        }


        if (!destinationId) {

          showDetailToast(
            'This destination cannot be saved right now.'
          );

          return;

        }


        this.dataset.loading =
          'true';

        this.disabled =
          true;


        const originalContent =
          this.innerHTML;


        this.innerHTML = `
          <span class="jt-place-action-icon">
            <i class="fa-solid fa-spinner fa-spin"></i>
          </span>

          <span class="jt-place-action-text">

            <strong>
              Saving...
            </strong>

            <small>
              Please wait
            </small>

          </span>
        `;


        try {

          const response =
            await fetch(
              '/wishlist/add',
              {
                method: 'POST',

                headers: {
                  'Content-Type':
                    'application/json'
                },

                body:
                  JSON.stringify({
                    placeId:
                      destinationId,

                    placeName:
                      destinationName,

                    district:
                      destinationDistrict,

                    image:
                      destinationImage
                  })
              }
            );


          const contentType =
            response.headers.get(
              'content-type'
            ) || '';


          if (
            !contentType.includes(
              'application/json'
            )
          ) {

            throw new Error(
              'Unexpected server response.'
            );

          }


          const data =
            await response.json();


          if (
            response.ok &&
            data &&
            data.success
          ) {

            this.classList.add(
              'is-saved'
            );

            this.setAttribute(
              'aria-pressed',
              'true'
            );


            this.innerHTML = `
              <span class="jt-place-action-icon">
                <i class="fa-solid fa-heart"></i>
              </span>

              <span class="jt-place-action-text">

                <strong>
                  Saved
                </strong>

                <small>
                  Added to your wishlist
                </small>

              </span>
            `;


            showDetailToast(
              'Added to your wishlist.'
            );

          } else {

            throw new Error(
              data &&
              data.message
                ? data.message
                : 'Unable to save destination.'
            );

          }

        } catch (error) {

          console.error(
            'Wishlist error:',
            error
          );


          this.innerHTML =
            originalContent;


          showDetailToast(
            error &&
            error.message
              ? error.message
              : 'Unable to save destination.'
          );

        } finally {

          this.dataset.loading =
            'false';

          this.disabled =
            false;

        }

      }
    );

  }


  /* ==========================================================
     TOAST
     ========================================================== */

  function showDetailToast(message) {

    const existing =
      document.querySelector(
        '.jt-detail-toast'
      );


    if (existing) {

      existing.remove();

    }


    const toast =
      document.createElement(
        'div'
      );


    toast.className =
      'jt-detail-toast';


    toast.setAttribute(
      'role',
      'status'
    );


    const icon =
      document.createElement(
        'span'
      );


    icon.className =
      'jt-detail-toast-icon';


    icon.innerHTML =
      '<i class="fa-solid fa-circle-check"></i>';


    const text =
      document.createElement(
        'span'
      );


    text.textContent =
      String(message);


    toast.appendChild(
      icon
    );

    toast.appendChild(
      text
    );


    document.body.appendChild(
      toast
    );


    window.setTimeout(
      function () {

        toast.classList.add(
          'is-hiding'
        );


        window.setTimeout(
          function () {

            if (
              toast.parentNode
            ) {

              toast.remove();

            }

          },
          200
        );

      },
      2600
    );

  }


  /* ==========================================================
     IMAGE FALLBACK
     ========================================================== */

  document
    .querySelectorAll(
      '.jt-place-detail-page img'
    )
    .forEach(
      function (image) {

        image.addEventListener(
          'error',
          function () {

            if (
              this.dataset.fallbackApplied ===
              'true'
            ) {

              return;

            }


            this.dataset.fallbackApplied =
              'true';


            this.src =
              '/images/placeholder.jpg';

          }
        );

      }
    );


})();
</script>