<%
  const pageTitle = "Book Hotels";
  const currentQuery = typeof query !== "undefined" ? query : {};

  const existingDestination =
    typeof currentQuery.q !== "undefined"
      ? currentQuery.q
      : "";

  const existingCheckIn =
    typeof currentQuery.checkIn !== "undefined"
      ? currentQuery.checkIn
      : "";

  const existingCheckOut =
    typeof currentQuery.checkOut !== "undefined"
      ? currentQuery.checkOut
      : "";
%>

<style>
