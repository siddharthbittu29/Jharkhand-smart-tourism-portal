    font-weight: 700;
    white-space: nowrap;
  }

  .jt-book-field {
    position: relative;
  }

  .jt-book-field .form-label {
    display: block;
    margin-bottom: 8px;
    color: var(--book-deep);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .jt-book-input-wrap {
    position: relative;
  }

  .jt-book-input-icon {
    position: absolute;
    top: 50%;
    left: 15px;
    z-index: 2;
    transform: translateY(-50%);
    color: #668172;
    pointer-events: none;
  }

  .jt-book-input {
    min-height: 52px;
    padding-left: 43px;
    border: 1px solid #d9e2dc;
    border-radius: 13px;
    background: #fbfcfb;
    box-shadow: none;
  }

  .jt-book-input:focus {
