<section class="jt-book-page">

  <!-- HERO -->
  <section class="jt-book-hero">
    <div class="container jt-book-hero-content">
      <div class="jt-book-eyebrow">
        <i class="fa-solid fa-hotel"></i>
        Stay in Jharkhand
      </div>

      <h1 class="jt-book-title">
        Find a stay that fits your journey.
      </h1>

      <p class="jt-book-subtitle">
        Discover hotels and stays across Jharkhand and pair your accommodation
        with the destinations, festivals, nature escapes and experiences on
        your travel plan.
      </p>

      <div class="jt-book-trust-row">
        <div class="jt-book-trust">
          <i class="fa-solid fa-location-dot"></i>
          <span>Search by destination</span>
        </div>

        <div class="jt-book-trust">
          <i class="fa-regular fa-calendar"></i>
          <span>Plan your stay dates</span>
        </div>

        <div class="jt-book-trust">
          <i class="fa-solid fa-route"></i>
          <span>Connect with your itinerary</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SEARCH PANEL -->
  <div class="container jt-book-search-wrap">
    <div class="jt-book-search-card">

      <div class="jt-book-search-head">
        <div>
          <h2>Search stays across Jharkhand</h2>
          <p>Start with a destination and travel dates.</p>
        </div>

        <div class="jt-book-search-badge">
          <i class="fa-solid fa-shield-heart"></i>
          Travel planning made simple
        </div>
      </div>

      <form
        class="row g-3"
        action="/hotels"
        method="GET"
        id="hotelSearchForm"
      >

        <div class="col-lg-4">
          <div class="jt-book-field">
            <label class="form-label" for="hotelDestination">
              Destination
            </label>

            <div class="jt-book-input-wrap">
              <i class="fa-solid fa-location-dot jt-book-input-icon"></i>

              <input
                id="hotelDestination"
                name="q"
                class="form-control jt-book-input"
                type="text"
                value="<%= existingDestination %>"
                placeholder="Ranchi, Netarhat, Deoghar..."
                autocomplete="off"
              >
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="jt-book-field">
            <label class="form-label" for="checkIn">
              Check-in
            </label>

            <div class="jt-book-input-wrap">
              <i class="fa-regular fa-calendar jt-book-input-icon"></i>

              <input
                id="checkIn"
                name="checkIn"
                type="date"
                class="form-control jt-book-input"
                value="<%= existingCheckIn %>"
              >
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="jt-book-field">
            <label class="form-label" for="checkOut">
              Check-out
            </label>

            <div class="jt-book-input-wrap">
              <i class="fa-regular fa-calendar-check jt-book-input-icon"></i>

              <input
                id="checkOut"
                name="checkOut"
                type="date"
                class="form-control jt-book-input"
                value="<%= existingCheckOut %>"
              >
            </div>
          </div>
        </div>

        <div class="col-lg-2">
          <div class="jt-book-field">
            <label class="form-label d-none d-lg-block">&nbsp;</label>

            <button
              class="btn jt-book-search-btn w-100"
              type="submit"
            >
              <i class="fa-solid fa-magnifying-glass me-2"></i>
              Search
            </button>
          </div>
        </div>

      </form>

      <div class="jt-book-helper">
        <i class="fa-solid fa-circle-info"></i>
        <span>
          Your destination is used to find matching stays in the hotel directory.
        </span>
      </div>

    </div>
  </div>

  <!-- FEATURES -->
  <section class="jt-book-section">
    <div class="container">

      <div class="jt-book-section-heading">
        <div class="jt-book-kicker">Stay planning</div>

        <h2>
          More than a hotel search.
        </h2>

        <p>
          Keep accommodation connected to the larger Jharkhand Tourism
          experience, from destination discovery to trip planning.
        </p>
      </div>

      <div class="row g-4">

        <div class="col-lg-4 col-md-6">
          <article class="jt-book-feature-card">
            <div class="jt-book-feature-icon">
              <i class="fa-solid fa-map-location-dot"></i>
            </div>

            <h3>Destination-first discovery</h3>

            <p>
              Search around the places you actually want to experience instead
              of browsing a disconnected list of stays.
            </p>
          </article>
        </div>

        <div class="col-lg-4 col-md-6">
          <article class="jt-book-feature-card">
            <div class="jt-book-feature-icon">
              <i class="fa-solid fa-calendar-days"></i>
            </div>

            <h3>Travel-date planning</h3>

            <p>
              Enter your check-in and check-out dates while planning the
              accommodation side of your journey.
            </p>
          </article>
        </div>

        <div class="col-lg-4 col-md-6">
          <article class="jt-book-feature-card">
            <div class="jt-book-feature-icon">
              <i class="fa-solid fa-star"></i>
            </div>

            <h3>Explore hotel details</h3>

            <p>
              Move from the search directory to individual hotel details to
              understand the stay before making your travel decision.
            </p>
          </article>
        </div>

        <div class="col-lg-4 col-md-6">
          <article class="jt-book-feature-card">
            <div class="jt-book-feature-icon">
              <i class="fa-solid fa-sliders"></i>
            </div>

            <h3>Refine your search</h3>

            <p>
              The hotel directory can be used with destination, price,
              rating and availability filters for a more focused search.
            </p>
          </article>
        </div>

        <div class="col-lg-4 col-md-6">
          <article class="jt-book-feature-card">
            <div class="jt-book-feature-icon">
              <i class="fa-solid fa-route"></i>
            </div>

            <h3>Connect to your trip plan</h3>

            <p>
              Use the hotel directory alongside the AI Trip Planner to build
              accommodation into a broader travel itinerary.
            </p>
          </article>
        </div>

        <div class="col-lg-4 col-md-6">
          <article class="jt-book-feature-card">
            <div class="jt-book-feature-icon">
              <i class="fa-solid fa-heart"></i>
            </div>

            <h3>Keep favourite places close</h3>

            <p>
              Combine hotel discovery with places, festivals and wishlist
              features to organize the parts of Jharkhand you want to explore.
            </p>
          </article>
        </div>

      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="jt-book-section jt-book-section-soft">
    <div class="container">

      <div class="jt-book-section-heading">
        <div class="jt-book-kicker">How it works</div>

        <h2>
          Plan your stay in three steps.
        </h2>

        <p>
          A simple flow keeps accommodation discovery connected to your
          destination research.
        </p>
      </div>

      <div class="jt-book-steps">

        <article class="jt-book-step">
          <div class="jt-book-step-number">01</div>

          <h3>Choose your destination</h3>

          <p>
            Search for the district or destination closest to the experience
            you want to explore.
          </p>
        </article>

        <article class="jt-book-step">
          <div class="jt-book-step-number">02</div>

          <h3>Add your travel dates</h3>

          <p>
            Enter your planned check-in and check-out dates so your stay search
            matches your trip planning context.
          </p>
        </article>

        <article class="jt-book-step">
          <div class="jt-book-step-number">03</div>

          <h3>Explore available stays</h3>

          <p>
            Continue to the hotel directory, refine the results and open hotel
            details for the next step of your journey.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- DIRECTORY CTA -->
  <section class="jt-book-section">
    <div class="container">

      <div class="jt-book-directory">

        <div>
          <h3>Ready to explore the hotel directory?</h3>

          <p>
            Browse stays across Jharkhand directly, then refine the results
            using the available search and filtering tools.
          </p>
        </div>

        <a
          href="/hotels"
          class="jt-book-directory-btn"
        >
          Explore Hotels
          <i class="fa-solid fa-arrow-right"></i>
        </a>

      </div>

      <div class="jt-book-note">
        <i class="fa-solid fa-circle-info"></i>

        <div>
          <strong>Planning note:</strong>
          the search form starts your hotel discovery flow. Availability,
          pricing and booking actions remain dependent on the hotel directory
          and its supported data.
        </div>
      </div>

    </div>
  </section>

</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const checkIn = document.getElementById("checkIn");
    const checkOut = document.getElementById("checkOut");
    const form = document.getElementById("hotelSearchForm");

    if (!checkIn || !checkOut || !form) return;

    const today = new Date();
    const localToday =
      today.getFullYear() +
      "-" +
      String(today.getMonth() + 1).padStart(2, "0") +
      "-" +
      String(today.getDate()).padStart(2, "0");

    checkIn.min = localToday;
    checkOut.min = localToday;

    function syncCheckoutMin() {
      if (!checkIn.value) {
        checkOut.min = localToday;
        return;
      }

      checkOut.min = checkIn.value;

      if (checkOut.value && checkOut.value < checkIn.value) {
        checkOut.value = checkIn.value;
      }
    }

    checkIn.addEventListener("change", syncCheckoutMin);

    form.addEventListener("submit", function (event) {
      if (checkIn.value && checkOut.value && checkOut.value < checkIn.value) {
        event.preventDefault();

        checkOut.focus();

        if (typeof checkOut.setCustomValidity === "function") {
          checkOut.setCustomValidity(
            "Check-out must be on or after check-in."
          );
          checkOut.reportValidity();
          setTimeout(function () {
            checkOut.setCustomValidity("");
          }, 1500);
        }
      }
    });

    syncCheckoutMin();
  });
</script>