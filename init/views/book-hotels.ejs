    font-weight: 800;
  }

  .jt-book-step h3 {
    margin: 0 0 9px;
    color: var(--book-deep);
    font-size: 1.08rem;
    font-weight: 800;
  }

  .jt-book-step p {
    margin: 0;
    color: #6f7973;
    line-height: 1.7;
    font-size: 0.9rem;
  }

  .jt-book-directory {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 31px 34px;
    border-radius: 23px;
    background: var(--book-deep);
    color: #fff;
  }

  .jt-book-directory h3 {
    margin: 0 0 7px;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .jt-book-directory p {
    margin: 0;
    max-width: 680px;
    color: rgba(255,255,255,0.74);
