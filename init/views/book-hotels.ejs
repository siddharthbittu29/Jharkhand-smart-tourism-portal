      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 767.98px) {
    .jt-book-hero {
      padding: 54px 0 88px;
    }

    .jt-book-search-card {
      padding: 21px;
      border-radius: 19px;
    }

    .jt-book-search-head {
      flex-direction: column;
      margin-bottom: 17px;
    }

    .jt-book-search-badge {
      white-space: normal;
    }

    .jt-book-section {
      padding: 58px 0;
    }

