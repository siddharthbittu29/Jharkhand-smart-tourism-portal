  <!-- ==========================================================
       CLIENT-SIDE DATE VALIDATION
  =========================================================== -->

  <script>
    document.addEventListener("DOMContentLoaded", function () {

      const checkIn =
        document.getElementById("hotelCheckin");

      const checkOut =
        document.getElementById("hotelCheckout");

      const form =
        document.getElementById("hotelSearchForm");

      if (!checkIn || !checkOut || !form) {
        return;
      }


      const today = new Date();

      const localToday =
        today.getFullYear() +
        "-" +
        String(today.getMonth() + 1).padStart(2, "0") +
        "-" +
        String(today.getDate()).padStart(2, "0");


      checkIn.min = localToday;
      checkOut.min = localToday;


      function syncCheckoutMin() {

        if (!checkIn.value) {

          checkOut.min = localToday;

          return;
        }


        checkOut.min =
          checkIn.value;


        if (
          checkOut.value &&
          checkOut.value < checkIn.value
        ) {

          checkOut.value =
            checkIn.value;

        }

      }


      checkIn.addEventListener(
        "change",
        syncCheckoutMin
      );


      form.addEventListener(
        "submit",
        function (event) {

          if (
            checkIn.value &&
            checkOut.value &&
            checkOut.value < checkIn.value
          ) {

            event.preventDefault();

            checkOut.focus();


            if (
              typeof checkOut.setCustomValidity ===
              "function"
            ) {

              checkOut.setCustomValidity(
                "Check-out must be on or after check-in."
              );

              checkOut.reportValidity();


              setTimeout(
                function () {

                  checkOut.setCustomValidity("");

                },
                1600
              );

            }

          }

        }
      );


      checkOut.addEventListener(
        "change",
        function () {

          if (
            !checkOut.value ||
            !checkIn.value ||
            checkOut.value >= checkIn.value
          ) {

            checkOut.setCustomValidity("");

          }

        }
      );


      syncCheckoutMin();

    });
  </script>

