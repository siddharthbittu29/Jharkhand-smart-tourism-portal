<main class="jt-book-hotels-page">

  <style>
    /* ============================================================
       JHARKHAND TOURISM — BOOK HOTELS
    ============================================================ */

    .jt-book-hotels-page {
      --jt-book-deep: #123b2a;
      --jt-book-deep-2: #0d3022;
      --jt-book-green: #26724a;
      --jt-book-green-soft: #edf6ef;
      --jt-book-earth: #a17746;
      --jt-book-cream: #f7f4ec;
      --jt-book-ink: #19352a;
      --jt-book-muted: #6b7770;
      --jt-book-line: rgba(18, 59, 42, 0.11);

      min-height: 100vh;

      background:
        linear-gradient(
          180deg,
          #ffffff 0%,
          #f8faf8 100%
        );

      color: var(--jt-book-ink);
    }


    /* ============================================================
       HERO
    ============================================================ */

    .jt-book-hotels-hero {
      position: relative;
      overflow: hidden;

      min-height: 455px;

      display: flex;
      align-items: center;

      background:
        linear-gradient(
          90deg,
          rgba(8, 34, 24, 0.96) 0%,
          rgba(18, 59, 42, 0.87) 52%,
          rgba(18, 59, 42, 0.48) 100%
        ),
        url("/images/netarhat.jpg")
        center / cover no-repeat;

      color: #ffffff;
    }


    .jt-book-hotels-hero::after {
      content: "";

      position: absolute;
      inset: auto 0 0;

      height: 95px;

      background:
        linear-gradient(
          to top,
          #f8faf8,
          transparent
        );

      pointer-events: none;
    }


    .jt-book-hotels-container {
      width:
        min(1180px, calc(100% - 36px));

      margin: 0 auto;
    }


    .jt-book-hotels-hero-inner {
      position: relative;
      z-index: 2;

      padding:
        72px 0 96px;
    }


    .jt-book-hotels-eyebrow {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding:
        8px 12px;

      border:
        1px solid
        rgba(255, 255, 255, 0.2);

      border-radius:
        999px;

      background:
        rgba(255, 255, 255, 0.075);

      color:
        rgba(255, 255, 255, 0.9);

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.14em;

      text-transform:
        uppercase;
    }


    .jt-book-hotels-eyebrow i {
      color:
        #bee3c9;
    }


    .jt-book-hotels-title {
      max-width: 760px;

      margin:
        18px 0 0;

      font-size:
        clamp(2.55rem, 5.5vw, 4.6rem);

      line-height:
        0.99;

      font-weight:
        900;

      letter-spacing:
        -0.045em;
    }


    .jt-book-hotels-title span {
      color:
        #b8dfc3;
    }


    .jt-book-hotels-subtitle {
      max-width: 680px;

      margin:
        18px 0 0;

      color:
        rgba(255, 255, 255, 0.76);

      font-size:
        0.98rem;

      line-height:
        1.75;
    }


    .jt-book-hotels-trust-row {
      display: flex;

      flex-wrap: wrap;

      gap: 19px;

      margin-top:
        27px;
    }


    .jt-book-hotels-trust-item {
      display: flex;

      align-items: center;

      gap: 8px;

      color:
        rgba(255, 255, 255, 0.86);

      font-size:
        0.78rem;

      font-weight:
        700;
    }


    .jt-book-hotels-trust-item i {
      color:
        #c3e3ca;
    }


    /* ============================================================
       SEARCH CARD
    ============================================================ */

    .jt-book-hotels-search-wrap {
      position: relative;
      z-index: 5;

      margin-top:
        -55px;
    }


    .jt-book-hotels-search-card {
      padding:
        28px;

      border:
        1px solid
        var(--jt-book-line);

      border-radius:
        22px;

      background:
        rgba(255, 255, 255, 0.98);

      box-shadow:
        0 24px 60px
        rgba(18, 59, 42, 0.12);
    }


    .jt-book-hotels-search-header {
      display: flex;

      align-items: flex-start;

      justify-content: space-between;

      gap: 20px;

      margin-bottom:
        22px;
    }


    .jt-book-hotels-kicker {
      color:
        var(--jt-book-green);

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.14em;

      text-transform:
        uppercase;
    }


    .jt-book-hotels-search-header h2 {
      margin:
        5px 0 0;

      color:
        var(--jt-book-deep);

      font-size:
        1.28rem;

      font-weight:
        900;
    }


    .jt-book-hotels-search-header p {
      margin:
        6px 0 0;

      color:
        var(--jt-book-muted);

      font-size:
        0.82rem;
    }


    .jt-book-hotels-search-badge {
      display: inline-flex;

      align-items: center;

      gap: 7px;

      padding:
        8px 11px;

      border-radius:
        999px;

      background:
        var(--jt-book-green-soft);

      color:
        var(--jt-book-green);

      font-size:
        0.72rem;

      font-weight:
        900;

      white-space:
        nowrap;
    }


    /* ============================================================
       FIELDS
    ============================================================ */

    .jt-book-hotels-field label {
      display: block;

      margin-bottom:
        8px;

      color:
        var(--jt-book-deep);

      font-size:
        0.74rem;

      font-weight:
        900;
    }


    .jt-book-hotels-input-wrap {
      position: relative;
    }


    .jt-book-hotels-input-icon {
      position: absolute;

      top: 50%;
      left: 15px;

      z-index: 2;

      transform:
        translateY(-50%);

      color:
        #6a8175;

      pointer-events:
        none;
    }


    .jt-book-hotels-input,
    .jt-book-hotels-select {
      min-height:
        51px;

      border:
        1px solid
        #dbe3dd;

      border-radius:
        12px;

      background:
        #fbfcfb;

      color:
        var(--jt-book-ink);

      font-size:
        0.85rem;

      box-shadow:
        none;
    }


    .jt-book-hotels-input {
      padding-left:
        42px;
    }


    .jt-book-hotels-select {
      padding-left:
        14px;
    }


    .jt-book-hotels-input:focus,
    .jt-book-hotels-select:focus {
      border-color:
        var(--jt-book-green);

      background:
        #ffffff;

      box-shadow:
        0 0 0 4px
        rgba(38, 114, 74, 0.1);
    }


    .jt-book-hotels-search-btn {
      width: 100%;

      min-height:
        51px;

      border:
        0;

      border-radius:
        12px;

      background:
        var(--jt-book-deep);

      color:
        #ffffff;

      font-size:
        0.82rem;

      font-weight:
        900;

      transition:
        transform 160ms ease,
        background 160ms ease,
        box-shadow 160ms ease;
    }


    .jt-book-hotels-search-btn:hover {
      background:
        var(--jt-book-deep-2);

      color:
        #ffffff;

      transform:
        translateY(-2px);

      box-shadow:
        0 12px 25px
        rgba(18, 59, 42, 0.18);
    }


    .jt-book-hotels-helper {
      display: flex;

      align-items:
        center;

      gap:
        8px;

      margin-top:
        14px;

      color:
        #707c75;

      font-size:
        0.73rem;
    }


    .jt-book-hotels-helper i {
      color:
        var(--jt-book-green);
    }


    /* ============================================================
       QUICK FEATURES
    ============================================================ */

    .jt-book-hotels-section {
      padding:
        70px 0;
    }


    .jt-book-hotels-section.soft {
      background:
        var(--jt-book-cream);
    }


    .jt-book-hotels-section-heading {
      max-width:
        680px;

      margin-bottom:
        32px;
    }


    .jt-book-hotels-section-heading h2 {
      margin:
        6px 0 0;

      color:
        var(--jt-book-deep);

      font-size:
        clamp(1.9rem, 3vw, 2.85rem);

      line-height:
        1.08;

      font-weight:
        900;

      letter-spacing:
        -0.035em;
    }


    .jt-book-hotels-section-heading p {
      margin:
        12px 0 0;

      color:
        var(--jt-book-muted);

      font-size:
        0.87rem;

      line-height:
        1.75;
    }


    .jt-book-hotels-feature {
      height:
        100%;

      padding:
        24px;

      border:
        1px solid
        var(--jt-book-line);

      border-radius:
        19px;

      background:
        #ffffff;

      box-shadow:
        0 10px 30px
        rgba(18, 59, 42, 0.055);

      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }


    .jt-book-hotels-feature:hover {
      transform:
        translateY(-4px);

      box-shadow:
        0 18px 38px
        rgba(18, 59, 42, 0.1);
    }


    .jt-book-hotels-feature-icon {
      width:
        47px;

      height:
        47px;

      display:
        grid;

      place-items:
        center;

      margin-bottom:
        18px;

      border-radius:
        14px;

      background:
        var(--jt-book-green-soft);

      color:
        var(--jt-book-green);

      font-size:
        1.08rem;
    }


    .jt-book-hotels-feature h3 {
      margin:
        0 0 8px;

      color:
        var(--jt-book-deep);

      font-size:
        1rem;

      font-weight:
        900;
    }


    .jt-book-hotels-feature p {
      margin:
        0;

      color:
        var(--jt-book-muted);

      font-size:
        0.8rem;

      line-height:
        1.7;
    }


    /* ============================================================
       HOW IT WORKS
    ============================================================ */

    .jt-book-hotels-steps {
      display:
        grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap:
        15px;
    }


    .jt-book-hotels-step {
      position:
        relative;

      min-height:
        190px;

      padding:
        24px;

      border:
        1px solid
        var(--jt-book-line);

      border-radius:
        19px;

      background:
        #ffffff;
    }


    .jt-book-hotels-step-number {
      width:
        36px;

      height:
        36px;

      display:
        grid;

      place-items:
        center;

      margin-bottom:
        20px;

      border-radius:
        50%;

      background:
        var(--jt-book-deep);

      color:
        #ffffff;

      font-size:
        0.72rem;

      font-weight:
        900;
    }


    .jt-book-hotels-step h3 {
      margin:
        0 0 8px;

      color:
        var(--jt-book-deep);

      font-size:
        1rem;

      font-weight:
        900;
    }


    .jt-book-hotels-step p {
      margin:
        0;

      color:
        var(--jt-book-muted);

      font-size:
        0.79rem;

      line-height:
        1.7;
    }


    /* ============================================================
       NOTICE
    ============================================================ */

    .jt-book-hotels-notice {
      display:
        flex;

      align-items:
        flex-start;

      gap:
        13px;

      padding:
        18px 19px;

      border:
        1px solid
        rgba(161, 119, 70, 0.18);

      border-radius:
        15px;

      background:
        #fbf7ee;

      color:
        #705e45;

      font-size:
        0.78rem;

      line-height:
        1.7;
    }


    .jt-book-hotels-notice i {
      margin-top:
        3px;

      color:
        var(--jt-book-earth);
    }


    /* ============================================================
       DIRECTORY CTA
    ============================================================ */

    .jt-book-hotels-directory {
      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        25px;

      padding:
        28px;

      border-radius:
        21px;

      background:
        var(--jt-book-deep);

      color:
        #ffffff;
    }


    .jt-book-hotels-directory h3 {
      margin:
        0 0 7px;

      font-size:
        1.22rem;

      font-weight:
        900;
    }


    .jt-book-hotels-directory p {
      max-width:
        650px;

      margin:
        0;

      color:
        rgba(255,255,255,0.69);

      font-size:
        0.8rem;

      line-height:
        1.65;
    }


    .jt-book-hotels-directory-btn {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      flex:
        0 0 auto;

      min-height:
        42px;

      padding:
        10px 14px;

      border-radius:
        11px;

      background:
        #ffffff;

      color:
        var(--jt-book-deep);

      text-decoration:
        none;

      font-size:
        0.75rem;

      font-weight:
        900;
    }


    .jt-book-hotels-directory-btn:hover {
      background:
        #edf6ef;

      color:
        var(--jt-book-deep);

      text-decoration:
        none;
    }


    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @media (max-width: 991.98px) {

      .jt-book-hotels-steps {
        grid-template-columns:
          1fr;
      }

      .jt-book-hotels-directory {
        align-items:
          flex-start;

        flex-direction:
          column;
      }

    }


    @media (max-width: 767.98px) {

      .jt-book-hotels-container {
        width:
          min(100% - 22px, 1180px);
      }


      .jt-book-hotels-hero {
        min-height:
          430px;
      }


      .jt-book-hotels-hero-inner {
        padding:
          55px 0 82px;
      }


      .jt-book-hotels-title {
        font-size:
          clamp(2.35rem, 10vw, 3.3rem);
      }


      .jt-book-hotels-search-card {
        padding:
          21px;

        border-radius:
          19px;
      }


      .jt-book-hotels-search-header {
        flex-direction:
          column;
      }


      .jt-book-hotels-search-badge {
        white-space:
          normal;
      }


      .jt-book-hotels-section {
        padding:
          57px 0;
      }

    }


    @media (max-width: 520px) {

      .jt-book-hotels-trust-row {
        flex-direction:
          column;

        gap:
          9px;
      }


      .jt-book-hotels-directory {
        padding:
          22px;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      .jt-book-hotels-feature,
      .jt-book-hotels-search-btn {
        transition:
          none !important;
      }

    }
  </style>


  <!-- ==========================================================
       HERO
  =========================================================== -->

  <section class="jt-book-hotels-hero">

    <div
      class="jt-book-hotels-container jt-book-hotels-hero-inner"
    >

      <span class="jt-book-hotels-eyebrow">

        <i
          class="fa-solid fa-hotel"
          aria-hidden="true"
        ></i>

        Stay in Jharkhand

      </span>


      <h1 class="jt-book-hotels-title">

        Find a stay for
        <span>your journey.</span>

      </h1>


      <p class="jt-book-hotels-subtitle">

        Search for hotels and stays across Jharkhand while
        keeping your destination, travel dates and accommodation
        plans connected.

      </p>


      <div class="jt-book-hotels-trust-row">

        <div class="jt-book-hotels-trust-item">

          <i
            class="fa-solid fa-location-dot"
            aria-hidden="true"
          ></i>

          <span>
            Search by destination
          </span>

        </div>


        <div class="jt-book-hotels-trust-item">

          <i
            class="fa-regular fa-calendar"
            aria-hidden="true"
          ></i>

          <span>
            Plan your dates
          </span>

        </div>


        <div class="jt-book-hotels-trust-item">

          <i
            class="fa-solid fa-bed"
            aria-hidden="true"
          ></i>

          <span>
            Select your rooms
          </span>

        </div>

      </div>

    </div>

  </section>


  <!-- ==========================================================
       SEARCH PANEL
  =========================================================== -->

  <div class="jt-book-hotels-search-wrap">

    <div class="jt-book-hotels-container">

      <section
        class="jt-book-hotels-search-card"
        aria-labelledby="hotelSearchTitle"
      >

        <div class="jt-book-hotels-search-header">

          <div>

            <div class="jt-book-hotels-kicker">
              Hotel directory
            </div>

            <h2 id="hotelSearchTitle">
              Search stays across Jharkhand
            </h2>

            <p>
              Enter your destination, dates and preferred room count.
            </p>

          </div>


          <span class="jt-book-hotels-search-badge">

            <i
              class="fa-solid fa-compass"
              aria-hidden="true"
            ></i>

            Travel planning

          </span>

        </div>


        <!--
          IMPORTANT:
          Existing route contract preserved exactly:
          action = /hotels
          q
          checkin
          checkout
          rooms
        -->

        <form
          action="/hotels"
          method="get"
          class="row g-3"
          id="hotelSearchForm"
        >

          <!-- DESTINATION -->

          <div class="col-lg-4 col-md-6">

            <div class="jt-book-hotels-field">

              <label
                for="hotelDestination"
              >
                Destination
              </label>


              <div
                class="jt-book-hotels-input-wrap"
              >

                <i
                  class="fa-solid fa-location-dot jt-book-hotels-input-icon"
                  aria-hidden="true"
                ></i>


                <input
                  id="hotelDestination"
                  name="q"
                  class="form-control jt-book-hotels-input"
                  type="text"
                  placeholder="Ranchi / Netarhat / Deoghar"
                  autocomplete="off"
                >

              </div>

            </div>

          </div>


          <!-- CHECK-IN -->

          <div class="col-lg-2 col-md-6">

            <div class="jt-book-hotels-field">

              <label
                for="hotelCheckin"
              >
                Check-in
              </label>


              <div
                class="jt-book-hotels-input-wrap"
              >

                <i
                  class="fa-regular fa-calendar jt-book-hotels-input-icon"
                  aria-hidden="true"
                ></i>


                <input
                  id="hotelCheckin"
                  name="checkin"
                  class="form-control jt-book-hotels-input"
                  type="date"
                >

              </div>

            </div>

          </div>


          <!-- CHECK-OUT -->

          <div class="col-lg-2 col-md-6">

            <div class="jt-book-hotels-field">

              <label
                for="hotelCheckout"
              >
                Check-out
              </label>


              <div
                class="jt-book-hotels-input-wrap"
              >

                <i
                  class="fa-regular fa-calendar-check jt-book-hotels-input-icon"
                  aria-hidden="true"
                ></i>


                <input
                  id="hotelCheckout"
                  name="checkout"
                  class="form-control jt-book-hotels-input"
                  type="date"
                >

              </div>

            </div>

          </div>


          <!-- ROOMS -->

          <div class="col-lg-2 col-md-6">

            <div class="jt-book-hotels-field">

              <label
                for="hotelRooms"
              >
                Rooms
              </label>


              <select
                id="hotelRooms"
                name="rooms"
                class="form-select jt-book-hotels-select"
              >

                <option value="1">
                  1 room
                </option>

                <option value="2">
                  2 rooms
                </option>

                <option value="3">
                  3 rooms
                </option>

              </select>

            </div>

          </div>


          <!-- SEARCH -->

          <div class="col-lg-2 col-md-6 d-flex align-items-end">

            <button
              class="jt-book-hotels-search-btn"
              type="submit"
            >

              <i
                class="fa-solid fa-magnifying-glass me-2"
                aria-hidden="true"
              ></i>

              Search stays

            </button>

          </div>

        </form>


        <div class="jt-book-hotels-helper">

          <i
            class="fa-solid fa-circle-info"
            aria-hidden="true"
          ></i>

          <span>
            Search takes you to the hotel directory, where available
            accommodation results can be explored.
          </span>

        </div>

      </section>

    </div>

  </div>


  <!-- ==========================================================
       FEATURES
  =========================================================== -->

  <section class="jt-book-hotels-section">

    <div class="jt-book-hotels-container">

      <div class="jt-book-hotels-section-heading">

        <div class="jt-book-hotels-kicker">
          Stay planning
        </div>

        <h2>
          Keep your accommodation connected to the journey.
        </h2>

        <p>
          Hotel discovery works alongside destination exploration,
          travel planning and the wider Jharkhand Tourism experience.
        </p>

      </div>


      <div class="row g-4">

        <!-- FEATURE 1 -->

        <div class="col-lg-4 col-md-6">

          <article class="jt-book-hotels-feature">

            <div class="jt-book-hotels-feature-icon">

              <i
                class="fa-solid fa-map-location-dot"
                aria-hidden="true"
              ></i>

            </div>

            <h3>
              Destination-first discovery
            </h3>

            <p>
              Search around the destination you plan to experience
              instead of starting from a disconnected hotel list.
            </p>

          </article>

        </div>


        <!-- FEATURE 2 -->

        <div class="col-lg-4 col-md-6">

          <article class="jt-book-hotels-feature">

            <div class="jt-book-hotels-feature-icon">

              <i
                class="fa-solid fa-calendar-days"
                aria-hidden="true"
              ></i>

            </div>

            <h3>
              Date-based planning
            </h3>

            <p>
              Add your check-in and check-out dates while organizing
              the accommodation side of your trip.
            </p>

          </article>

        </div>


        <!-- FEATURE 3 -->

        <div class="col-lg-4 col-md-6">

          <article class="jt-book-hotels-feature">

            <div class="jt-book-hotels-feature-icon">

              <i
                class="fa-solid fa-bed"
                aria-hidden="true"
              ></i>

            </div>

            <h3>
              Flexible room selection
            </h3>

            <p>
              Choose from one to three rooms before sending your
              search to the hotel directory.
            </p>

          </article>

        </div>


        <!-- FEATURE 4 -->

        <div class="col-lg-4 col-md-6">

          <article class="jt-book-hotels-feature">

            <div class="jt-book-hotels-feature-icon">

              <i
                class="fa-solid fa-sliders"
                aria-hidden="true"
              ></i>

            </div>

            <h3>
