<main class="jt-festivals-page">

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="jt-festival-hero">

    <div class="jt-festival-hero-bg"></div>
    <div class="jt-festival-hero-overlay"></div>

    <div class="jt-festival-container jt-festival-hero-content">

      <div class="jt-festival-hero-copy">

        <div class="jt-festival-eyebrow">
          <span class="jt-festival-eyebrow-line"></span>

          <span>
            CULTURE & HERITAGE
          </span>
        </div>

        <h1>
          Festivals that
          <em>bring Jharkhand to life.</em>
        </h1>

        <p>
          Experience vibrant traditions, seasonal celebrations,
          folk music and cultural expressions rooted in the
          communities of Jharkhand.
        </p>

        <div class="jt-festival-hero-actions">

          <a
            href="#festival-explorer"
            class="jt-festival-btn jt-festival-btn-light"
          >
            Explore festivals

            <i
              class="fa-solid fa-arrow-down"
              aria-hidden="true"
            ></i>
          </a>

          <a
            href="/places"
            class="jt-festival-text-link"
          >
            Explore Jharkhand

            <i
              class="fa-solid fa-arrow-right"
              aria-hidden="true"
            ></i>
          </a>

        </div>

      </div>


      <div class="jt-festival-hero-stat">

        <span class="jt-festival-stat-number">
          04
        </span>

        <span class="jt-festival-stat-label">
          Featured<br>
          celebrations
        </span>

      </div>

    </div>

  </section>


  <!-- =====================================================
       INTRO
       ===================================================== -->

  <section class="jt-festival-introduction">

    <div class="jt-festival-container">

      <div class="jt-festival-intro-grid">

        <div>

          <span class="jt-festival-kicker">
            THE CULTURAL CALENDAR
          </span>

          <h2>
            More than festivals.
            <br>
            <span>Living traditions.</span>
          </h2>

        </div>

        <div class="jt-festival-intro-copy">

          <p>
            Jharkhand's festivals reflect a deep connection
            between people, nature, community and tradition.
          </p>

          <p>
            From celebrations of nature and new beginnings to
            harvest traditions, every occasion carries its own
            cultural character.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FESTIVAL EXPLORER
       ===================================================== -->

  <section
    id="festival-explorer"
    class="jt-festival-explorer"
  >

    <div class="jt-festival-container">

      <div class="jt-festival-section-heading">

        <div>

          <span class="jt-festival-kicker">
            DISCOVER
          </span>

          <h2>
            Cultural celebrations
          </h2>

        </div>

        <span class="jt-festival-section-count">
          04 highlights
        </span>

      </div>


      <!-- =================================================
           FEATURED FESTIVAL
           ================================================= -->

      <article class="jt-festival-featured">

        <div class="jt-festival-featured-image">

          <img
             src="/images/festivals/sarhul_festival.png"
            alt="Nature-inspired festival landscape"
            loading="lazy"
          >

          <span class="jt-festival-image-number">
            01
          </span>

        </div>

        <div class="jt-festival-featured-content">

          <div class="jt-festival-card-meta">

            <span>
              <i
                class="fa-solid fa-leaf"
                aria-hidden="true"
              ></i>

              Nature & tradition
            </span>

            <span>
              Featured
            </span>

          </div>

          <h3>
            Sarhul Festival
          </h3>

          <p>
            Celebration of nature and new beginnings among
            tribal communities.
          </p>

          <div class="jt-festival-card-footer">

            <span class="jt-festival-card-label">
              Cultural celebration
            </span>

            <span class="jt-festival-card-arrow">
              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>
            </span>

          </div>

        </div>

      </article>


      <!-- =================================================
           SUPPORTING FESTIVALS
           ================================================= -->

      <div class="jt-festival-secondary-grid">


        <!-- KARMA -->

        <article class="jt-festival-secondary-card">

          <div class="jt-festival-secondary-image">

            <img
               src="/images/festivals/karma_festival.png"
              alt="Traditional nature and cultural setting"
              loading="lazy"
            >

            <span class="jt-festival-image-number">
              02
            </span>

          </div>

          <div class="jt-festival-secondary-content">

            <div class="jt-festival-small-meta">

              <i
                class="fa-solid fa-tree"
                aria-hidden="true"
              ></i>

              Traditional festival

            </div>

            <h3>
              Karma Festival
            </h3>

            <p>
              Traditional rituals, music &amp; dance
              celebrating the Karam tree.
            </p>

            <span class="jt-festival-read-more">
              Discover

              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>
            </span>

          </div>

        </article>


        <!-- TUSU -->

        <article class="jt-festival-secondary-card">

          <div class="jt-festival-secondary-image">

            <img
                src="/images/festivals/tusu_festival.png"
              alt="Seasonal cultural landscape"
              loading="lazy"
            >

            <span class="jt-festival-image-number">
              03
            </span>

          </div>

          <div class="jt-festival-secondary-content">

            <div class="jt-festival-small-meta">

              <i
                class="fa-solid fa-wheat-awn"
                aria-hidden="true"
              ></i>

              Harvest tradition

            </div>

            <h3>
              Tusu Festival
            </h3>

            <p>
              Folk songs and creativity marking the
              harvest season.
            </p>

            <span class="jt-festival-read-more">
              Discover

              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>
            </span>

          </div>

        </article>


        <!-- SARAK -->

        <article class="jt-festival-secondary-card">

          <div class="jt-festival-secondary-image">

            <img
               src="/images/festivals/sarak_festival.png"
              alt="Sarak Festival"
              loading="lazy"
            >

            <span class="jt-festival-image-number">
              04
            </span>

          </div>

          <div class="jt-festival-secondary-content">

            <div class="jt-festival-small-meta">

              <i
                class="fa-solid fa-music"
                aria-hidden="true"
              ></i>

              Folk celebration

            </div>

            <h3>
              Sarak Festival
            </h3>

            <p>
              Traditional celebrations with folk music
              and dance.
            </p>

            <span class="jt-festival-read-more">
              Discover

              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>
            </span>

          </div>

        </article>


      </div>

    </div>

  </section>


  <!-- =====================================================
       CULTURAL STATEMENT
       ===================================================== -->

  <section class="jt-festival-statement">

    <div class="jt-festival-container">

      <div class="jt-festival-statement-inner">

        <div class="jt-festival-statement-symbol">
          <i
            class="fa-solid fa-leaf"
            aria-hidden="true"
          ></i>
        </div>

        <div>

          <span class="jt-festival-kicker">
            EXPERIENCE THE CULTURE
          </span>

          <h2>
            Discover the places,
            people and traditions
            behind the celebrations.
          </h2>

        </div>

        <a
          href="/places"
          class="jt-festival-statement-btn"
        >
          Explore destinations

          <i
            class="fa-solid fa-arrow-right"
            aria-hidden="true"
          ></i>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================================
       BOTTOM SPACE
       ===================================================== -->

  <div class="jt-festival-bottom-space"></div>

</main>