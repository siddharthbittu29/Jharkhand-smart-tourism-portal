<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="<%= typeof description !== 'undefined' && description
      ? description
      : 'Explore Jharkhand tourism, destinations, culture, nature, hotels, festivals and smart travel experiences.' %>"
  >

  <meta
    name="theme-color"
    content="#0b3d2e"
  >

  <title>
    <%= typeof title !== 'undefined' && title
      ? title + ' | Jharkhand Tourism'
      : 'Jharkhand Tourism' %>
  </title>


  <!-- =========================================================
       FONTS
  ========================================================== -->

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
    rel="stylesheet"
  >


  <!-- =========================================================
       BOOTSTRAP
  ========================================================== -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >


  <!-- =========================================================
       FONT AWESOME
  ========================================================== -->

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >


  <!-- =========================================================
       GLOBAL DESIGN SYSTEM
  ========================================================== -->

  <link
    rel="stylesheet"
    href="/styles.css?v=5"
  >


  <!-- =========================================================
       OPTIONAL PAGE STYLES
  ========================================================== -->

  <% if (
    typeof pageStyles !== 'undefined' &&
    pageStyles
  ) { %>

    <%- pageStyles %>

  <% } %>


  <!-- =========================================================
       HOME
  ========================================================== -->

  <% if (currentPath === '/') { %>

    <link
      rel="stylesheet"
      href="/css/home.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       ABOUT
  ========================================================== -->

  <% if (currentPath === '/about') { %>

    <link
      rel="stylesheet"
      href="/css/about.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       PLACES
  ========================================================== -->

  <% if (currentPath === '/places') { %>

    <link
      rel="stylesheet"
      href="/css/places.css?v=5"
    >

  <% } %>

  <% if (
    currentPath &&
    currentPath.startsWith('/places/')
  ) { %>

    <link
      rel="stylesheet"
      href="/css/places.css?v=5"
    >

    <link
      rel="stylesheet"
      href="/css/places-detail.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       HOTELS
  ========================================================== -->

  <% if (currentPath === '/hotels') { %>

    <link
      rel="stylesheet"
      href="/css/hotels.css?v=5"
    >

  <% } %>

  <% if (
    currentPath &&
    currentPath.startsWith('/hotels/')
  ) { %>

    <link
      rel="stylesheet"
      href="/css/hotels.css?v=5"
    >

    <link
      rel="stylesheet"
      href="/css/hotels-detail.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       FESTIVALS
  ========================================================== -->

  <% if (currentPath === '/festivals') { %>

    <link
      rel="stylesheet"
      href="/css/festivals.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       GALLERY
  ========================================================== -->

  <% if (currentPath === '/gallery') { %>

    <link
      rel="stylesheet"
      href="/css/gallery.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       CONTACT
  ========================================================== -->

  <% if (currentPath === '/contact') { %>

    <link
      rel="stylesheet"
      href="/css/contact.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       CHATBOT
  ========================================================== -->

  <% if (currentPath === '/chatbot') { %>

    <link
      rel="stylesheet"
      href="/css/chatbot.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       DASHBOARD
  ========================================================== -->

  <% if (currentPath === '/dashboard') { %>

    <link
      rel="stylesheet"
      href="/css/dashboard.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       WISHLIST
  ========================================================== -->

  <% if (
    currentPath === '/wishlist' ||
    (
      currentPath &&
      currentPath.startsWith('/wishlist/')
    )
  ) { %>

    <link
      rel="stylesheet"
      href="/css/wishlist.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       AI TRIP PLANNER
  ========================================================== -->

  <% if (
    currentPath === '/planner' ||
    (
      currentPath &&
      currentPath.startsWith('/planner/')
    )
  ) { %>

    <link
      rel="stylesheet"
      href="/css/planner.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       SMART TOURISM / 360° VIEWER
  ========================================================== -->

  <% if (
    currentPath === '/smart-tourism' ||
    (
      currentPath &&
      currentPath.startsWith('/smart-tourism/')
    )
  ) { %>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@photo-sphere-viewer/core/index.css"
    >

  <% } %>


  <!-- =========================================================
       SMART TOURISM STYLES
  ========================================================== -->

  <% if (
    currentPath === '/smart-tourism' ||
    (
      currentPath &&
      currentPath.startsWith('/smart-tourism/')
    )
  ) { %>

    <link
      rel="stylesheet"
      href="/smart/css/slide7.css?v=5"
    >

  <% } %>


  <!-- =========================================================
       OPTIONAL HEAD CONTENT
  ========================================================== -->

  <% if (
    typeof headContent !== 'undefined' &&
    headContent
  ) { %>

    <%- headContent %>

  <% } %>


  <!-- =========================================================
       PHOTO SPHERE VIEWER
       Loaded only where Smart Tourism needs it.
  ========================================================== -->

  <% if (
    currentPath === '/smart-tourism' ||
    (
      currentPath &&
      currentPath.startsWith('/smart-tourism/')
    )
  ) { %>

    <script
      src="https://cdn.jsdelivr.net/npm/three/build/three.min.js"
    ></script>

    <script
      src="https://cdn.jsdelivr.net/npm/@photo-sphere-viewer/core/index.js"
    ></script>

  <% } %>

</head>


<body class="jt-body">


  <!-- =========================================================
       ACCESSIBILITY
  ========================================================== -->

  <a
    href="#main-content"
    class="jt-skip-link"
  >
    Skip to main content
  </a>


  <!-- =========================================================
       NAVBAR
  ========================================================== -->

  <%- include('partials/navbar') %>


  <!-- =========================================================
       MAIN CONTENT
  ========================================================== -->

  <main
    id="main-content"
    class="jt-page"
  >

    <%- body %>

  </main>


  <!-- =========================================================
       FOOTER
  ========================================================== -->

  <%- include('partials/footer') %>


  <!-- =========================================================
       FLOATING AI ASSISTANT
  ========================================================== -->

  <a
    href="/chatbot"
    class="jt-floating-ai"
    aria-label="Open AI Assistant"
    title="AI Assistant"
  >

    <i
      class="fa-solid fa-wand-magic-sparkles"
      aria-hidden="true"
    ></i>

  </a>


  <!-- =========================================================
       BOOTSTRAP JS
  ========================================================== -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>


  <!-- =========================================================
       GLOBAL PAGE BEHAVIOR
  ========================================================== -->

  <script>

    document.addEventListener(
      "DOMContentLoaded",
      function () {

        /*
         * Prevent empty hash links from jumping
         * to the top of the page.
         */

        document
          .querySelectorAll('a[href="#"]')
          .forEach(function (link) {

            link.addEventListener(
              "click",
              function (event) {

                event.preventDefault();

              }
            );

          });


        /*
         * Respect reduced-motion preferences.
         */

        if (
          window.matchMedia &&
          window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches
        ) {

          document.documentElement
            .classList
            .add("jt-reduced-motion");

        }


        /*
         * Close Bootstrap navigation after
         * selecting a normal navigation link.
         */

        const navbarCollapse =
          document.querySelector(
            ".navbar-collapse"
          );


        if (navbarCollapse) {

          navbarCollapse
            .querySelectorAll("a")
            .forEach(function (link) {

              link.addEventListener(
                "click",
                function () {

                  if (
                    navbarCollapse.classList.contains("show") &&
                    window.bootstrap
                  ) {

                    const collapse =
                      bootstrap.Collapse.getInstance(
                        navbarCollapse
                      ) ||
                      new bootstrap.Collapse(
                        navbarCollapse,
                        {
                          toggle: false
                        }
                      );

                    collapse.hide();

                  }

                }
              );

            });

        }

      }
    );

  </script>


  <!-- =========================================================
       HOMEPAGE SCRIPT
  ========================================================== -->

  <% if (currentPath === '/') { %>

    <script
      src="/js/home.js?v=5"
      defer
    ></script>

  <% } %>


  <!-- =========================================================
       HOTELS SCRIPT
  ========================================================== -->

  <% if (
    currentPath === '/hotels' ||
    (
      currentPath &&
      currentPath.startsWith('/hotels/')
    )
  ) { %>

    <script
      src="/js/hotels.js?v=5"
      defer
    ></script>

  <% } %>


  <!-- =========================================================
       CHATBOT SCRIPT
  ========================================================== -->

  <% if (currentPath === '/chatbot') { %>

    <script
      src="/js/chatbot.js?v=5"
      defer
    ></script>

  <% } %>


  <!-- =========================================================
       PLACES SCRIPT
  ========================================================== -->

  <% if (
    currentPath === '/places' ||
    (
      currentPath &&
      currentPath.startsWith('/places/')
    )
  ) { %>

    <script
      src="/js/places.js?v=5"
      defer
    ></script>

  <% } %>


  <!-- =========================================================
       SMART TOURISM JS
  ========================================================== -->

  <% if (
    currentPath === '/smart-tourism' ||
    (
      currentPath &&
      currentPath.startsWith('/smart-tourism/')
    )
  ) { %>

    <script
      src="/smart/js/slide7.js?v=5"
      defer
    ></script>

  <% } %>


  <!-- =========================================================
       PLANNER MAP JS
  ========================================================== -->

  <% if (
    currentPath === '/planner' ||
    (
      currentPath &&
      currentPath.startsWith('/planner/')
    )
  ) { %>

    <script
      src="/js/map.js?v=5"
      defer
    ></script>

  <% } %>


  <!-- =========================================================
       OPTIONAL PAGE-SPECIFIC SCRIPTS
  ========================================================== -->

  <% if (
    typeof pageScripts !== 'undefined' &&
    pageScripts
  ) { %>

    <%- pageScripts %>

  <% } %>


</body>

</html>