<!-- ============================================================
     SINGLE SMART TOURISM SECTION NAVIGATION
============================================================ -->

<nav
  class="jt-smart-section-nav"
  aria-label="Smart Tourism navigation"
>

  <div class="jt-smart-section-inner">

    <!-- ======================================================
         SECTION HEADER
    ======================================================= -->

    <div class="jt-smart-section-head">

      <a
        href="/smart-tourism"
        class="jt-smart-section-brand"
        aria-label="Smart Tourism overview"
      >

        <span
          class="jt-smart-section-logo"
          aria-hidden="true"
        >
          <i class="fa-solid fa-compass"></i>
        </span>

        <span class="jt-smart-section-copy">

          <span class="jt-smart-section-eyebrow">
            Smart Tourism Platform
          </span>

          <span class="jt-smart-section-title">
            Smart Tourism
          </span>

          <span class="jt-smart-section-subtitle">
            Explore the intelligent travel ecosystem for Jharkhand
          </span>

        </span>

      </a>


      <span class="jt-smart-section-meta">
        <strong>06</strong>
        <span>Modules</span>
      </span>

    </div>


    <!-- ======================================================
         NAVIGATION TABS
    ======================================================= -->

    <div
      class="jt-smart-section-tabs-wrap"
    >

      <div
        class="jt-smart-section-tabs"
        role="list"
        aria-label="Smart Tourism modules"
      >

        <% smartTabs.forEach((tab) => { %>

          <a
            href="<%= tab.href %>"
            class="jt-smart-section-tab <%= smartIsActive(tab.href) ? 'active' : '' %>"
            role="listitem"
            <%= smartIsActive(tab.href)
              ? 'aria-current="page"'
              : '' %>
          >

            <span
              class="jt-smart-section-tab-icon"
              aria-hidden="true"
            >
              <i
                class="fa-solid <%= tab.icon %>"
              ></i>
            </span>


            <span
              class="jt-smart-section-tab-copy"
            >

              <span
                class="jt-smart-section-tab-top"
              >

                <span
                  class="jt-smart-section-tab-number"
                  aria-hidden="true"
                >
                  <%= tab.number %>
                </span>

                <span
                  class="jt-smart-section-tab-label"
                >
                  <%= tab.label %>
                </span>

              </span>


              <span
                class="jt-smart-section-tab-description"
              >
                <%= tab.description %>
              </span>

            </span>

          </a>

        <% }) %>

      </div>

    </div>

  </div>

</nav>


<script>
(() => {
  "use strict";

  /*
   * Keep the active module visible on
   * tablet and mobile horizontal scrolling.
   */

  const nav =
    document.querySelector(
      ".jt-smart-section-tabs"
    );

  if (!nav) {
    return;
  }

  const active =
    nav.querySelector(
      "a.active"
    );

  if (!active) {
    return;
  }

  const isOverflowing =
    nav.scrollWidth >
    nav.clientWidth;

  if (!isOverflowing) {
    return;
  }

  const reducedMotion =
    window.matchMedia &&
    window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

  window.requestAnimationFrame(() => {

    active.scrollIntoView({
      block: "nearest",
      inline: "center",
      behavior:
        reducedMotion
          ? "auto"
          : "smooth"
    });

  });

})();
</script>