      rgba(35, 96, 68, 0.16);

    background:
      #236044;

    color:
      #ffffff;
  }


  .jt-smart-section-tab.active
    .jt-smart-section-tab-number {
    color:
      #4a7b60;
  }


  .jt-smart-section-tab.active
    .jt-smart-section-tab-description {
