<%
/*
 * ============================================================
 * JHARKHAND TOURISM — PREMIUM SMART TOURISM NAV
 * File:
 * init/views/smart-tourism/partials/nav.ejs
 *
 * Purpose:
 * - One and only one Smart Tourism section navigation
 * - Premium visual navigation
 * - Preserves all existing routes
 * - Preserves active state
 * - Responsive horizontal navigation
 * - No separate duplicate mobile navigation
 * ============================================================
 */

const smartBase = "/smart-tourism";

const smartPath =
  typeof currentPath !== "undefined"
    ? currentPath
    : "";

const smartTabs = [
  {
    href: smartBase,
    label: "Overview",
    number: "01",
    icon: "fa-compass",
    description: "Platform vision"
  },
  {
    href: `${smartBase}/objectives`,
    label: "Objectives",
    number: "02",
    icon: "fa-bullseye",
    description: "Goals & outcomes"
  },
  {
    href: `${smartBase}/features`,
    label: "Features",
    number: "03",
    icon: "fa-layer-group",
    description: "Platform capabilities"
  },
  {
    href: `${smartBase}/journey`,
    label: "User Journey",
    number: "04",
    icon: "fa-route",
    description: "Traveller experience"
  },
  {
    href: `${smartBase}/architecture`,
    label: "Architecture",
    number: "05",
    icon: "fa-diagram-project",
    description: "System foundation"
  },
  {
    href: `${smartBase}/core-features`,
    label: "Core Features",
    number: "06",
    icon: "fa-cubes-stacked",
    description: "Interactive experiences"
  }
];

const smartIsActive = (href) => {
  return (
    smartPath === href ||
    smartPath === `${href}/`
  );
};

const activeTab =
  smartTabs.find((tab) =>
    smartIsActive(tab.href)
  ) || smartTabs[0];
%>


<style>
  /* ============================================================
     SMART TOURISM — PREMIUM LOCAL NAVIGATION
  ============================================================ */

  .jt-smart-section-nav {
    width: 100%;
    padding: 14px 0 18px;

