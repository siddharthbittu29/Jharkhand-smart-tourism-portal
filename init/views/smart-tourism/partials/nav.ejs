  ============================================================ */

  @media (max-width: 1100px) {

    .jt-smart-section-tabs {
      display:
        flex;

      overflow-x:
        auto;

      scrollbar-width:
        thin;
    }


    .jt-smart-section-tab {
      flex:
        0 0 190px;
    }


    .jt-smart-section-tab:last-child {
