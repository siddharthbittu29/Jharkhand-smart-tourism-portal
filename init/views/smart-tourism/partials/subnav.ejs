<%
/*
 * ============================================================
 * JHARKHAND TOURISM — SMART TOURISM COMPACT SUBNAV
 * File: init/views/smart-tourism/partials/subnav.ejs
 *
 * Purpose:
 * - Compact internal navigation for Smart Tourism content
 * - Intended for pages that need only the section tabs
 * - Keeps Core Features available
 * ============================================================
 */

const subnavPath =
  typeof currentPath !== "undefined"
    ? currentPath
    : "";

const subnavItems = [
  {
    href: "/smart-tourism",
    label: "Overview",
    icon: "fa-compass"
  },
  {
    href: "/smart-tourism/objectives",
    label: "Objectives",
    icon: "fa-bullseye"
  },
  {
    href: "/smart-tourism/features",
    label: "Features",
    icon: "fa-layer-group"
  },
  {
    href: "/smart-tourism/journey",
    label: "User Journey",
    icon: "fa-route"
  },
  {
    href: "/smart-tourism/architecture",
    label: "Architecture",
    icon: "fa-diagram-project"
  },
  {
    href: "/smart-tourism/core-features",
    label: "Core Features",
    icon: "fa-cubes-stacked"
  }
];

const subnavActive = (href) =>
  subnavPath === href;
%>


<!-- ============================================================
     COMPACT SMART TOURISM SUBNAV
============================================================ -->

<div class="jt-smart-subnav">

  <div
    class="jt-smart-subnav-inner"
    role="navigation"
    aria-label="Smart Tourism sections"
  >

    <span
      class="jt-st-badge dark"
      aria-hidden="true"
    >
      <i class="fa-solid fa-microchip"></i>
      Smart Tourism
    </span>


    <% subnavItems.forEach((item) => { %>

      <a
        href="<%= item.href %>"
        class="<%= subnavActive(item.href) ? 'active' : '' %>"
        <%= subnavActive(item.href) ? 'aria-current="page"' : '' %>
      >

        <i
          class="fa-solid <%= item.icon %>"
          aria-hidden="true"
        ></i>

        <span>
          <%= item.label %>
        </span>

      </a>

    <% }) %>

  </div>

</div>


<script>
(() => {
  "use strict";

  const wrapper =
    document.querySelector(
      ".jt-smart-subnav"
    );

  if (!wrapper) return;

  const active =
    wrapper.querySelector(
      'a.active, a[aria-current="page"]'
    );

  if (!active) return;

  const mobile =
    window.matchMedia &&
    window.matchMedia(
      "(max-width: 760px)"
    ).matches;

  if (!mobile) return;

  const reduced =
    window.matchMedia &&
    window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

  requestAnimationFrame(() => {
    active.scrollIntoView({
      behavior: reduced ? "auto" : "smooth",
      block: "nearest",
      inline: "center"
    });
  });
})();
</script>