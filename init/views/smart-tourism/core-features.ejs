<%- include('./partials/nav') %>

<style>
  /* =========================================================
     JHARKHAND TOURISM — CORE FEATURES
     Self-contained page styling.
  ========================================================= */

  .jt-core-page {
    --jt-deep: #123c2b;
    --jt-green: #236044;
    --jt-green-2: #2f7a56;
    --jt-mint: #a7d8bb;
    --jt-cream: #f7f3e8;
    --jt-sand: #e9e0cc;
    --jt-ink: #173029;
    --jt-muted: #5f7168;
    --jt-white: #ffffff;
    --jt-line: rgba(18, 60, 43, 0.13);
    --jt-shadow: 0 18px 45px rgba(16, 49, 35, 0.18);
    --jt-shadow-soft: 0 8px 22px rgba(16, 49, 35, 0.11);
    --jt-radius: 20px;

    width: 100%;
    padding: 8px 0 36px;
    color: var(--jt-ink);
  }

  .jt-core-frame {
    position: relative;
    width: min(1220px, 96vw);
    margin: 0 auto;
    border-radius: 28px;
    overflow: hidden;
    isolation: isolate;
    background: #163f2f;
    box-shadow: var(--jt-shadow);
  }

  .jt-core-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      url("/smart/images/netarhat.jpg")
      center center / cover no-repeat;
    transform: scale(1.01);
  }

  .jt-core-overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        180deg,
        rgba(10, 39, 27, 0.82) 0%,
        rgba(18, 60, 43, 0.72) 42%,
        rgba(18, 60, 43, 0.86) 100%
      );
  }

  .jt-core-surface {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at 85% 8%,
        rgba(167, 216, 187, 0.16),
        transparent 30%
      );
    pointer-events: none;
  }

  .jt-core-header {
    padding:
      clamp(28px, 4vw, 52px)
      clamp(20px, 4vw, 48px)
      24px;
    color: var(--jt-white);
  }

  .jt-core-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    padding: 7px 11px;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 999px;
    background: rgba(255,255,255,0.08);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .jt-core-kicker::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--jt-mint);
    box-shadow: 0 0 0 4px rgba(167,216,187,0.14);
  }

  .jt-core-title {
    margin: 0;
    max-width: 800px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .jt-core-caption {
    max-width: 780px;
    margin: 12px 0 0;
    color: rgba(255,255,255,0.90);
    font-size: clamp(14px, 1.7vw, 17px);
    line-height: 1.6;
  }

  .jt-core-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding:
      0
      clamp(16px, 3vw, 38px)
      clamp(20px, 3vw, 38px);
  }

  .jt-core-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--jt-line);
    border-radius: var(--jt-radius);
    overflow: hidden;
    background: rgba(255,255,255,0.97);
    box-shadow: var(--jt-shadow-soft);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .jt-core-card:hover {
    transform: translateY(-3px);
    border-color: rgba(35,96,68,0.28);
    box-shadow: 0 14px 28px rgba(16,49,35,0.18);
  }

  .jt-core-card.is-open {
    border-color: rgba(35,96,68,0.34);
    box-shadow: 0 18px 34px rgba(16,49,35,0.20);
  }

  .jt-core-trigger {
    appearance: none;
    width: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) 22px;
    align-items: center;
    gap: 13px;
    padding: 18px;
    text-align: left;
  }

  .jt-core-trigger:focus-visible {
    outline: 3px solid var(--jt-mint);
    outline-offset: -3px;
  }

  .jt-core-icon-wrap {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: #edf6ef;
    border: 1px solid rgba(35,96,68,0.12);
  }

  .jt-core-icon {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .jt-core-card-copy {
    min-width: 0;
  }

  .jt-core-card-title {
    margin: 0;
    color: var(--jt-deep);
    font-size: 17px;
    line-height: 1.2;
    font-weight: 800;
  }

  .jt-core-card-description {
    margin: 5px 0 0;
    color: var(--jt-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .jt-core-plus {
    position: relative;
    width: 20px;
    height: 20px;
    border: 1px solid rgba(35,96,68,0.18);
    border-radius: 50%;
    background: #f1f7f2;
  }

  .jt-core-plus::before,
  .jt-core-plus::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 1.5px;
    background: var(--jt-green);
    transform: translate(-50%, -50%);
    transition: transform 180ms ease;
  }

  .jt-core-plus::after {
    transform:
      translate(-50%, -50%)
      rotate(90deg);
  }

  .jt-core-card.is-open .jt-core-plus::after {
    transform:
      translate(-50%, -50%)
      rotate(0deg);
  }

  .jt-core-panel {
    display: none;
    border-top: 1px solid var(--jt-line);
    background: #fbfaf6;
  }

  .jt-core-card.is-open .jt-core-panel {
    display: block;
  }

  .jt-core-demo {
    padding: 18px;
  }

  .jt-core-demo-title {
    margin: 0 0 8px;
    color: var(--jt-deep);
    font-size: 14px;
    font-weight: 800;
  }

  .jt-core-demo-note {
    margin: 0 0 14px;
    color: var(--jt-muted);
    font-size: 12px;
    line-height: 1.55;
  }

  .jt-core-list {
    margin: 0;
    padding-left: 18px;
  }

  .jt-core-list li {
    margin: 7px 0;
    color: #294138;
    font-size: 13px;
    line-height: 1.45;
  }

  .jt-core-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 14px;
  }

  .jt-core-btn {
    appearance: none;
    border: 0;
    border-radius: 12px;
    padding: 10px 14px;
    background: var(--jt-green);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 7px 16px rgba(35,96,68,0.22);
    transition:
      transform 160ms ease,
      background 160ms ease;
  }

  .jt-core-btn:hover {
    background: var(--jt-green-2);
    transform: translateY(-1px);
  }

  .jt-core-btn:focus-visible {
    outline: 3px solid var(--jt-mint);
    outline-offset: 2px;
  }

  .jt-core-btn.secondary {
    background: #e9f1eb;
    color: var(--jt-deep);
    box-shadow: none;
  }

  .jt-core-input,
  .jt-core-select {
    width: 100%;
    max-width: 460px;
    min-height: 44px;
    border: 1px solid rgba(18,60,43,0.16);
    border-radius: 12px;
    padding: 10px 12px;
    background: #fff;
    color: var(--jt-ink);
    font: inherit;
    font-size: 13px;
  }

  .jt-core-input:focus,
  .jt-core-select:focus {
    outline: 3px solid rgba(167,216,187,0.45);
    border-color: var(--jt-green);
  }

  .jt-core-label {
    display: block;
    margin-bottom: 7px;
    color: var(--jt-deep);
    font-size: 12px;
    font-weight: 800;
  }

  .jt-itinerary {
    margin: 0;
    padding-left: 19px;
  }

  .jt-itinerary li {
    margin: 8px 0;
    color: #294138;
    font-size: 13px;
    line-height: 1.5;
  }

  .jt-map-shell {
    position: relative;
    height: 220px;
    overflow: hidden;
    border: 1px solid rgba(18,60,43,0.14);
    border-radius: 16px;
    background:
      linear-gradient(
        90deg,
        rgba(255,255,255,0.68),
        rgba(230,239,231,0.9)
      );
  }

  .jt-map-viewport {
    position: absolute;
    inset: 0;
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .jt-map-grid {
    position: absolute;
    inset: -10%;
    background-image:
      linear-gradient(
        rgba(35,96,68,0.11) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(35,96,68,0.11) 1px,
        transparent 1px
      );
    background-size: 36px 36px;
  }

  .jt-map-road {
    position: absolute;
    height: 12px;
    border-radius: 999px;
    background: rgba(72,130,94,0.32);
    transform-origin: left center;
  }

  .jt-map-road.r1 {
    left: 8%;
    top: 60%;
    width: 70%;
    transform: rotate(-18deg);
  }

  .jt-map-road.r2 {
    left: 38%;
    top: 20%;
    width: 54%;
    transform: rotate(68deg);
  }

  .jt-map-pin {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--jt-deep);
    border: 4px solid rgba(255,255,255,0.92);
    box-shadow: 0 0 0 4px rgba(167,216,187,0.48);
  }

  .jt-map-pin.p1 {
    left: 28%;
    top: 43%;
  }

  .jt-map-pin.p2 {
    left: 61%;
    top: 28%;
  }

  .jt-map-pin.p3 {
    left: 73%;
    top: 67%;
  }

  .jt-map-label {
    position: absolute;
    padding: 5px 8px;
    border-radius: 8px;
    background: rgba(255,255,255,0.90);
    color: var(--jt-deep);
    font-size: 10px;
    font-weight: 800;
    box-shadow: 0 5px 12px rgba(16,49,35,0.09);
  }

  .jt-map-label.l1 {
    left: 24%;
    top: 50%;
  }

  .jt-map-label.l2 {
    left: 56%;
    top: 19%;
  }

  .jt-map-label.l3 {
    left: 69%;
    top: 74%;
  }

  .jt-map-controls {
    position: absolute;
    right: 12px;
    top: 12px;
    display: grid;
    gap: 7px;
    z-index: 2;
  }

  .jt-map-control {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(18,60,43,0.14);
    border-radius: 11px;
    background: rgba(255,255,255,0.96);
    color: var(--jt-deep);
    font-size: 20px;
    font-weight: 800;
    cursor: pointer;
  }

  .jt-meter {
    height: 15px;
    overflow: hidden;
    border-radius: 999px;
    background: #dfe9e1;
    border: 1px solid rgba(18,60,43,0.12);
  }

  .jt-meter-fill {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      #8fca9f,
      #2f7a56
    );
    transition: width 650ms ease;
  }

  .jt-eco-score {
    margin-top: 9px;
    color: var(--jt-deep);
    font-size: 20px;
    font-weight: 800;
  }

  .jt-eco-score small {
    font-size: 12px;
    font-weight: 600;
    color: var(--jt-muted);
  }

  .jt-arvr-preview {
    position: relative;
    min-height: 190px;
    overflow: hidden;
    border-radius: 16px;
    background:
      url("/smart/images/netarhat.jpg")
      center / cover no-repeat;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14);
  }

  .jt-arvr-preview::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(11,36,25,0.06),
        rgba(11,36,25,0.72)
      );
  }

  .jt-arvr-content {
    position: absolute;
    z-index: 1;
    left: 16px;
    right: 16px;
    bottom: 16px;
    color: #fff;
  }

  .jt-arvr-badge {
    display: inline-flex;
    padding: 6px 9px;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 999px;
    background: rgba(0,0,0,0.22);
    font-size: 11px;
    font-weight: 800;
    margin-bottom: 9px;
  }

  .jt-connect-item {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 11px;
    align-items: start;
    padding: 11px 0;
    border-bottom: 1px solid rgba(18,60,43,0.08);
  }

  .jt-connect-item:last-child {
    border-bottom: 0;
  }

  .jt-connect-avatar {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #e7f3ea;
    color: var(--jt-deep);
    font-size: 13px;
    font-weight: 800;
  }

  .jt-connect-name {
    margin: 0;
    color: var(--jt-deep);
    font-size: 13px;
    font-weight: 800;
  }

  .jt-connect-meta {
    margin: 3px 0 0;
    color: var(--jt-muted);
    font-size: 11px;
    line-height: 1.45;
  }

  .jt-connect-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 6px;
  }

  .jt-connect-tag {
    padding: 4px 7px;
    border-radius: 999px;
    background: #edf5ee;
    color: #37624c;
    font-size: 10px;
    font-weight: 700;
  }

  .jt-core-footnote {
    margin: 0;
    padding:
      0
      clamp(20px, 4vw, 48px)
      clamp(22px, 4vw, 42px);
    color: rgba(255,255,255,0.76);
    font-size: 11px;
    line-height: 1.55;
  }

  .jt-core-hidden {
    display: none !important;
  }

  @media (max-width: 1040px) {
    .jt-core-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .jt-core-frame {
      width: min(96vw, 620px);
      border-radius: 20px;
    }

    .jt-core-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .jt-core-header {
      padding-bottom: 18px;
    }

    .jt-core-trigger {
      grid-template-columns: 48px minmax(0, 1fr) 20px;
      gap: 11px;
      padding: 14px;
    }

    .jt-core-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 13px;
    }

    .jt-core-icon {
      width: 27px;
      height: 27px;
    }

    .jt-core-card-title {
      font-size: 15px;
    }

    .jt-core-card-description {
      font-size: 12px;
    }

    .jt-core-demo {
      padding: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jt-core-card,
    .jt-core-btn,
    .jt-map-viewport,
    .jt-meter-fill,
    .jt-core-plus::before,
    .jt-core-plus::after {
      transition: none !important;
    }

    .jt-core-card:hover {
      transform: none;
    }
  }
</style>

<main
  class="jt-core-page"
  aria-labelledby="jt-core-title"
>
  <section
    class="jt-core-frame"
    aria-label="Jharkhand Tourism core features"
  >
    <div class="jt-core-bg" aria-hidden="true"></div>
    <div class="jt-core-overlay" aria-hidden="true"></div>
    <div class="jt-core-surface" aria-hidden="true"></div>

    <header class="jt-core-header">
      <div class="jt-core-kicker">
        Smart Tourism Platform
      </div>

      <h1
        id="jt-core-title"
        class="jt-core-title"
      >
        Core Features
      </h1>

      <p class="jt-core-caption">
        Six connected capabilities designed to make Jharkhand travel
        smarter, more immersive, sustainable and community-centric.
      </p>
    </header>

    <section
      class="jt-core-grid"
      aria-label="Core feature demonstrations"
    >

      <!-- =====================================================
           1. AI TRIP RECOMMENDER
      ====================================================== -->
      <article
        class="jt-core-card"
        data-card="ai"
        aria-labelledby="ai-title"
      >
        <button
          class="jt-core-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="ai-panel"
        >
          <span class="jt-core-icon-wrap" aria-hidden="true">
            <img
              class="jt-core-icon"
              src="/smart/icons/ai.svg"
              alt=""
            />
          </span>

          <span class="jt-core-card-copy">
            <span
              id="ai-title"
              class="jt-core-card-title"
            >
              AI Trip Recommender
            </span>

            <span class="jt-core-card-description">
              Personalized itineraries using preferences and seasonal data.
            </span>
          </span>

          <span
            class="jt-core-plus"
            aria-hidden="true"
          ></span>
        </button>

        <div
          id="ai-panel"
          class="jt-core-panel"
          role="region"
          aria-labelledby="ai-title"
        >
          <div class="jt-core-demo">
            <h3 class="jt-core-demo-title">
              Example personalized itinerary
            </h3>

            <p class="jt-core-demo-note">
              Regenerate the demo to explore different travel combinations.
            </p>

            <ul
              id="itinerary-list"
              class="jt-itinerary"
              aria-live="polite"
            ></ul>

            <div class="jt-core-actions">
              <button
                id="regen-itinerary"
                class="jt-core-btn"
                type="button"
              >
                Regenerate itinerary
              </button>
            </div>
          </div>
        </div>
      </article>

      <!-- =====================================================
           2. INTERACTIVE SMART MAP
      ====================================================== -->
      <article
        class="jt-core-card"
        data-card="map"
        aria-labelledby="map-title"
      >
        <button
          class="jt-core-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="map-panel"
        >
          <span class="jt-core-icon-wrap" aria-hidden="true">
            <img
              class="jt-core-icon"
              src="/smart/icons/map.svg"
              alt=""
            />
          </span>

          <span class="jt-core-card-copy">
            <span
              id="map-title"
              class="jt-core-card-title"
            >
              Interactive Smart Map
            </span>

            <span class="jt-core-card-description">
              Geo-tagged eco and cultural sites with route planning.
            </span>
          </span>

          <span
            class="jt-core-plus"
            aria-hidden="true"
          ></span>
        </button>

        <div
          id="map-panel"
          class="jt-core-panel"
          role="region"
          aria-labelledby="map-title"
        >
          <div class="jt-core-demo">
            <h3 class="jt-core-demo-title">
              Smart map preview
            </h3>

            <p class="jt-core-demo-note">
              A visual interaction demo for exploring tourism locations.
            </p>

            <div
              class="jt-map-shell"
              aria-label="Interactive tourism map preview"
            >
              <div
                id="mapViewport"
                class="jt-map-viewport"
              >
                <div
                  class="jt-map-grid"
                  aria-hidden="true"
                ></div>

                <div
                  class="jt-map-road r1"
                  aria-hidden="true"
                ></div>

                <div
                  class="jt-map-road r2"
                  aria-hidden="true"
                ></div>

                <span
                  class="jt-map-pin p1"
                  aria-hidden="true"
                ></span>

                <span
                  class="jt-map-pin p2"
                  aria-hidden="true"
                ></span>

                <span
                  class="jt-map-pin p3"
                  aria-hidden="true"
                ></span>

                <span
                  class="jt-map-label l1"
                  aria-hidden="true"
                >
                  Eco Trail
                </span>

                <span
                  class="jt-map-label l2"
                  aria-hidden="true"
                >
                  Culture
                </span>

                <span
                  class="jt-map-label l3"
                  aria-hidden="true"
                >
                  Stay
                </span>
              </div>

              <div
                class="jt-map-controls"
                role="group"
                aria-label="Map zoom controls"
              >
                <button
                  id="zoomIn"
                  class="jt-map-control"
                  type="button"
                  aria-label="Zoom in"
                >
                  +
                </button>

                <button
                  id="zoomOut"
                  class="jt-map-control"
                  type="button"
                  aria-label="Zoom out"
                >
                  −
                </button>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- =====================================================
           3. CULTURAL HUB
      ====================================================== -->
      <article
        class="jt-core-card"
        data-card="culture"
        aria-labelledby="culture-title"
      >
        <button
          class="jt-core-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="culture-panel"
        >
          <span class="jt-core-icon-wrap" aria-hidden="true">
            <img
              class="jt-core-icon"
              src="/smart/icons/culture.svg"
              alt=""
            />
          </span>

          <span class="jt-core-card-copy">
            <span
              id="culture-title"
              class="jt-core-card-title"
            >
              Cultural Hub
            </span>

            <span class="jt-core-card-description">
              Festival calendar, tribal stories and artisan discovery.
            </span>
          </span>

          <span
            class="jt-core-plus"
            aria-hidden="true"
          ></span>
        </button>

        <div
          id="culture-panel"
          class="jt-core-panel"
          role="region"
          aria-labelledby="culture-title"
        >
          <div class="jt-core-demo">
            <h3 class="jt-core-demo-title">
              Festival calendar
            </h3>

            <p class="jt-core-demo-note">
              Browse the available demonstration entries by month.
            </p>

            <label
              class="jt-core-label"
              for="monthSelect"
            >
              Select month
            </label>

            <select
              id="monthSelect"
              class="jt-core-select"
              aria-label="Select festival month"
            >
              <option value="1">January</option>
              <option value="2">February</option>
              <option value="3">March</option>
              <option value="4">April</option>
              <option value="5">May</option>
              <option value="6">June</option>
              <option value="7">July</option>
              <option value="8">August</option>
              <option value="9">September</option>
              <option value="10">October</option>
              <option value="11">November</option>
              <option value="12">December</option>
            </select>

            <ul
              id="festivalList"
              class="jt-core-list"
              aria-live="polite"
            ></ul>
          </div>
        </div>
      </article>

      <!-- =====================================================
           4. ECOSCORE TRACKER
      ====================================================== -->
      <article
        class="jt-core-card"
        data-card="eco"
        aria-labelledby="eco-title"
      >
        <button
          class="jt-core-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="eco-panel"
        >
          <span class="jt-core-icon-wrap" aria-hidden="true">
            <img
              class="jt-core-icon"
              src="/smart/icons/leaf.svg"
              alt=""
            />
          </span>

          <span class="jt-core-card-copy">
            <span
              id="eco-title"
              class="jt-core-card-title"
            >
              EcoScore Tracker
            </span>

            <span class="jt-core-card-description">
              Sustainability meter with low-impact travel guidance.
            </span>
          </span>

          <span
            class="jt-core-plus"
            aria-hidden="true"
          ></span>
        </button>

        <div
          id="eco-panel"
          class="jt-core-panel"
          role="region"
          aria-labelledby="eco-title"
        >
          <div class="jt-core-demo">
            <h3 class="jt-core-demo-title">
              Sustainability meter
            </h3>

            <p class="jt-core-demo-note">
              Generate a demonstration EcoScore for the selected trip.
            </p>

            <div
              class="jt-meter"
              aria-label="EcoScore meter"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              role="progressbar"
            >
              <div
                id="ecoFill"
                class="jt-meter-fill"
                style="width: 0%"
              ></div>
            </div>

            <div class="jt-eco-score">
              <span
                id="ecoScore"
                aria-live="polite"
              >
                —
              </span>
              <small>/ 100</small>
            </div>

            <div class="jt-core-actions">
              <button
                id="calcEco"
                class="jt-core-btn"
                type="button"
              >
                Calculate EcoScore
              </button>
            </div>
          </div>
        </div>
      </article>

      <!-- =====================================================
           5. AR / VR HERITAGE VIEW
      ====================================================== -->
      <article
        class="jt-core-card"
        data-card="arvr"
        aria-labelledby="arvr-title"
      >
        <button
          class="jt-core-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="arvr-panel"
        >
          <span class="jt-core-icon-wrap" aria-hidden="true">
            <img
              class="jt-core-icon"
              src="/smart/icons/vr.svg"
              alt=""
            />
          </span>

          <span class="jt-core-card-copy">
            <span
              id="arvr-title"
              class="jt-core-card-title"
            >
              AR/VR Heritage View
            </span>

            <span class="jt-core-card-description">
              Immersive virtual previews for remote or fragile sites.
            </span>
          </span>

          <span
            class="jt-core-plus"
            aria-hidden="true"
          ></span>
        </button>

        <div
          id="arvr-panel"
          class="jt-core-panel"
          role="region"
          aria-labelledby="arvr-title"
        >
          <div class="jt-core-demo">
            <div
              class="jt-arvr-preview"
              role="img"
              aria-label="Preview of the Netarhat landscape"
            >
              <div class="jt-arvr-content">
                <span class="jt-arvr-badge">
                  360° Heritage Preview
                </span>

                <button
                  id="vrOpenBtn"
                  class="jt-core-btn"
                  type="button"
                  aria-haspopup="dialog"
                  aria-controls="vrModal"
                  aria-expanded="false"
                >
                  Experience Jharkhand in 360°
                </button>
              </div>
            </div>

            <p class="jt-core-demo-note" style="margin-top: 10px; margin-bottom: 0;">
              Open the viewer to explore day/night mode and cultural narration.
            </p>
          </div>
        </div>
      </article>

      <!-- =====================================================
           6. TOURIST — LOCAL CONNECT
      ====================================================== -->
      <article
        class="jt-core-card"
        data-card="connect"
        aria-labelledby="connect-title"
      >
        <button
          class="jt-core-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="connect-panel"
        >
          <span class="jt-core-icon-wrap" aria-hidden="true">
            <img
              class="jt-core-icon"
              src="/smart/icons/connect.svg"
              alt=""
            />
          </span>

          <span class="jt-core-card-copy">
            <span
              id="connect-title"
              class="jt-core-card-title"
            >
              Tourist–Local Connect
            </span>

            <span class="jt-core-card-description">
              Discover guides, homestays and community-led experiences.
            </span>
          </span>

          <span
            class="jt-core-plus"
            aria-hidden="true"
          ></span>
        </button>

        <div
          id="connect-panel"
          class="jt-core-panel"
          role="region"
          aria-labelledby="connect-title"
        >
          <div class="jt-core-demo">
            <h3 class="jt-core-demo-title">
              Local directory
            </h3>

            <p class="jt-core-demo-note">
              Search the demonstration directory by type, name or interest.
            </p>

            <label
              class="jt-core-label"
              for="connectSearch"
            >
              Search guides and homestays
            </label>

            <input
              id="connectSearch"
              class="jt-core-input"
              type="search"
              placeholder="e.g. birding, homestay, Palamu"
              aria-label="Search guides and homestays"
              autocomplete="off"
            />

            <div
              id="connectList"
              aria-live="polite"
              style="margin-top: 10px;"
            ></div>
          </div>
        </div>
      </article>
    </section>

    <p class="jt-core-footnote">
      Demonstration interactions shown on this page are frontend feature
      previews connected to the existing Smart Tourism contracts.
    </p>
  </section>
</main>

<!-- =========================================================
     AR / VR MODAL
     Smart Tourism layout already loads slide7.js + slide7.css.
========================================================= -->
<div
  id="vrModal"
  class="vr-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="vrTitle"
  hidden
>
  <div
    class="vr-backdrop"
    data-close="1"
  ></div>

  <div
    class="vr-dialog"
    role="document"
  >
    <header class="vr-header">
      <h3 id="vrTitle">
        Jharkhand Heritage — 360° Preview
      </h3>

      <button
        id="vrCloseBtn"
        class="vr-close"
        type="button"
        aria-label="Close 360 degree viewer"
      >
        ✕
      </button>
    </header>

    <div class="vr-stage-wrap">
      <div
        id="vrStage"
        class="vr-stage"
        role="img"
        aria-label="Panoramic preview of Netarhat Hills"
        data-src="/smart/images/netarhat-360.jpg"
      >
        <div
          class="vr-360badge"
          aria-hidden="true"
        >
          360°
        </div>

        <div
          class="vr-loader"
          aria-hidden="true"
        >
          Loading VR preview…
        </div>

        <div
          class="vr-hint"
          aria-hidden="true"
        >
          Drag left/right • Scroll to zoom
        </div>
      </div>
    </div>

    <div
      class="vr-controls"
      role="group"
      aria-label="360 viewer controls"
    >
      <button
        id="vrDay"
        class="vr-btn active"
        type="button"
        aria-pressed="true"
      >
        Day View
      </button>

      <button
        id="vrNight"
        class="vr-btn"
        type="button"
        aria-pressed="false"
      >
        Night View
      </button>

      <button
        id="vrNarration"
        class="vr-btn"
        type="button"
        aria-label="Play cultural narration"
      >
        Cultural Narration
      </button>

      <audio
        id="vrAudio"
        preload="none"
      >
        <source
          src="/smart/audio/narration.mp3"
          type="audio/mpeg"
        />
      </audio>
    </div>
  </div>
</div>

