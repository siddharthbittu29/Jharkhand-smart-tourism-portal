<%- include('./partials/nav') %>

<style>
  /* ============================================================
     JHARKHAND TOURISM
     SMART TOURISM — OVERVIEW
  ============================================================ */

  .jt-smart-overview {
    --jt-deep: #0d3928;
    --jt-deep-2: #123f2e;
    --jt-green: #236044;
    --jt-green-2: #2f7a56;
    --jt-mint: #b6dfc4;
    --jt-cream: #f7f3e8;
    --jt-sand: #e9dfca;
    --jt-ink: #19342a;
    --jt-muted: #66776f;
    --jt-line: rgba(18, 60, 43, 0.11);
    --jt-white: #ffffff;
    --jt-shadow: 0 20px 55px rgba(13, 57, 40, 0.12);
    --jt-shadow-soft: 0 10px 28px rgba(13, 57, 40, 0.08);

    width: 100%;
    color: var(--jt-ink);
    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f7f8f4 100%
      );
  }

  /* ============================================================
     HERO
  ============================================================ */

  .jt-smart-overview-hero {
    position: relative;
    overflow: hidden;
    min-height: 540px;

    display: flex;
    align-items: center;

    background:
      linear-gradient(
        90deg,
        rgba(7, 35, 24, 0.94) 0%,
        rgba(8, 43, 29, 0.82) 45%,
        rgba(8, 43, 29, 0.50) 100%
      ),
      url("/smart/images/netarhat.jpg")
      center / cover no-repeat;
  }

  .jt-smart-overview-hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 150px;

    background:
      linear-gradient(
        180deg,
        transparent,
        rgba(7, 35, 24, 0.34)
      );

    pointer-events: none;
  }

  .jt-smart-overview-hero-inner {
    position: relative;
    z-index: 1;

    width:
      min(1240px, calc(100% - 40px));

    margin:
      0 auto;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1.18fr)
      minmax(300px, 0.82fr);

    gap:
      52px;

    align-items:
      center;

    padding:
      72px 0;
  }

  .jt-smart-overview-eyebrow {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    padding:
      8px 12px;

    border:
      1px solid
      rgba(255,255,255,0.22);

    border-radius:
      999px;

    background:
      rgba(255,255,255,0.08);

    color:
      #eff7f1;

    font-size:
      10px;

    font-weight:
      900;

    letter-spacing:
      0.11em;

    text-transform:
      uppercase;
  }

  .jt-smart-overview-eyebrow i {
    color:
      var(--jt-mint);
  }

  .jt-smart-overview-title {
    max-width:
      740px;

    margin:
      20px 0 0;

    color:
      #ffffff;

    font-size:
      clamp(38px, 5.5vw, 68px);

    line-height:
      1.00;

    font-weight:
      900;

    letter-spacing:
      -0.045em;
  }

  .jt-smart-overview-title span {
    color:
      var(--jt-mint);
  }

  .jt-smart-overview-description {
    max-width:
      700px;

    margin:
      20px 0 0;

    color:
      rgba(255,255,255,0.84);

    font-size:
      clamp(15px, 1.7vw, 18px);

    line-height:
      1.7;
  }

  .jt-smart-overview-actions {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      10px;

    margin-top:
      28px;
  }

  .jt-smart-overview-btn {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      9px;

    min-height:
      46px;

    padding:
      11px 16px;

    border:
      1px solid
      transparent;

    border-radius:
      13px;

    text-decoration:
      none;

    font-size:
      12px;

    font-weight:
      900;

    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .jt-smart-overview-btn:hover {
    transform:
      translateY(-2px);

    text-decoration:
      none;
  }

  .jt-smart-overview-btn.primary {
    background:
      #ffffff;

    color:
      var(--jt-deep);
  }

  .jt-smart-overview-btn.primary:hover {
    background:
      #eff7f1;
  }

  .jt-smart-overview-btn.secondary {
    border-color:
      rgba(255,255,255,0.18);

    background:
      rgba(255,255,255,0.07);

    color:
      #ffffff;
  }

  .jt-smart-overview-btn.secondary:hover {
    background:
      rgba(255,255,255,0.12);
  }

  /* ============================================================
     HERO PANEL
  ============================================================ */

  .jt-smart-overview-hero-panel {
    border:
      1px solid
      rgba(255,255,255,0.14);

    border-radius:
      24px;

    padding:
      22px;

    background:
      rgba(255,255,255,0.08);

    backdrop-filter:
      blur(10px);

    box-shadow:
      0 22px 55px
      rgba(0,0,0,0.16);
  }

  .jt-smart-overview-hero-panel-top {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      14px;

    align-items:
      flex-start;

    margin-bottom:
      18px;
  }

  .jt-smart-overview-panel-label {
    color:
      rgba(255,255,255,0.68);

    font-size:
      9px;

    font-weight:
      900;

    text-transform:
      uppercase;

    letter-spacing:
      0.12em;
  }

  .jt-smart-overview-panel-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      6px;

    padding:
      6px 8px;

    border-radius:
      999px;

    background:
      rgba(182,223,196,0.10);

    color:
      #dff0e4;

    font-size:
      9px;

    font-weight:
      800;
  }

  .jt-smart-overview-panel-status i {
    color:
      var(--jt-mint);
  }

  .jt-smart-overview-panel-title {
    margin:
      0;

    color:
      #ffffff;

    font-size:
      24px;

    line-height:
      1.15;

    font-weight:
      900;

    letter-spacing:
      -0.02em;
  }

  .jt-smart-overview-panel-description {
    margin:
      8px 0 0;

    color:
      rgba(255,255,255,0.70);

    font-size:
      12px;

    line-height:
      1.6;
  }

  .jt-smart-overview-metric-grid {
    display:
      grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      9px;

    margin-top:
      18px;
  }

  .jt-smart-overview-metric {
    padding:
      13px;

    border:
      1px solid
      rgba(255,255,255,0.09);

    border-radius:
      14px;

    background:
      rgba(255,255,255,0.05);
  }

  .jt-smart-overview-metric strong {
    display:
      block;

    color:
      #ffffff;

    font-size:
      20px;

    font-weight:
      900;
  }

  .jt-smart-overview-metric span {
    display:
      block;

    margin-top:
      3px;

    color:
      rgba(255,255,255,0.56);

    font-size:
      9px;

    line-height:
      1.4;
  }

  /* ============================================================
     MAIN CONTENT
  ============================================================ */

  .jt-smart-overview-shell {
    width:
      min(1240px, calc(100% - 40px));

    margin:
      0 auto;

    padding:
      64px 0 78px;
  }

  .jt-smart-overview-section-head {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      30px;

    margin-bottom:
      24px;
  }

  .jt-smart-overview-section-kicker {
    color:
      var(--jt-green);

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      0.13em;

    text-transform:
      uppercase;
  }

  .jt-smart-overview-section-title {
    margin:
      5px 0 0;

    color:
      var(--jt-deep);

    font-size:
      clamp(25px, 3.2vw, 36px);

    line-height:
      1.08;

    font-weight:
      900;

    letter-spacing:
      -0.035em;
  }

  .jt-smart-overview-section-copy {
    max-width:
      580px;

    margin:
      8px 0 0;

    color:
      var(--jt-muted);

    font-size:
      13px;

    line-height:
      1.65;
  }

  .jt-smart-overview-section-link {
    flex:
      0 0 auto;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      7px;

    color:
      var(--jt-green);

    font-size:
      11px;

    font-weight:
      900;

    text-decoration:
      none;
  }

  .jt-smart-overview-section-link:hover {
    color:
      var(--jt-green-2);

    text-decoration:
      none;
  }

  /* ============================================================
     CAPABILITY GRID
  ============================================================ */

  .jt-smart-overview-capability-grid {
    display:
      grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap:
      14px;
  }

  .jt-smart-overview-capability {
    position:
      relative;

    overflow:
      hidden;

    min-height:
      195px;

    padding:
      20px;

    border:
      1px solid
      var(--jt-line);

    border-radius:
      19px;

    background:
      #ffffff;

    box-shadow:
      var(--jt-shadow-soft);

    text-decoration:
      none;

    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .jt-smart-overview-capability:hover {
    transform:
      translateY(-4px);

    box-shadow:
      0 16px 32px
      rgba(13,57,40,0.13);

    border-color:
      rgba(35,96,68,0.20);

    text-decoration:
      none;
  }

  .jt-smart-overview-capability-icon {
    width:
      43px;

    height:
      43px;

    display:
      grid;

    place-items:
      center;

    border:
      1px solid
      rgba(35,96,68,0.11);

    border-radius:
      13px;

    background:
      #eef6f0;

    color:
      var(--jt-green);

    font-size:
      15px;
  }

  .jt-smart-overview-capability-number {
    position:
      absolute;

    right:
      17px;

    top:
      16px;

    color:
      #c2cdc6;

    font-size:
      10px;

    font-weight:
      900;

    letter-spacing:
      0.08em;
  }

  .jt-smart-overview-capability h3 {
    margin:
      17px 0 0;

    color:
      var(--jt-deep);

    font-size:
      16px;

    line-height:
      1.2;

    font-weight:
      900;
  }

  .jt-smart-overview-capability p {
    margin:
      7px 0 0;

    color:
      var(--jt-muted);

    font-size:
      11px;

    line-height:
      1.6;
  }

  .jt-smart-overview-capability-arrow {
    position:
      absolute;

    right:
      18px;

    bottom:
      18px;

    color:
      #a0afa7;

    font-size:
      11px;
  }

  /* ============================================================
     ROADMAP
  ============================================================ */

  .jt-smart-overview-roadmap {
    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 0.86fr);

    gap:
      18px;

    margin-top:
      58px;
  }

  .jt-smart-overview-roadmap-main {
    padding:
      26px;

    border:
      1px solid
      var(--jt-line);

    border-radius:
      22px;

    background:
      #ffffff;

    box-shadow:
      var(--jt-shadow-soft);
  }

  .jt-smart-overview-roadmap-items {
    margin-top:
      20px;
  }

  .jt-smart-overview-roadmap-item {
    position:
      relative;

    display:
      grid;

    grid-template-columns:
      68px
      1fr;

    gap:
      15px;

    padding:
      0 0 21px;

    margin-bottom:
      21px;
  }

  .jt-smart-overview-roadmap-item:last-child {
    margin-bottom:
      0;

    padding-bottom:
      0;
  }

  .jt-smart-overview-roadmap-item::after {
    content:
      "";

    position:
      absolute;

    left:
      33px;

    top:
      42px;

    bottom:
      -21px;

    width:
      1px;

    background:
      #dfe8e1;
  }

  .jt-smart-overview-roadmap-item:last-child::after {
    display:
      none;
  }

  .jt-smart-overview-roadmap-year {
    position:
      relative;

    z-index:
      2;

    width:
      68px;

    height:
      68px;

    display:
      grid;

    place-items:
      center;

    border:
      1px solid
      rgba(35,96,68,0.13);

    border-radius:
      18px;

    background:
      #edf6ef;

    color:
      var(--jt-green);

    font-size:
      11px;

    font-weight:
      900;

    text-align:
      center;
  }

  .jt-smart-overview-roadmap-content h3 {
    margin:
      2px 0 5px;

    color:
      var(--jt-deep);

    font-size:
      15px;

    font-weight:
      900;
  }

  .jt-smart-overview-roadmap-content p {
    margin:
      0;

    color:
      var(--jt-muted);

    font-size:
      11px;

    line-height:
      1.6;
  }

  /* ============================================================
     CTA PANEL
  ============================================================ */

  .jt-smart-overview-cta {
    position:
      relative;

    overflow:
      hidden;

    padding:
      28px;

    border-radius:
      22px;

    background:
      linear-gradient(
        135deg,
        #113d2b,
        #1e6346
      );

    color:
      #ffffff;

    box-shadow:
      var(--jt-shadow);
  }

  .jt-smart-overview-cta::before,
  .jt-smart-overview-cta::after {
    content:
      "";

    position:
      absolute;

    border-radius:
      50%;

    border:
      1px solid
      rgba(255,255,255,0.08);
  }

  .jt-smart-overview-cta::before {
    width:
      220px;

    height:
      220px;

    right:
      -85px;

    top:
      -85px;
  }

  .jt-smart-overview-cta::after {
    width:
      145px;

    height:
      145px;

    right:
      40px;

    bottom:
      -90px;
  }

  .jt-smart-overview-cta-content {
    position:
      relative;

    z-index:
      1;
  }

  .jt-smart-overview-cta-kicker {
    color:
      #bde3ca;

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;
  }

  .jt-smart-overview-cta h2 {
    max-width:
      470px;

    margin:
      8px 0 0;

    color:
      #ffffff;

    font-size:
      28px;

    line-height:
      1.12;

    font-weight:
      900;

    letter-spacing:
      -0.025em;
  }

  .jt-smart-overview-cta p {
    max-width:
      510px;

    margin:
      10px 0 0;

    color:
      rgba(255,255,255,0.72);

    font-size:
      12px;

    line-height:
      1.65;
  }

  .jt-smart-overview-cta-actions {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      9px;

    margin-top:
      18px;
  }

  /* ============================================================
     RESPONSIVE
  ============================================================ */

  @media (max-width: 980px) {
    .jt-smart-overview-hero-inner {
      grid-template-columns:
        1fr;
    }

    .jt-smart-overview-hero-panel {
      max-width:
        620px;
    }

    .jt-smart-overview-capability-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .jt-smart-overview-roadmap {
      grid-template-columns:
        1fr;
    }
  }

  @media (max-width: 680px) {
    .jt-smart-overview-hero {
      min-height:
        0;
    }

    .jt-smart-overview-hero-inner,
    .jt-smart-overview-shell {
      width:
        min(100% - 22px, 1240px);
    }

    .jt-smart-overview-hero-inner {
      padding:
        48px 0 54px;
    }

    .jt-smart-overview-title {
      font-size:
        clamp(35px, 12vw, 48px);
    }

    .jt-smart-overview-section-head {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        12px;
    }

    .jt-smart-overview-capability-grid {
      grid-template-columns:
        1fr;
    }

    .jt-smart-overview-roadmap-main,
    .jt-smart-overview-cta {
      padding:
        21px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jt-smart-overview-btn,
    .jt-smart-overview-capability {
      transition:
        none !important;
    }
  }
</style>


<main
  class="jt-smart-overview"
  aria-labelledby="smartOverviewTitle"
>

  <!-- ==========================================================
       HERO
  =========================================================== -->

  <section class="jt-smart-overview-hero">

    <div class="jt-smart-overview-hero-inner">

      <div>

        <span class="jt-smart-overview-eyebrow">

          <i
            class="fa-solid fa-microchip"
            aria-hidden="true"
          ></i>

          Smart Tourism Platform

        </span>


        <h1
          id="smartOverviewTitle"
          class="jt-smart-overview-title"
        >
          One platform.
          <span>Many ways</span>
          to experience Jharkhand.
        </h1>


        <p class="jt-smart-overview-description">
          A connected tourism ecosystem bringing destination discovery,
          intelligent planning, mapping, cultural exploration,
          sustainability and immersive experiences into one digital journey.
        </p>


        <div class="jt-smart-overview-actions">

          <!-- ONLY "Explore Core Features" CTA -->

          <a
            href="/smart-tourism/core-features"
            class="jt-smart-overview-btn primary"
          >
            Explore Core Features

            <i
              class="fa-solid fa-arrow-right"
              aria-hidden="true"
            ></i>
          </a>


          <a
            href="/planner"
            class="jt-smart-overview-btn secondary"
          >
            Plan a journey

            <i
              class="fa-solid fa-route"
              aria-hidden="true"
            ></i>
          </a>

        </div>

      </div>


      <aside
        class="jt-smart-overview-hero-panel"
        aria-label="Smart Tourism platform summary"
      >

        <div class="jt-smart-overview-hero-panel-top">

          <div>
            <div class="jt-smart-overview-panel-label">
              Platform snapshot
            </div>
          </div>

          <div class="jt-smart-overview-panel-status">

            <i
              class="fa-solid fa-circle-check"
              aria-hidden="true"
            ></i>

            Connected experience

          </div>

        </div>


        <h2 class="jt-smart-overview-panel-title">
          Designed around the traveller journey.
        </h2>


        <p class="jt-smart-overview-panel-description">
          Discovery, planning, navigation, culture and local connection
          are designed as parts of the same ecosystem.
        </p>


        <div class="jt-smart-overview-metric-grid">

          <div class="jt-smart-overview-metric">
            <strong>06</strong>
            <span>Smart Tourism modules</span>
          </div>


          <div class="jt-smart-overview-metric">
            <strong>360°</strong>
            <span>Immersive heritage experience</span>
          </div>


          <div class="jt-smart-overview-metric">
            <strong>AI</strong>
            <span>Personalised trip assistance</span>
          </div>


          <div class="jt-smart-overview-metric">
            <strong>Eco</strong>
            <span>Sustainability-oriented travel</span>
          </div>

        </div>

      </aside>

    </div>

  </section>


  <!-- ==========================================================
       CORE CAPABILITIES
  =========================================================== -->

  <div class="jt-smart-overview-shell">

    <section
      aria-labelledby="smartCapabilitiesTitle"
    >

      <div class="jt-smart-overview-section-head">

        <div>

          <div class="jt-smart-overview-section-kicker">
            Platform capabilities
          </div>


          <h2
            id="smartCapabilitiesTitle"
            class="jt-smart-overview-section-title"
          >
            Six connected modules.
          </h2>


          <p class="jt-smart-overview-section-copy">
            Navigate the Smart Tourism experience through six focused
            modules covering the complete journey from discovery to
            immersive exploration.
          </p>

        </div>


        <!-- Deliberately NOT another Core Features CTA -->

        <a
          href="/smart-tourism/journey"
          class="jt-smart-overview-section-link"
        >
          Follow the traveller journey

          <i
            class="fa-solid fa-arrow-right"
            aria-hidden="true"
          ></i>

        </a>

      </div>


      <div class="jt-smart-overview-capability-grid">

        <!-- =====================================================
             MODULE 01
        ====================================================== -->

        <a
          href="/smart-tourism"
          class="jt-smart-overview-capability"
        >

          <span class="jt-smart-overview-capability-number">
            01
          </span>


          <span class="jt-smart-overview-capability-icon">

            <i
              class="fa-solid fa-compass"
              aria-hidden="true"
            ></i>

          </span>


          <h3>
            Overview
          </h3>


          <p>
            Understand the platform vision, ecosystem and the way
            Smart Tourism connects the traveller journey.
          </p>


          <span
            class="jt-smart-overview-capability-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>


        <!-- =====================================================
             MODULE 02
        ====================================================== -->

        <a
          href="/smart-tourism/objectives"
          class="jt-smart-overview-capability"
        >

          <span class="jt-smart-overview-capability-number">
            02
          </span>


          <span class="jt-smart-overview-capability-icon">

            <i
              class="fa-solid fa-bullseye"
              aria-hidden="true"
            ></i>

          </span>


          <h3>
            Objectives
          </h3>


          <p>
            Explore digital-first growth, sustainability, inclusion,
            safety and community-led tourism objectives.
          </p>


          <span
            class="jt-smart-overview-capability-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>


        <!-- =====================================================
             MODULE 03
        ====================================================== -->

        <a
          href="/smart-tourism/features"
          class="jt-smart-overview-capability"
        >

