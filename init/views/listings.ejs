      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }

    .jt-listings-field:first-child {
      grid-column: span 3;
    }

    .jt-listings-actions {
      grid-column: span 3;
    }

    .jt-listings-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  @media (max-width: 800px) {

    .jt-listings-container {
      width: min(
        calc(100% - 30px),
        1240px
      );
    }

    .jt-listings-hero,
    .jt-listings-hero-inner {
      min-height: 390px;
    }

    .jt-listings-hero-inner {
      padding: 60px 0;
    }

    .jt-listings-filter-card {
      margin-top: -28px;
    }

    .jt-listings-filter-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .jt-listings-field:first-child,
    .jt-listings-actions {
      grid-column: span 2;
    }

    .jt-listings-results-head {
      display: block;
    }

    .jt-listings-view-note {
      margin-top: 10px;
    }

    .jt-listings-cta-inner {
      align-items: flex-start;
      flex-wrap: wrap;
    }

  }


  @media (max-width: 620px) {

    .jt-listings-container {
      width: min(
        calc(100% - 24px),
        1240px
      );
    }

    .jt-listings-hero {
      min-height: 450px;
    }

    .jt-listings-hero h1 {
      font-size: 2.55rem;
    }

    .jt-listings-hero p {
      font-size: 0.88rem;
    }

    .jt-listings-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .jt-listings-filter-card {
      padding: 16px;
    }

    .jt-listings-filter-heading {
      display: block;
    }

    .jt-listings-result-count {
      display: block;
      margin-top: 6px;
    }

    .jt-listings-filter-grid {
      grid-template-columns: 1fr;
    }

    .jt-listings-field:first-child,
    .jt-listings-actions {
      grid-column: auto;
    }

    .jt-listings-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .jt-listings-submit,
    .jt-listings-clear {
      width: 100%;
    }

    .jt-listings-main {
      padding: 50px 0 68px;
    }

    .jt-listings-grid {
      grid-template-columns: 1fr;
      gap: 17px;
    }

    .jt-listing-card {
      min-height: 0;
    }

    .jt-listing-media {
      flex-basis: 225px;
      height: 225px;
    }

    .jt-listing-body {
      padding: 18px;
    }

    .jt-listing-title {
      min-height: auto;
    }

    .jt-listing-description {
      min-height: auto;
    }

    .jt-listing-footer {
      align-items: stretch;
      flex-direction: column;
    }

    .jt-listing-actions {
      width: 100%;
    }

    .jt-listing-like {
      min-width: 74px;
    }

    .jt-listing-details {
      flex: 1 1 auto;
    }

    .jt-listings-cta {
      margin-top: 48px;
      padding: 28px 21px;
    }

    .jt-listings-cta-copy h2 {
      font-size: 1.65rem;
    }

    .jt-listings-cta-btn {
      width: 100%;
    }

  }


  @media (max-width: 420px) {

    .jt-listings-hero h1 {
      font-size: 2.2rem;
    }

    .jt-listings-stats {
      grid-template-columns: 1fr;
    }

    .jt-listings-actions {
      grid-template-columns: 1fr;
    }

    .jt-listing-media {
      flex-basis: 205px;
      height: 205px;
    }

    .jt-listing-actions {
      display: grid;
      grid-template-columns: auto 1fr;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .jt-listing-card,
    .jt-listing-media img {
      transition: none;
    }

    .jt-listing-card:hover {
      transform: none;
    }

    .jt-listing-card:hover
    .jt-listing-media img {
      transform: none;
    }

  }
</style>


<main
  class="jt-listings-page"
  id="main"
>


  <!-- ========================================================
       HERO
       ======================================================== -->

  <section class="jt-listings-hero">

    <div class="jt-listings-container">

      <div class="jt-listings-hero-inner">

        <nav
          class="jt-listings-breadcrumb"
          aria-label="Breadcrumb"
        >

          <a href="/">
            Home
          </a>

          <i
            class="fa-solid fa-chevron-right"
            aria-hidden="true"
          ></i>

          <span>
            Listings
          </span>

        </nav>


        <span class="jt-listings-eyebrow">

          <i
            class="fa-solid fa-compass"
            aria-hidden="true"
          ></i>

          Discover Jharkhand

        </span>


        <h1>
          Find places worth
          discovering.
        </h1>


        <p>
          Browse destinations across Jharkhand by
          category, district, rating and popularity.
          Explore a place in detail whenever something
          catches your eye.
        </p>


        <div class="jt-listings-stats">

          <div class="jt-listings-stat">

            <strong>
              <%= listingTotal %>
            </strong>

            <span>
              Results
            </span>

          </div>


          <div class="jt-listings-stat">

            <strong>
              <%= listingCategories.length %>
            </strong>

            <span>
              Categories
            </span>

          </div>


          <div class="jt-listings-stat">

            <strong>
              <%= listingDistricts.length %>
            </strong>

            <span>
              Districts
            </span>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================================================
       FILTERS
       ======================================================== -->

  <section class="jt-listings-container">

    <div class="jt-listings-filter-card">

      <div class="jt-listings-filter-heading">

        <div>

          <p class="jt-listings-kicker">
            Explore
          </p>

          <h2>
            Refine your discovery
          </h2>

        </div>


        <span class="jt-listings-result-count">

          <strong>
            <%= listingTotal %>
          </strong>

          matching destinations

        </span>

      </div>


      <form
        method="GET"
        action="/listings"
        class="jt-listings-filter-grid"
      >


        <!-- Search -->

        <div class="jt-listings-field">

          <label for="listingSearch">
            Search
          </label>

          <input
            id="listingSearch"
            class="jt-listings-input"
            type="search"
            name="q"
            value="<%= listingQuery %>"
            placeholder="Waterfalls, temples, wildlife..."
            autocomplete="off"
          >

        </div>


        <!-- Category -->

        <div class="jt-listings-field">

          <label for="listingCategory">
            Category
          </label>

          <select
            id="listingCategory"
            name="category"
            class="jt-listings-select"
          >

            <option value="">
              All categories
            </option>

            <% listingCategories.forEach(function(category) { %>

              <option
                value="<%= category %>"
                <%= listingCategory === category ? "selected" : "" %>
              >
                <%= category %>
              </option>

            <% }); %>

          </select>

        </div>


        <!-- District -->

        <div class="jt-listings-field">

          <label for="listingDistrict">
            District
          </label>

          <select
            id="listingDistrict"
            name="district"
            class="jt-listings-select"
          >

            <option value="">
              All districts
            </option>

            <% listingDistricts.forEach(function(district) { %>

              <option
                value="<%= district %>"
                <%= listingDistrict === district ? "selected" : "" %>
              >
                <%= district %>
              </option>

            <% }); %>

          </select>

        </div>


        <!-- Rating -->

        <div class="jt-listings-field">

          <label for="listingRating">
            Minimum rating
          </label>

          <select
            id="listingRating"
            name="minRating"
            class="jt-listings-select"
          >

            <option
              value=""
              <%= listingMinRating === "" ? "selected" : "" %>
            >
              Any rating
            </option>

            <option
              value="3"
              <%= listingMinRating === "3" ? "selected" : "" %>
            >
              3★ & above
            </option>

            <option
              value="4"
              <%= listingMinRating === "4" ? "selected" : "" %>
            >
              4★ & above
            </option>

            <option
              value="4.5"
              <%= listingMinRating === "4.5" ? "selected" : "" %>
            >
              4.5★ & above
            </option>

          </select>

        </div>


        <!-- Sort -->

        <div class="jt-listings-field">

          <label for="listingSort">
            Sort by
          </label>

          <select
            id="listingSort"
            name="sort"
            class="jt-listings-select"
          >

            <option
              value="name"
              <%= listingSort === "name" ? "selected" : "" %>
            >
              Name
            </option>

            <option
              value="relevance"
              <%= listingSort === "relevance" ? "selected" : "" %>
            >
              Relevance
            </option>

            <option
              value="rating"
              <%= listingSort === "rating" ? "selected" : "" %>
            >
              Top rated
            </option>

            <option
              value="popular"
              <%= listingSort === "popular" ? "selected" : "" %>
            >
              Most popular
            </option>

            <option
              value="recent"
              <%= listingSort === "recent" ? "selected" : "" %>
            >
              Recently added
            </option>

          </select>

        </div>


        <!-- Limit -->

        <div class="jt-listings-field">

          <label for="listingLimit">
            Per page
          </label>

          <select
            id="listingLimit"
            name="limit"
            class="jt-listings-select"
          >

            <% [6,9,12,24,48].forEach(function(value) { %>

              <option
                value="<%= value %>"
                <%= listingLimit === value ? "selected" : "" %>
              >
                <%= value %>
              </option>

            <% }); %>

          </select>

        </div>


        <!-- Actions -->

        <div class="jt-listings-actions">

          <button
            type="submit"
            class="jt-listings-submit"
          >

            <i
              class="fa-solid fa-filter"
              aria-hidden="true"
            ></i>

            Apply

          </button>


          <% if (hasListingFilters) { %>

            <a
              href="/listings"
              class="jt-listings-clear"
            >
              Clear
            </a>

          <% } %>

        </div>

      </form>


      <!-- Active filters -->

      <% if (hasListingFilters) { %>

        <div class="jt-listings-active-filters">

          <span class="jt-listings-active-label">
            Active:
          </span>


          <% if (listingQuery) { %>

            <span class="jt-listings-chip">

              <i
                class="fa-solid fa-magnifying-glass"
                aria-hidden="true"
              ></i>

              <%= listingQuery %>

            </span>

          <% } %>


          <% if (listingCategory) { %>

            <span class="jt-listings-chip">

              <i
                class="fa-solid fa-layer-group"
                aria-hidden="true"
              ></i>

              <%= listingCategory %>

            </span>

          <% } %>


          <% if (listingDistrict) { %>

            <span class="jt-listings-chip">

              <i
                class="fa-solid fa-location-dot"
                aria-hidden="true"
              ></i>

              <%= listingDistrict %>

            </span>

          <% } %>


          <% if (listingMinRating) { %>

            <span class="jt-listings-chip">

              <i
                class="fa-solid fa-star"
                aria-hidden="true"
              ></i>

              <%= listingMinRating %>★+

            </span>

          <% } %>


          <% if (listingSort !== "name") { %>

            <span class="jt-listings-chip">

              <i
                class="fa-solid fa-arrow-down-wide-short"
                aria-hidden="true"
              ></i>

              <%= listingSort %>

            </span>

          <% } %>

        </div>

      <% } %>

    </div>

  </section>


  <!-- ========================================================
       RESULTS
       ======================================================== -->

  <section class="jt-listings-main">

    <div class="jt-listings-container">


      <div class="jt-listings-results-head">

        <div>

          <p class="jt-listings-kicker">
            Destination explorer
          </p>

          <h2>
            Places to explore
          </h2>

        </div>


        <div class="jt-listings-view-note">

          <i
            class="fa-solid fa-shield-heart"
            aria-hidden="true"
          ></i>

          Discover at your own pace

        </div>

      </div>


      <div
        class="jt-listings-grid"
        aria-live="polite"
      >


        <% if (!listingPlaces.length) { %>

          <div class="jt-listings-empty">

            <div>

              <div class="jt-listings-empty-icon">

                <i
                  class="fa-solid fa-map-location-dot"
                  aria-hidden="true"
                ></i>

              </div>


              <h3>
                No destinations found
              </h3>


              <p>
                Try another search term or relax one
                of the filters to discover more places.
              </p>


              <a
                href="/listings"
                class="jt-listings-submit"
              >
                View all destinations
              </a>

            </div>

          </div>


        <% } else { %>


          <% listingPlaces.forEach(function(place) { %>

            <article class="jt-listing-card">


              <!-- Media -->

              <a
                href="/places/<%= encodeURIComponent(place.place_id || "") %>"
                class="jt-listing-media"
                aria-label="View <%= place.name || 'destination' %>"
              >

                <img
                  src="<%= placeImage(place) %>"
                  alt="<%= place.name || 'Jharkhand destination' %>"
                  loading="lazy"
                  onerror="this.onerror=null;this.src='/images/placeholder.jpg';"
                >


                <span
                  class="jt-listing-media-overlay"
                  aria-hidden="true"
                ></span>


                <% if (place.category) { %>

                  <span class="jt-listing-category">

                    <i
                      class="fa-solid fa-mountain-sun"
                      aria-hidden="true"
                    ></i>

                    <%= place.category %>

                  </span>

                <% } %>


                <span class="jt-listing-rating">

                  <i
                    class="fa-solid fa-star"
                    aria-hidden="true"
                  ></i>

                  <%= placeRating(place).toFixed(1) %>

                </span>

              </a>


              <!-- Content -->

              <div class="jt-listing-body">


                <div class="jt-listing-location">

                  <i
                    class="fa-solid fa-location-dot"
                    aria-hidden="true"
                  ></i>

                  <%= place.district || "Jharkhand" %>

                </div>


                <h3 class="jt-listing-title">

                  <%= place.name || "Destination" %>

                </h3>


                <p class="jt-listing-description">

                  <%= placeDescription(place) %>

                </p>


                <div class="jt-listing-meta">


                  <% if (place.best_time) { %>

                    <span class="jt-listing-meta-pill">

                      <i
                        class="fa-regular fa-calendar"
                        aria-hidden="true"
                      ></i>

                      Best time available

                    </span>

                  <% } %>


                  <% if (place.entry_fees) { %>

                    <span class="jt-listing-meta-pill">

                      <i
                        class="fa-solid fa-ticket"
                        aria-hidden="true"
                      ></i>

                      Entry info

                    </span>

                  <% } %>


                  <% if (place.popularity_index) { %>

                    <span class="jt-listing-meta-pill">

                      <i
                        class="fa-solid fa-fire"
                        aria-hidden="true"
                      ></i>

                      Popular

                    </span>

                  <% } %>

                </div>


                <div class="jt-listing-footer">


                  <div>

                    <span
                      class="jt-listing-location"
                      style="margin:0;"
                    >

                      <i
                        class="fa-solid fa-compass"
                        aria-hidden="true"
                      ></i>

                      Explore destination

                    </span>

                  </div>


                  <div class="jt-listing-actions">


                    <!-- Like -->

                    <button
                      type="button"
                      class="jt-listing-like like-btn"
                      data-id="<%= place._id || "" %>"
                      aria-pressed="false"
                      aria-label="Like <%= place.name || 'destination' %>"
                    >

                      <i
                        class="fa-regular fa-heart"
                        aria-hidden="true"
                      ></i>

                      <span class="like-count">
                        —
                      </span>

                    </button>


                    <!-- Details -->

                    <a
                      class="jt-listing-details"
                      href="/places/<%= encodeURIComponent(place.place_id || "") %>"
                    >

                      View

                      <i
                        class="fa-solid fa-arrow-right"
                        aria-hidden="true"
                      ></i>

                    </a>

                  </div>

                </div>

              </div>

            </article>

          <% }); %>


        <% } %>


      </div>


      <!-- ======================================================
           PAGINATION
           ====================================================== -->

      <% if (listingTotalPages > 1) { %>

        <nav
          class="jt-listings-pagination"
          aria-label="Listings pagination"
        >


          <% if (listingHasPrev) { %>

            <a
              href="<%= listingQueryUrl({ page: 1 }) %>"
              class="jt-listings-page-link"
            >

              <i
                class="fa-solid fa-angles-left"
                aria-hidden="true"
              ></i>

              First

            </a>


            <a
              href="<%= listingQueryUrl({ page: listingPage - 1 }) %>"
              class="jt-listings-page-link"
            >

              <i
                class="fa-solid fa-arrow-left"
                aria-hidden="true"
              ></i>

              Previous

            </a>

          <% } else { %>

            <span class="jt-listings-page-link is-disabled">
              First
            </span>

            <span class="jt-listings-page-link is-disabled">
              Previous
            </span>

          <% } %>


          <span class="jt-listings-page-info">

            Page

            <strong>
              <%= listingPage %>
            </strong>

            of

            <strong>
              <%= listingTotalPages %>
            </strong>

          </span>


          <% if (listingHasNext) { %>

            <a
              href="<%= listingQueryUrl({ page: listingPage + 1 }) %>"
              class="jt-listings-page-link"
            >

              Next

              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>

            </a>


            <a
              href="<%= listingQueryUrl({ page: listingTotalPages }) %>"
              class="jt-listings-page-link"
            >

              Last

              <i
                class="fa-solid fa-angles-right"
                aria-hidden="true"
              ></i>

            </a>

          <% } else { %>

            <span class="jt-listings-page-link is-disabled">
              Next
            </span>

            <span class="jt-listings-page-link is-disabled">
              Last
            </span>

          <% } %>


        </nav>

      <% } %>


      <!-- ======================================================
           SMART TOURISM CTA
           ====================================================== -->

      <section class="jt-listings-cta">

        <div class="jt-listings-cta-inner">


          <div class="jt-listings-cta-icon">

            <i
              class="fa-solid fa-wand-magic-sparkles"
              aria-hidden="true"
            ></i>

          </div>


          <div class="jt-listings-cta-copy">

            <span>
              Smart Tourism
            </span>

            <h2>
              Ready to plan your journey?
            </h2>

            <p>
              Turn the places you're discovering into
              a personalized Jharkhand itinerary with
              the AI Trip Planner.
            </p>

          </div>


          <a
            href="/planner"
            class="jt-listings-cta-btn"
          >

            Plan my trip

            <i
              class="fa-solid fa-arrow-right"
              aria-hidden="true"
            ></i>

          </a>

        </div>

      </section>


    </div>

  </section>


</main>


<script>
(function () {

  "use strict";


  /* ==========================================================
     LIKE COUNTS
     ========================================================== */

  const likeButtons =
    Array.from(
      document.querySelectorAll(
        ".jt-listing-like"
      )
    );


  const formatter =
    new Intl.NumberFormat(
      "en-IN"
    );


  async function preloadLikes() {

    if (!likeButtons.length) {
      return;
    }


    const validButtons =
      likeButtons.filter(
        function (button) {

          return Boolean(
            button.dataset.id
          );

        }
      );


    if (!validButtons.length) {
      return;
    }


    const ids =
      validButtons
        .map(
          button =>
            button.dataset.id
        )
        .join(",");


    try {

      const response =
        await fetch(
          "/likes?ids=" +
          encodeURIComponent(ids),
          {
            headers: {
              Accept:
                "application/json"
            }
          }
        );


      if (!response.ok) {
        return;
      }


      const data =
        await response.json();


      if (
        !data ||
        data.ok !== true ||
        !data.counts
      ) {
        return;
      }


      validButtons.forEach(
        function (button) {

          const id =
            button.dataset.id;

          const count =
            Number(
              data.counts[id]
            );


          const countNode =
            button.querySelector(
              ".like-count"
            );


          if (
            countNode &&
            Number.isFinite(count)
          ) {

            countNode.textContent =
              formatter.format(
                count
              );

          }

        }
      );

    } catch (error) {

      console.warn(
        "Listings likes could not be loaded:",
        error
      );

    }

  }


  /* ==========================================================
     LIKE ACTION
     ========================================================== */

  async function handleLike(
    button
  ) {

    const id =
      button.dataset.id;


    if (!id) {
      return;
    }


    button.disabled =
      true;


    try {

      const response =
        await fetch(
          "/likes/" +
          encodeURIComponent(id),
          {
            method: "POST",
            headers: {
              Accept:
                "application/json"
            }
          }
        );


      if (!response.ok) {
        return;
      }


      const data =
        await response.json();


      if (
        !data ||
        data.ok !== true
      ) {
        return;
      }


      const count =
        Number(data.count);


      const countNode =
        button.querySelector(
          ".like-count"
        );


      if (
        countNode &&
        Number.isFinite(count)
      ) {

        countNode.textContent =
          formatter.format(
            count
          );

      }


      button.classList.add(
        "is-liked"
      );


      button.setAttribute(
        "aria-pressed",
        "true"
      );


      const icon =
        button.querySelector(
          "i"
        );


      if (icon) {

        icon.classList.remove(
          "fa-regular"
        );

        icon.classList.add(
          "fa-solid"
        );

      }

    } catch (error) {

      console.warn(
        "Unable to like listing:",
        error
      );

    } finally {

      button.disabled =
        false;

    }

  }


  likeButtons.forEach(
    function (button) {

      button.addEventListener(
        "click",
        function () {

          handleLike(
            this
          );

        }
      );

    }
  );


  preloadLikes();


})();
</script>