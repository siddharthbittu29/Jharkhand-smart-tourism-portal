  /* ============================================================
     JHARKHAND TOURISM
     Listings Explorer
     Body/content view
     ============================================================ */

  const listingPlaces =
    Array.isArray(places)
      ? places
      : [];

  const listingCategories =
    Array.isArray(categories)
      ? categories
      : [];

  const listingDistricts =
    Array.isArray(districts)
      ? districts
      : [];

  const listingPagination =
    pagination || {};

  const listingFilters =
    filters || {};

  const listingPage =
    Number(listingPagination.page) || 1;

  const listingLimit =
    Number(listingPagination.limit) || 9;

  const listingTotal =
    Number(listingPagination.total) ||
    listingPlaces.length;

  const listingTotalPages =
    Number(listingPagination.totalPages) || 1;

  const listingHasPrev =
    Boolean(listingPagination.hasPrev);

  const listingHasNext =
    Boolean(listingPagination.hasNext);

  const listingQuery =
    typeof listingFilters.q === "string"
      ? listingFilters.q
      : "";

  const listingCategory =
    typeof listingFilters.category === "string"
      ? listingFilters.category
      : "";

  const listingDistrict =
    typeof listingFilters.district === "string"
      ? listingFilters.district
      : "";

  const listingMinRating =
    typeof listingFilters.minRating === "string"
      ? listingFilters.minRating
      : "";

  const listingSort =
    typeof listingFilters.sort === "string"
      ? listingFilters.sort
      : "name";


  const hasListingFilters =
    Boolean(
      listingQuery ||
      listingCategory ||
      listingDistrict ||
      listingMinRating ||
      listingSort !== "name"
    );


  function listingQueryUrl(overrides) {

    const params =
      new URLSearchParams();


    const merged = {

      q:
        listingQuery,

      category:
        listingCategory,

      district:
        listingDistrict,

      minRating:
        listingMinRating,

      sort:
        listingSort,

      limit:
        String(listingLimit),

      page:
        String(listingPage),

      ...(overrides || {})

    };


    Object.keys(merged)
      .forEach(function (key) {

        const value =
          merged[key];


        if (
          value !== undefined &&
          value !== null &&
          String(value).trim() !== ""
        ) {

          params.set(
            key,
            String(value)
          );

        }

      });


    return (
      "/listings?" +
      params.toString()
    );

  }


  function placeImage(place) {

    if (
      place &&
      Array.isArray(place.images) &&
      place.images.length
    ) {

      const firstImage =
        place.images[0];

      if (
        firstImage &&
        typeof firstImage === "object" &&
        firstImage.url
      ) {

        return firstImage.url;

      }

      if (
        typeof firstImage === "string"
      ) {

        return firstImage;

      }

    }


    if (
      place &&
      place.image
    ) {

      return place.image;

    }


    return "/images/placeholder.jpg";

  }


  function placeRating(place) {

    const rating =
      Number(
        place?.average_rating
      );

    return Number.isFinite(rating)
      ? rating
      : 0;

  }


  function placeDescription(place) {

    const text =
      String(
        place?.description || ""
      ).trim();


    if (!text) {

      return "Discover this destination and explore more of Jharkhand.";

    }


    return text;

  }

