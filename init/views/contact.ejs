<main
  class="jt-contact-page"
  aria-labelledby="contactPageTitle"
>

  <style>
    /* ============================================================
       JHARKHAND TOURISM — CONTACT
    ============================================================ */

    .jt-contact-page {
      --jt-deep: #0d3928;
      --jt-deep-2: #123f2e;
      --jt-green: #236044;
      --jt-green-2: #2f7a56;
      --jt-mint: #b6dfc4;
      --jt-cream: #f7f3e8;
      --jt-ink: #19342a;
      --jt-muted: #687870;
      --jt-line: rgba(18,60,43,0.11);
      --jt-soft: #eef6f0;
      --jt-white: #ffffff;

      width: 100%;
      color: var(--jt-ink);
      background:
        linear-gradient(
          180deg,
          #ffffff 0%,
          #f7f9f6 100%
        );
    }

    /* ============================================================
       HERO
    ============================================================ */

    .jt-contact-hero {
      position: relative;
      overflow: hidden;
      min-height: 470px;

      display: flex;
      align-items: center;

      background:
        linear-gradient(
          90deg,
          rgba(6,31,21,0.95) 0%,
          rgba(9,51,34,0.82) 52%,
          rgba(9,51,34,0.45) 100%
        ),
        url("/images/netarhat.jpg")
        center / cover no-repeat;
    }

    .jt-contact-hero-overlay {
      position: absolute;
      inset: 0;

      background:
        radial-gradient(
          circle at 82% 30%,
          rgba(182,223,196,0.10),
          transparent 32%
        );
    }

    .jt-contact-hero-inner {
      position:
        relative;

      z-index:
        1;

      width:
        min(1240px, calc(100% - 40px));

      margin:
        0 auto;

      display:
        grid;

      grid-template-columns:
        minmax(0, 1fr)
        190px;

      gap:
        35px;

      align-items:
        center;

      padding:
        72px 0;
    }

    .jt-contact-eyebrow {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      padding:
        8px 11px;

      border:
        1px solid
        rgba(255,255,255,0.20);

      border-radius:
        999px;

      background:
        rgba(255,255,255,0.07);

      color:
        #e8f3ec;

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.14em;
    }

    .jt-contact-eyebrow::before {
      content:
        "";

      width:
        6px;

      height:
        6px;

      border-radius:
        50%;

      background:
        var(--jt-mint);

      box-shadow:
        0 0 0 4px
        rgba(182,223,196,0.10);
    }

    .jt-contact-hero-copy h1 {
      max-width:
        760px;

      margin:
        18px 0 0;

      color:
        #ffffff;

      font-size:
        clamp(40px, 6vw, 67px);

      line-height:
        1.00;

      font-weight:
        900;

      letter-spacing:
        -0.045em;
    }

    .jt-contact-hero-copy h1 em {
      color:
        var(--jt-mint);

      font-style:
        normal;
    }

    .jt-contact-hero-copy p {
      max-width:
        710px;

      margin:
        18px 0 0;

      color:
        rgba(255,255,255,0.78);

      font-size:
        15px;

      line-height:
        1.7;
    }

    .jt-contact-hero-mark {
      width:
        160px;

      height:
        160px;

      display:
        grid;

      place-items:
        center;

      justify-self:
        end;

      border:
        1px solid
        rgba(255,255,255,0.16);

      border-radius:
        40px;

      background:
        rgba(255,255,255,0.07);

      color:
        rgba(255,255,255,0.88);

      font-family:
        Georgia, serif;

      font-size:
        62px;

      font-weight:
        700;

      letter-spacing:
        -0.07em;

      transform:
        rotate(-5deg);

      box-shadow:
        0 20px 50px
        rgba(0,0,0,0.16);
    }

    /* ============================================================
       CONTENT
    ============================================================ */

    .jt-contact-content {
      padding:
        60px 0 65px;
    }

    .jt-contact-content-inner {
      width:
        min(1240px, calc(100% - 40px));

      margin:
        0 auto;

      display:
        grid;

      grid-template-columns:
        minmax(0, 0.84fr)
        minmax(0, 1.16fr);

      gap:
        18px;

      align-items:
        start;
    }

    /* ============================================================
       INFORMATION
    ============================================================ */

    .jt-contact-info {
      padding:
        28px;

      border:
        1px solid
        var(--jt-line);

      border-radius:
        22px;

      background:
        #ffffff;

      box-shadow:
        0 16px 40px
        rgba(13,57,40,0.07);
    }

    .jt-contact-kicker {
      color:
        var(--jt-green);

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.13em;

      text-transform:
        uppercase;
    }

    .jt-contact-info h2 {
      margin:
        7px 0 0;

      color:
        var(--jt-deep);

      font-size:
        clamp(27px, 3.3vw, 39px);

      line-height:
        1.06;

      font-weight:
        900;

      letter-spacing:
        -0.035em;
    }

    .jt-contact-intro {
      margin:
        12px 0 0;

      color:
        var(--jt-muted);

      font-size:
        12px;

      line-height:
        1.7;
    }

    .jt-contact-details {
      display:
        grid;

      gap:
        9px;

      margin-top:
        22px;
    }

    .jt-contact-detail {
      display:
        grid;

      grid-template-columns:
        43px 1fr;

      gap:
        11px;

      align-items:
        center;

      min-width:
        0;

      padding:
        11px;

      border:
        1px solid
        rgba(35,96,68,0.09);

      border-radius:
        13px;

      background:
        #f7faf7;

      color:
        inherit;

      text-decoration:
        none;

      transition:
        transform 160ms ease,
        background 160ms ease;
    }

    a.jt-contact-detail:hover {
      transform:
        translateX(3px);

      background:
        #eef6f0;

      text-decoration:
        none;
    }

    .jt-contact-detail-icon {
      width:
        43px;

      height:
        43px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        12px;

      background:
        #eaf4ed;

      color:
        var(--jt-green);

      font-size:
        14px;
    }

    .jt-contact-detail strong {
      display:
        block;

      color:
        var(--jt-deep);

      font-size:
        11px;

      font-weight:
        900;
    }

    .jt-contact-detail small {
      display:
        block;

      margin-top:
        3px;

      color:
        var(--jt-muted);

      font-size:
        10px;

      line-height:
        1.4;
    }

    .jt-contact-note {
      display:
        grid;

      grid-template-columns:
        34px 1fr;

      gap:
        9px;

      align-items:
        start;

      margin-top:
        18px;

      padding:
        13px;

      border:
        1px solid
        rgba(35,96,68,0.10);

      border-radius:
        13px;

      background:
        var(--jt-soft);
    }

    .jt-contact-note i {
      color:
        var(--jt-green);

      margin-top:
        2px;
    }

    .jt-contact-note p {
      margin:
        0;

      color:
        #567065;

      font-size:
        10px;

      line-height:
        1.6;
    }

    /* ============================================================
       FORM
    ============================================================ */

    .jt-contact-form-wrap {
      padding:
        28px;

      border:
        1px solid
        var(--jt-line);

      border-radius:
        22px;

      background:
        #ffffff;

      box-shadow:
        0 16px 40px
        rgba(13,57,40,0.08);
    }

    .jt-contact-form-heading > span {
      color:
        var(--jt-green);

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.13em;
    }

    .jt-contact-form-heading h3 {
      margin:
        6px 0 0;

      color:
        var(--jt-deep);

      font-size:
        26px;

      font-weight:
        900;

      letter-spacing:
        -0.03em;
    }

    .jt-contact-form {
      margin-top:
        22px;
    }

    .jt-contact-form-row {
      display:
        grid;

      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        11px;
    }

    .jt-contact-field {
      margin-bottom:
        13px;
    }

    .jt-contact-field label {
      display:
        block;

      margin-bottom:
        6px;

      color:
        #26483a;

      font-size:
        10px;

      font-weight:
        900;
    }

    .jt-contact-field input,
    .jt-contact-field textarea,
    .jt-contact-field select {
      width:
        100%;

      border:
        1px solid
        rgba(35,96,68,0.14);

      border-radius:
        12px;

      background:
        #fbfcfa;

      color:
        var(--jt-ink);

      font:
        inherit;

      font-size:
        11px;

      transition:
        border-color 160ms ease,
        box-shadow 160ms ease,
        background 160ms ease;
    }

    .jt-contact-field input {
      min-height:
        44px;

      padding:
        10px 12px;
    }

    .jt-contact-field select {
      min-height:
        44px;

      padding:
        10px 12px;

      cursor:
        pointer;
    }

    .jt-contact-field textarea {
      min-height:
        145px;

      resize:
        vertical;

      padding:
        11px 12px;

      line-height:
        1.6;
    }

    .jt-contact-field input::placeholder,
    .jt-contact-field textarea::placeholder {
      color:
        #9aa8a1;
    }

    .jt-contact-field input:focus,
    .jt-contact-field textarea:focus,
    .jt-contact-field select:focus {
      outline:
        none;

      border-color:
        #5d9a76;

      background:
        #ffffff;

      box-shadow:
        0 0 0 4px
        rgba(95,153,118,0.11);
    }

    /* ============================================================
       RATING
    ============================================================ */

    .jt-contact-rating {
      display:
        flex;

      flex-wrap:
        wrap;

      align-items:
        center;

      gap:
        8px;

      min-height:
        44px;

      padding:
        7px 10px;

      border:
        1px solid
        rgba(35,96,68,0.14);

      border-radius:
        12px;

      background:
        #fbfcfa;
    }

    .jt-contact-rating-option {
      position:
        relative;
    }

    .jt-contact-rating-option input {
      position:
        absolute;

      opacity:
        0;

      pointer-events:
        none;
    }

    .jt-contact-rating-option label {
      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        5px;

      min-width:
        44px;

      min-height:
        31px;

      padding:
        6px 8px;

      border:
        1px solid
        rgba(35,96,68,0.11);

      border-radius:
        9px;

      background:
        #ffffff;

      color:
        #718078;

      cursor:
        pointer;

      font-size:
        10px;

      font-weight:
        900;

      transition:
        background 160ms ease,
        color 160ms ease,
        border-color 160ms ease,
        transform 160ms ease;
    }

    .jt-contact-rating-option label i {
      color:
        #caa463;

      font-size:
        9px;
    }

    .jt-contact-rating-option label:hover {
      transform:
        translateY(-1px);

      border-color:
        rgba(35,96,68,0.22);

      color:
        var(--jt-green);
    }

    .jt-contact-rating-option input:checked + label {
      border-color:
        var(--jt-green);

      background:
        var(--jt-green);

      color:
        #ffffff;

      box-shadow:
        0 6px 14px
        rgba(35,96,68,0.15);
    }

    .jt-contact-rating-option input:checked + label i {
      color:
        #f2d486;
    }

    .jt-contact-rating-option input:focus-visible + label {
      outline:
        3px solid
        rgba(35,96,68,0.15);

      outline-offset:
        2px;
    }

    .jt-contact-rating-help {
      width:
        100%;

      margin-top:
        2px;

      color:
        #8b9992;

      font-size:
        9px;

      line-height:
        1.4;
    }

    /* ============================================================
       FORM FOOTER
    ============================================================ */

    .jt-contact-form-bottom {
      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

      padding-top:
        4px;
    }

    .jt-contact-form-bottom p {
      margin:
        0;

      max-width:
        380px;

      color:
        #718078;

      font-size:
        9px;

      line-height:
        1.55;
    }

    .jt-contact-form-bottom p i {
      margin-right:
        4px;

      color:
        var(--jt-green);
    }

    .jt-contact-page .jt-btn {
      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        8px;

      min-height:
        43px;

      padding:
        10px 15px;

      border:
        0;

      border-radius:
        11px;

      text-decoration:
        none;

      font-size:
        10px;

      font-weight:
        900;

      cursor:
        pointer;

      transition:
        transform 160ms ease,
        background 160ms ease;
    }

    .jt-contact-page .jt-btn:hover {
      transform:
        translateY(-2px);

      text-decoration:
        none;
    }

    .jt-btn-primary {
      background:
        var(--jt-green);

      color:
        #ffffff;
    }

    .jt-btn-primary:hover {
      background:
        var(--jt-green-2);

      color:
        #ffffff;
    }

    /* ============================================================
       EXPLORE CTA
    ============================================================ */

    .jt-contact-explore {
      padding:
        0 0 65px;
    }

    .jt-contact-explore-inner {
      width:
        min(1240px, calc(100% - 40px));

      margin:
        0 auto;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        25px;

      padding:
        27px;

      border-radius:
        22px;

      background:
        linear-gradient(
          135deg,
          #103d2b,
          #1f6648
        );

      color:
        #ffffff;

      box-shadow:
        0 20px 46px
        rgba(13,57,40,0.13);
    }

    .jt-contact-explore-label {
      color:
        #bde3c8;

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        0.13em;
    }

    .jt-contact-explore h2 {
      max-width:
        580px;

      margin:
        6px 0 0;

      color:
        #ffffff;

      font-size:
        26px;

      line-height:
        1.12;

      font-weight:
        900;

      letter-spacing:
        -0.03em;
    }

    .jt-contact-explore p {
      max-width:
        600px;

      margin:
        7px 0 0;

      color:
        rgba(255,255,255,0.70);

      font-size:
        10px;

      line-height:
        1.6;
    }

    .jt-contact-explore-actions {
      display:
        flex;

      align-items:
        center;

      flex-wrap:
        wrap;

      gap:
        10px;

      flex:
        0 0 auto;
    }

    .jt-btn-light {
      background:
        #ffffff;

      color:
        var(--jt-deep);
    }

    .jt-btn-light:hover {
      background:
        #eef5f0;

      color:
        var(--jt-deep);
    }

    .jt-contact-text-link {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      color:
        #d8eee0;

      font-size:
        10px;

      font-weight:
        900;

      text-decoration:
        none;
    }

    .jt-contact-text-link:hover {
      color:
        #ffffff;

      text-decoration:
        none;
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @media (max-width: 900px) {

      .jt-contact-hero-inner {
        grid-template-columns:
          1fr;
      }

      .jt-contact-hero-mark {
        display:
          none;
      }

      .jt-contact-content-inner {
        grid-template-columns:
          1fr;
      }
    }

    @media (max-width: 650px) {

      .jt-contact-hero-inner,
      .jt-contact-content-inner,
      .jt-contact-explore-inner {
        width:
          min(100% - 22px, 1240px);
      }

      .jt-contact-hero-inner {
        padding:
          52px 0;
      }

      .jt-contact-hero-copy h1 {
        font-size:
          clamp(37px, 11vw, 50px);
      }

      .jt-contact-info,
      .jt-contact-form-wrap {
        padding:
          21px;
      }

      .jt-contact-form-row {
        grid-template-columns:
          1fr;
      }

      .jt-contact-rating {
        gap:
          6px;
      }

      .jt-contact-rating-option label {
        min-width:
          40px;
      }

      .jt-contact-form-bottom {
        align-items:
          stretch;

        flex-direction:
          column;
      }

      .jt-contact-form-bottom .jt-btn {
        width:
          100%;
      }

      .jt-contact-explore-inner {
        align-items:
          flex-start;

        flex-direction:
          column;

        padding:
          22px;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      .jt-contact-detail,
      .jt-contact-field input,
      .jt-contact-field textarea,
      .jt-contact-field select,
      .jt-contact-rating-option label,
      .jt-contact-page .jt-btn {
        transition:
          none !important;
      }
    }
  </style>


  <!-- ==========================================================
       HERO
  =========================================================== -->

  <section class="jt-contact-hero">

    <div
      class="jt-contact-hero-overlay"
      aria-hidden="true"
    ></div>


    <div class="jt-contact-hero-inner">

      <div class="jt-contact-hero-copy">

        <span class="jt-contact-eyebrow">
          GET IN TOUCH
        </span>


        <h1 id="contactPageTitle">
          Let’s plan your
          <em>Jharkhand journey.</em>
        </h1>


        <p>
          Have a question about destinations, stays, festivals,
          travel planning or the Smart Tourism experience?
          We’re here to help.
        </p>

      </div>


      <div
        class="jt-contact-hero-mark"
        aria-hidden="true"
      >
        JT
      </div>

    </div>

  </section>


  <!-- ==========================================================
       CONTACT CONTENT
  =========================================================== -->

  <section class="jt-contact-content">

    <div class="jt-contact-content-inner">

      <!-- ======================================================
           INFORMATION
      ======================================================= -->

      <div class="jt-contact-info">

        <span class="jt-contact-kicker">
          CONTACT JHARKHAND TOURISM
        </span>


        <h2>
          Questions are part
          of every good journey.
        </h2>


        <p class="jt-contact-intro">
          Whether you’re looking for information before your trip
          or need help exploring the portal, send us a message.
        </p>


        <div class="jt-contact-details">

          <a
            href="tel:+916512480000"
            class="jt-contact-detail"
          >

            <span class="jt-contact-detail-icon">
              <i
                class="fa-solid fa-phone"
                aria-hidden="true"
              ></i>
            </span>

            <span>
              <strong>Tourism Helpline</strong>
              <small>+91 651 248 0000</small>
            </span>

          </a>


          <a
            href="mailto:tourism@jharkhand.gov.in"
            class="jt-contact-detail"
          >

            <span class="jt-contact-detail-icon">
              <i
                class="fa-solid fa-envelope"
                aria-hidden="true"
              ></i>
            </span>

            <span>
              <strong>Email</strong>
              <small>tourism@jharkhand.gov.in</small>
            </span>

          </a>


          <div class="jt-contact-detail">

            <span class="jt-contact-detail-icon">
              <i
                class="fa-solid fa-location-dot"
                aria-hidden="true"
              ></i>
            </span>

            <span>
              <strong>Tourism Department</strong>
              <small>
                Ranchi, Jharkhand, India
              </small>
            </span>

          </div>

        </div>


        <div class="jt-contact-note">

          <i
            class="fa-solid fa-compass"
            aria-hidden="true"
          ></i>

          <p>
            Exploring the state for the first time?
            Start with our destinations and build your
            journey around places that interest you.
          </p>

        </div>

      </div>


      <!-- ======================================================
           FORM
      ======================================================= -->

      <div class="jt-contact-form-wrap">

        <div class="jt-contact-form-heading">

          <span>
            SEND A MESSAGE
          </span>

          <h3>
            How can we help?
          </h3>

        </div>


        <form
          action="/feedback"
          method="POST"
          class="jt-contact-form"
        >

          <!-- ==================================================
               BASIC DETAILS
          =================================================== -->

          <div class="jt-contact-form-row">

            <div class="jt-contact-field">

              <label for="contactName">
                Your name
              </label>

              <input
                type="text"
                id="contactName"
                name="name"
                placeholder="Enter your name"
                autocomplete="name"
                required
              >

            </div>


            <div class="jt-contact-field">

              <label for="contactEmail">
                Email address
              </label>

              <input
                type="email"
                id="contactEmail"
                name="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              >

            </div>

          </div>


          <!-- ==================================================
               SUBJECT + BACKEND CATEGORY
          =================================================== -->

          <div class="jt-contact-form-row">

            <div class="jt-contact-field">

              <label for="contactSubject">
                Subject
              </label>

              <input
                type="text"
                id="contactSubject"
                name="subject"
                placeholder="What would you like to know?"
                required
              >

            </div>


            <div class="jt-contact-field">

              <label for="contactCategory">
                Topic
              </label>

              <select
                id="contactCategory"
                name="category"
                required
              >

                <option
                  value=""
                  selected
                  disabled
                >
                  Select a topic
                </option>

                <option value="Place">
                  Destinations & Places
                </option>

                <option value="Hotel">
                  Hotels & Stays
                </option>

                <option value="Transport">
                  Transport
                </option>

                <option value="Smart Tourism">
                  Smart Tourism
                </option>

                <option value="Food">
                  Local Food
                </option>

                <option value="Website">
                  Website / Portal
                </option>

                <option value="Other">
                  Other
                </option>

              </select>

            </div>

          </div>


          <!-- ==================================================
               REQUIRED RATING
          =================================================== -->

          <div class="jt-contact-field">

            <label>
              Your rating
            </label>


            <div
              class="jt-contact-rating"
              role="radiogroup"
              aria-label="Rate your experience from 1 to 5"
            >

              <div class="jt-contact-rating-option">

                <input
                  type="radio"
                  id="rating1"
                  name="rating"
                  value="1"
                  required
                >

                <label for="rating1">

                  <i
                    class="fa-solid fa-star"
                    aria-hidden="true"
                  ></i>

                  1

                </label>

              </div>


              <div class="jt-contact-rating-option">

                <input
                  type="radio"
                  id="rating2"
                  name="rating"
                  value="2"
                >

                <label for="rating2">

                  <i
                    class="fa-solid fa-star"
                    aria-hidden="true"
                  ></i>

                  2

                </label>

              </div>


              <div class="jt-contact-rating-option">

                <input
                  type="radio"
                  id="rating3"
                  name="rating"
                  value="3"
                >

                <label for="rating3">

                  <i
                    class="fa-solid fa-star"
                    aria-hidden="true"
                  ></i>

                  3

                </label>

              </div>


              <div class="jt-contact-rating-option">

                <input
                  type="radio"
                  id="rating4"
                  name="rating"
                  value="4"
                >

                <label for="rating4">

                  <i
                    class="fa-solid fa-star"
                    aria-hidden="true"
                  ></i>

                  4

                </label>

              </div>


              <div class="jt-contact-rating-option">

                <input
                  type="radio"
                  id="rating5"
                  name="rating"
                  value="5"
                >

                <label for="rating5">

                  <i
                    class="fa-solid fa-star"
                    aria-hidden="true"
                  ></i>

                  5

                </label>

              </div>


              <span class="jt-contact-rating-help">
                Select one rating before sending your feedback.
              </span>

            </div>

          </div>


          <!-- ==================================================
               MESSAGE
          =================================================== -->

          <div class="jt-contact-field">

            <label for="contactMessage">
              Message
            </label>

            <textarea
              id="contactMessage"
              name="message"
              rows="7"
              placeholder="Tell us how we can help..."
              required
            ></textarea>

          </div>


          <!-- ==================================================
               SUBMIT
          =================================================== -->

          <div class="jt-contact-form-bottom">

            <p>

              <i
                class="fa-solid fa-shield-halved"
                aria-hidden="true"
              ></i>

              Your message and rating will be handled through the
              tourism portal.

            </p>


            <button
              type="submit"
              class="jt-btn jt-btn-primary"
            >

              Send message

              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>

            </button>

          </div>

        </form>

      </div>

    </div>

  </section>


  <!-- ==========================================================
       EXPLORE CTA
  =========================================================== -->

  <section class="jt-contact-explore">

    <div class="jt-contact-explore-inner">

      <div>

        <span class="jt-contact-explore-label">
          BEFORE YOU WRITE
        </span>


        <h2>
          Maybe your answer
          is already waiting.
        </h2>


        <p>
          Explore destinations, festivals, hotels and
          Smart Tourism experiences across Jharkhand.
        </p>

      </div>


      <div class="jt-contact-explore-actions">

        <a
          href="/places"
          class="jt-btn jt-btn-light"
        >

          Explore destinations

          <i
            class="fa-solid fa-arrow-right"
            aria-hidden="true"
          ></i>

        </a>


        <a
          href="/planner"
          class="jt-contact-text-link"
        >

          Plan a trip

          <i
            class="fa-solid fa-arrow-up-right-from-square"
            aria-hidden="true"
          ></i>

        </a>

      </div>

    </div>

  </section>

</main>