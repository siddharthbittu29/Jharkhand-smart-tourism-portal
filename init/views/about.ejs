  <!-- ==========================================================
       HERO
  =========================================================== -->

  <section class="jt-about-hero">

    <div class="jt-about-hero-inner">

      <span class="jt-about-eyebrow">

        <i
          class="fa-solid fa-landmark"
          aria-hidden="true"
        ></i>

        About Jharkhand Tourism

      </span>


      <h1
        id="aboutTitle"
        class="jt-about-title"
      >
        <%= aboutTitle %>
      </h1>


      <p class="jt-about-subtitle">
        <%= aboutSubtitle %>
      </p>


      <div class="jt-about-hero-actions">

        <a
          href="/places"
          class="jt-about-hero-btn primary"
        >
          Explore destinations

          <i
            class="fa-solid fa-arrow-right"
            aria-hidden="true"
          ></i>
        </a>


        <a
          href="/smart-tourism"
          class="jt-about-hero-btn secondary"
        >
          Discover Smart Tourism

          <i
            class="fa-solid fa-compass"
            aria-hidden="true"
          ></i>
        </a>

      </div>

    </div>

  </section>


  <div class="jt-about-shell">

    <!-- ========================================================
         INTRO
    ========================================================= -->

    <section
      class="jt-about-intro"
      aria-labelledby="aboutIntroTitle"
    >

      <div class="jt-about-intro-copy">

        <div class="jt-about-section-kicker">
          The destination
        </div>

        <h2
          id="aboutIntroTitle"
          class="jt-about-section-title"
        >
          Nature, culture and history in one landscape.
        </h2>


        <p>
          Jharkhand, carved out of Bihar on
          <strong>15 November 2000</strong>,
          is a mosaic of lush forests, rolling plateaus,
          and red-soil valleys.
        </p>


        <p>
          It is home to soaring waterfalls like
          <em>Lodh</em> and <em>Hundru</em>, serene valleys
          such as <em>Patratu</em>, and wilderness treasures
          including <em>Betla National Park</em>.
        </p>


        <p>
          With rich mineral resources and over two dozen
          indigenous communities, Jharkhand blends nature,
          culture, and tradition.
        </p>


        <div class="jt-about-pills">

          <span class="jt-about-pill">
            <i
              class="fa-solid fa-water"
              aria-hidden="true"
            ></i>
            Waterfalls
          </span>

          <span class="jt-about-pill">
            <i
              class="fa-solid fa-paw"
              aria-hidden="true"
            ></i>
            Wildlife
          </span>

          <span class="jt-about-pill">
            <i
              class="fa-solid fa-people-group"
              aria-hidden="true"
            ></i>
            Tribal Heritage
          </span>

          <span class="jt-about-pill">
            <i
              class="fa-solid fa-place-of-worship"
              aria-hidden="true"
            ></i>
            Sacred Shrines
          </span>

          <span class="jt-about-pill">
            <i
              class="fa-solid fa-person-hiking"
              aria-hidden="true"
            ></i>
            Adventure
          </span>

        </div>

      </div>


      <div class="jt-about-intro-image">

        <img
          src="/images/netarhat.jpg"
          alt="Netarhat landscape in Jharkhand"
          loading="eager"
        >

        <span class="jt-about-image-caption">
          Netarhat • Jharkhand
        </span>

      </div>

    </section>


    <!-- ========================================================
         BEAUTY OF JHARKHAND
    ========================================================= -->

    <section
      aria-labelledby="beautyTitle"
    >

      <div class="jt-about-section-head">

        <div class="jt-about-section-kicker">
          Discover the landscape
        </div>

        <h2
          id="beautyTitle"
          class="jt-about-section-title"
        >
          Beauty of Jharkhand
        </h2>

        <p class="jt-about-section-copy">
          From mountain roads and forests to sacred architecture,
          the state brings together distinct travel experiences.
        </p>

