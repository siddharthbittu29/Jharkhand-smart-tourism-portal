<%
/*
 * ============================================================
 * BRAVO — HOMEPAGE
 * File: init/views/home.ejs
 *
 * IMPORTANT:
 * - This file is intentionally a BODY/CONTENT view.
 * - Global <html>, <head>, navbar and footer are owned by
 *   layout.ejs + shared partials.
 * - Existing homepage features are preserved.
 * - No duplicate navbar/footer is created here.
 * ============================================================
 */

/* Safe i18n defaults */
var homeT = (typeof t !== "undefined" && t) || {
  sitemap: "Sitemap",
  skip: "Skip To Main Content",
  access: "Accessibility",
  about: "About Us",
  contact: "Contact Us",
  reservations: "JTDC Reservations",
  helpline: "Tourism Helpline"
};

var homeLang =
  (typeof lang !== "undefined" && lang) || "en";

/*
 * Optional dynamic values.
 *
 * The current / route does not provide these values, so the
 * existing homepage numbers are retained as fallbacks.
 */
var touristPlacesCount =
  (typeof placesCount !== "undefined" && placesCount !== null)
    ? placesCount
    : "250+";

var hotelsCount =
  (typeof hotelCount !== "undefined" && hotelCount !== null)
    ? hotelCount
    : "120+";
%>


<!-- =========================================================
     HOMEPAGE ROOT
========================================================= -->

<div class="bravo-home">


  <!-- =======================================================
       OFFICIAL TOURISM UTILITY STRIP

       Preserves the original homepage's language,
       reservation and tourism helpline functionality without
       recreating the complete navbar.
  ======================================================== -->

  <section
    class="bravo-home-official-strip"
    aria-label="Tourism information"
  >

    <div class="bravo-container">

      <div class="bravo-home-official-inner">

        <div class="bravo-home-official-left">

          <span class="bravo-home-official-label">
            <i class="fa-solid fa-landmark" aria-hidden="true"></i>
            Official Tourism Information
          </span>

          <span class="bravo-home-official-divider"
                aria-hidden="true"></span>

          <a
            href="tel:06512438866"
            class="bravo-home-official-link"
            aria-label="JTDC Reservation phone number"
          >
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
            0651-2438866
          </a>

          <a
            href="tel:2438002"
            class="bravo-home-official-link"
            aria-label="JTDC Reservation alternate phone number"
          >
            2438002
          </a>

          <a
            href="tel:1364"
            class="bravo-home-official-link"
            aria-label="Tourism helpline 1364"
          >
            <i class="fa-solid fa-headset" aria-hidden="true"></i>
            1364 Tourism Helpline
          </a>

        </div>


        <div class="bravo-home-official-right">

          <form
            action="/lang"
            method="POST"
            class="bravo-home-language-form"
          >

            <label
              for="bravoLanguage"
              class="visually-hidden"
            >
              Select language
            </label>

            <i
              class="fa-solid fa-language"
              aria-hidden="true"
            ></i>

            <select
              id="bravoLanguage"
              name="lang"
              onchange="this.form.submit()"
              aria-label="Select language"
            >

              <option
                value="en"
                <%= homeLang === "en" ? "selected" : "" %>
              >
                English
              </option>

              <option
                value="hi"
                <%= homeLang === "hi" ? "selected" : "" %>
              >
                हिन्दी
              </option>

            </select>

          </form>


          <a
            href="/accessibility"
            class="bravo-home-official-link"
          >
            <i
              class="fa-solid fa-universal-access"
              aria-hidden="true"
            ></i>
            <span>
              <%= homeT.access || "Accessibility" %>
            </span>
          </a>


          <a
            href="/sitemap.xml"
            class="bravo-home-official-link"
          >
            <i
              class="fa-solid fa-sitemap"
              aria-hidden="true"
            ></i>
            <span>
              <%= homeT.sitemap || "Sitemap" %>
            </span>
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =======================================================
       ANNOUNCEMENTS
  ======================================================== -->

  <section
    class="bravo-home-announcement"
    aria-label="Tourism announcements"
  >

    <div class="bravo-container">

      <div class="bravo-home-announcement-inner">

        <span class="bravo-home-announcement-label">

          <i
            class="fa-solid fa-bullhorn"
            aria-hidden="true"
          ></i>

          Updates

        </span>


        <div class="bravo-home-announcement-track">

          <div class="bravo-home-announcement-content">

            <span>
              Circular - Updated Tariff for JTDC Hotels
            </span>

            <span aria-hidden="true">•</span>

            <span>
              Tender - Eco Resort at Netarhat
            </span>

            <span aria-hidden="true">•</span>

            <span>
              Jharkhand Monsoon on a Plate
            </span>

            <span aria-hidden="true">•</span>

            <span>
              Patratu Valley Ropeway Project
            </span>

            <span aria-hidden="true">•</span>

            <span>
              Jharkhand – India’s Green Tourism Pioneer
            </span>

            <span aria-hidden="true">•</span>

            <span>
              Trek to Lodh Falls - Winter 2025
            </span>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =======================================================
       HERO
  ======================================================== -->

  <section
    class="bravo-home-hero"
    aria-labelledby="bravoHeroTitle"
  >


    <!-- Existing local project image.
         No external production image is introduced. -->

    <div class="bravo-home-hero-media">

      <img
        src="/images/discover/patratu.jpg"
        alt="Scenic Patratu Valley in Jharkhand"
        loading="eager"
        fetchpriority="high"
      >

    </div>


    <div class="bravo-container">

      <div class="bravo-home-hero-content">

        <div class="bravo-home-hero-grid">


          <!-- HERO COPY -->

          <div class="bravo-home-hero-copy bravo-reveal">

            <div class="bravo-home-hero-eyebrow">

              <i
                class="fa-solid fa-leaf"
                aria-hidden="true"
              ></i>

              Explore • Experience • Preserve

            </div>


            <h1
              id="bravoHeroTitle"
              class="bravo-home-hero-title"
            >

              Discover

              <span>Jharkhand</span>

            </h1>


            <p class="bravo-home-hero-description">

              Discover waterfalls, wildlife, temples, festivals
              and immersive travel experiences through a smarter
              way to explore Jharkhand.

            </p>


            <div class="bravo-home-hero-actions">

              <a
                href="/places"
                class="bravo-home-hero-primary bravo-btn"
              >

                <i
                  class="fa-solid fa-compass"
                  aria-hidden="true"
                ></i>

                Explore Places

              </a>


              <a
                href="/planner"
                class="bravo-home-hero-secondary bravo-btn"
              >

                <i
                  class="fa-solid fa-wand-magic-sparkles"
                  aria-hidden="true"
                ></i>

                Plan My Journey

              </a>

            </div>

          </div>


          <!-- HERO SEARCH / SMART PLANNER PANEL -->

          <div
            class="bravo-home-search-panel bravo-reveal"
          >

            <div
              class="bravo-home-search-panel-header"
            >

              <div
                class="bravo-home-search-panel-icon"
              >

                <i
                  class="fa-solid fa-location-dot"
                  aria-hidden="true"
                ></i>

              </div>


              <div>

                <strong>
                  Start exploring
                </strong>

                <small>
                  Search destinations, districts and experiences
                </small>

              </div>

            </div>


            <!-- Existing place search functionality.
                 /places expects q=... -->

            <form
              action="/places"
              method="GET"
              class="bravo-home-search"
              role="search"
              aria-label="Search Jharkhand destinations"
            >

              <i
                class="fa-solid fa-magnifying-glass"
                aria-hidden="true"
              ></i>


              <label
                for="globalSearch"
                class="visually-hidden"
              >
                Search places, hotels, waterfalls and wildlife
              </label>


              <input
                id="globalSearch"
                type="search"
                name="q"
                autocomplete="off"
                placeholder="Search places, waterfalls, wildlife..."
                aria-describedby="searchSuggestions"
              >


              <button
                type="submit"
                aria-label="Search"
              >

                <i
                  class="fa-solid fa-arrow-right"
                  aria-hidden="true"
                ></i>

              </button>

            </form>


            <div
              id="searchSuggestions"
              class="bravo-home-search-suggestions"
              aria-live="polite"
            >

              <span
                class="bravo-home-search-suggestion"
                data-search="Waterfalls"
              >
                Waterfalls
              </span>

              <span
                class="bravo-home-search-suggestion"
                data-search="Wildlife"
              >
                Wildlife
              </span>

              <span
                class="bravo-home-search-suggestion"
                data-search="Temples"
              >
                Temples
              </span>

              <span
                class="bravo-home-search-suggestion"
                data-search="Patratu"
              >
                Patratu
              </span>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- HERO STATS -->

    <div class="bravo-home-hero-stats">

      <div class="bravo-container">

        <div class="bravo-home-hero-stats-inner">


          <div class="bravo-home-hero-stat">

            <div class="bravo-home-hero-stat-icon">

              <i
                class="fa-solid fa-location-dot"
                aria-hidden="true"
              ></i>

            </div>

            <div>

              <strong>
                <%= touristPlacesCount %>
              </strong>

              <small>
                Tourist Places
              </small>

            </div>

          </div>


          <div class="bravo-home-hero-stat">

            <div class="bravo-home-hero-stat-icon">

              <i
                class="fa-solid fa-hotel"
                aria-hidden="true"
              ></i>

            </div>

            <div>

              <strong>
                <%= hotelsCount %>
              </strong>

              <small>
                Hotels & Stays
              </small>

            </div>

          </div>


          <div class="bravo-home-hero-stat">

            <div class="bravo-home-hero-stat-icon">

              <i
                class="fa-solid fa-robot"
                aria-hidden="true"
              ></i>

            </div>

            <div>

              <strong>
                AI
              </strong>

              <small>
                Smart Trip Planner
              </small>

            </div>

          </div>


          <div class="bravo-home-hero-stat">

            <div class="bravo-home-hero-stat-icon">

              <i
                class="fa-solid fa-seedling"
                aria-hidden="true"
              ></i>

            </div>

            <div>

              <strong>
                Eco
              </strong>

              <small>
                Sustainable Tourism
              </small>

            </div>

          </div>


        </div>

      </div>

    </div>

  </section>


  <!-- =======================================================
       TRUST / PLATFORM STRIP
  ======================================================== -->

  <section
    class="bravo-home-trust"
    aria-label="Platform capabilities"
  >

    <div class="bravo-container">

      <div class="bravo-home-trust-inner">

        <span class="bravo-home-trust-label">
          A smarter way to travel
        </span>


        <div class="bravo-home-trust-items">

          <span class="bravo-home-trust-item">

            <i
              class="fa-solid fa-map-location-dot"
              aria-hidden="true"
            ></i>

            Discover

          </span>


          <span class="bravo-home-trust-item">

            <i
              class="fa-solid fa-route"
              aria-hidden="true"
            ></i>

            Plan

          </span>


          <span class="bravo-home-trust-item">

            <i
              class="fa-solid fa-leaf"
              aria-hidden="true"
            ></i>

            Travel Responsibly

          </span>


          <span class="bravo-home-trust-item">

            <i
              class="fa-solid fa-people-group"
              aria-hidden="true"
            ></i>

            Connect Locally

          </span>


          <span class="bravo-home-trust-item">

            <i
              class="fa-solid fa-wand-magic-sparkles"
              aria-hidden="true"
            ></i>

            Travel Smarter

          </span>

        </div>

      </div>

    </div>

  </section>


  <!-- =======================================================
       FEATURED DESTINATIONS
  ======================================================== -->

  <section
    class="bravo-section bravo-home-destinations"
    aria-labelledby="featuredDestinationsTitle"
  >

    <div class="bravo-container">


      <div class="bravo-section-header bravo-reveal">

        <span class="bravo-section-badge">

          <i
            class="fa-solid fa-compass"
            aria-hidden="true"
          ></i>

          Featured destinations

        </span>


        <h2
          id="featuredDestinationsTitle"
          class="bravo-section-title"
        >
          Places worth discovering
        </h2>


        <p class="bravo-section-description">
          Start with some of Jharkhand's most recognizable
          natural and cultural experiences.
        </p>

      </div>


      <div class="bravo-home-destination-grid">


        <!-- LODH FALLS -->

        <a
          href="/places?q=Lodh"
          class="bravo-home-destination-card bravo-reveal"
        >

          <img
            src="/images/discover/lodh-falls.jpg"
            alt="Lodh Falls"
            loading="lazy"
          >


          <span class="bravo-home-destination-arrow">

            <i
              class="fa-solid fa-arrow-up-right-from-square"
              aria-hidden="true"
            ></i>

          </span>


          <div class="bravo-home-destination-content">

            <span class="bravo-home-destination-category">

              <i
                class="fa-solid fa-water"
                aria-hidden="true"
              ></i>

              Waterfall

            </span>


            <h3>
              Lodh Falls
            </h3>


            <p>
              A scenic waterfall surrounded by dense forest
              landscapes.
            </p>

          </div>

        </a>


        <!-- BETLA -->

        <a
          href="/places?q=Betla"
          class="bravo-home-destination-card bravo-reveal"
        >

          <img
            src="/images/discover/betla.jpg"
            alt="Betla National Park"
            loading="lazy"
          >


          <span class="bravo-home-destination-arrow">

            <i
              class="fa-solid fa-arrow-up-right-from-square"
              aria-hidden="true"
            ></i>

          </span>


          <div class="bravo-home-destination-content">

            <span class="bravo-home-destination-category">

              <i
                class="fa-solid fa-paw"
                aria-hidden="true"
              ></i>

              Wildlife

            </span>


            <h3>
              Betla National Park
            </h3>


            <p>
              Forest landscapes and wildlife experiences.
            </p>

          </div>

        </a>


        <!-- PATRATU -->

        <a
          href="/places?q=Patratu"
          class="bravo-home-destination-card bravo-reveal"
        >

          <img
            src="/images/discover/patratu.jpg"
            alt="Patratu Valley"
            loading="lazy"
          >


          <span class="bravo-home-destination-arrow">

            <i
              class="fa-solid fa-arrow-up-right-from-square"
              aria-hidden="true"
            ></i>

          </span>


          <div class="bravo-home-destination-content">

            <span class="bravo-home-destination-category">

              <i
                class="fa-solid fa-mountain-sun"
                aria-hidden="true"
              ></i>

              Valley

            </span>


            <h3>
              Patratu Valley
            </h3>


            <p>
              Winding roads and panoramic valley views.
            </p>

          </div>

        </a>


        <!-- EXPLORE ALL -->

        <a
          href="/places"
          class="bravo-home-destination-card bravo-reveal"
        >

          <img
            src="/images/what-to-see/adventure.jpg"
            alt="Explore more destinations in Jharkhand"
            loading="lazy"
          >


          <span class="bravo-home-destination-arrow">

            <i
              class="fa-solid fa-arrow-right"
              aria-hidden="true"
            ></i>

          </span>


          <div class="bravo-home-destination-content">

            <span class="bravo-home-destination-category">

              <i
                class="fa-solid fa-map"
                aria-hidden="true"
              ></i>

              Explore

            </span>


            <h3>
              Explore More Places
            </h3>


            <p>
              Browse destinations and discover your next
              Jharkhand experience.
            </p>

          </div>

        </a>


      </div>

    </div>

  </section>


  <!-- =======================================================
       AI SMART PLANNER
  ======================================================== -->

  <section
    class="bravo-section bravo-home-smart"
    aria-labelledby="smartPlannerTitle"
  >

    <div class="bravo-container">

      <div class="bravo-home-smart-grid">


        <div class="bravo-home-smart-copy bravo-reveal">


          <span class="bravo-section-badge">

            <i
              class="fa-solid fa-wand-magic-sparkles"
              aria-hidden="true"
            ></i>

            Smart Tourism

          </span>


          <h2
            id="smartPlannerTitle"
            class="bravo-section-title"
          >
            Plan a better journey with AI
          </h2>


          <p class="bravo-section-description">
            Tell Bravo where you want to go, how long you have
            and your budget. The existing AI planner can build
            a personalized Jharkhand travel plan.
          </p>


          <div class="bravo-home-smart-features">


            <div class="bravo-home-smart-feature">

              <div class="bravo-home-smart-feature-icon">

                <i
                  class="fa-solid fa-route"
                  aria-hidden="true"
                ></i>

              </div>

              <strong>
                Personalized itinerary
              </strong>

              <small>
                Build a trip around your destination and time.
              </small>

            </div>


            <div class="bravo-home-smart-feature">

              <div class="bravo-home-smart-feature-icon">

                <i
                  class="fa-solid fa-wallet"
                  aria-hidden="true"
                ></i>

              </div>

              <strong>
                Budget-aware planning
              </strong>

              <small>
                Plan around the budget you provide.
              </small>

            </div>


            <div class="bravo-home-smart-feature">

              <div class="bravo-home-smart-feature-icon">

                <i
                  class="fa-solid fa-cloud-sun"
                  aria-hidden="true"
                ></i>

              </div>

              <strong>
                Travel context
              </strong>

              <small>
                Bring weather and destination insights together.
              </small>

            </div>


            <div class="bravo-home-smart-feature">

              <div class="bravo-home-smart-feature-icon">

                <i
                  class="fa-solid fa-leaf"
                  aria-hidden="true"
                ></i>

              </div>

              <strong>
                Eco-aware travel
              </strong>

              <small>
                Keep sustainable tourism in the journey.
              </small>

            </div>


          </div>


          <a
            href="/planner"
            class="bravo-btn bravo-btn-primary"
          >

            <i
              class="fa-solid fa-wand-magic-sparkles"
              aria-hidden="true"
            ></i>

            Open AI Planner

          </a>


        </div>


        <div class="bravo-home-smart-visual bravo-reveal">


          <div class="bravo-home-smart-image">

            <img
              src="/images/discover/patratu.jpg"
              alt="Jharkhand travel landscape"
              loading="lazy"
            >

          </div>


          <div class="bravo-home-smart-floating-card">

            <div class="bravo-home-smart-floating-top">

              <strong>
                Smart Travel
              </strong>

              <span class="bravo-home-smart-score">
                ECO READY
              </span>

            </div>


            <div class="bravo-home-smart-progress">
              <span></span>
            </div>


            <p class="bravo-home-smart-floating-caption">
              Explore • Plan • Experience
            </p>

          </div>


        </div>

      </div>

    </div>

  </section>


  <!-- =======================================================
       EXPERIENCE JHARKHAND
