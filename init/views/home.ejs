      </div>

    </div>

  </section>


  <!-- =======================================================
       DISCOVER JHARKHAND
  ======================================================== -->

  <section
    class="bravo-section bravo-home-destinations"
    aria-labelledby="discoverTitle"
  >

    <div class="bravo-container">


      <div class="bravo-section-header center bravo-reveal">

        <span class="bravo-section-badge">

          <i
            class="fa-solid fa-map-location-dot"
            aria-hidden="true"
          ></i>

          Discover

