<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#174b3c"
  >

  <title>
    <%= typeof title !== "undefined" && title
      ? title + " | Jharkhand Tourism"
      : "Jharkhand Tourism" %>
  </title>

  <!-- Google Fonts -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
    rel="stylesheet"
  >

  <!-- Bootstrap -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Font Awesome -->

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <!-- Authentication CSS -->

  <link
    rel="stylesheet"
    href="/css/auth.css"
  >

  <% if (typeof headContent !== "undefined") { %>
    <%- headContent %>
  <% } %>

</head>


<body>

  <%- body %>


  <!-- Bootstrap -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>


  <!-- Authentication interactions -->

  <script>

    document.addEventListener("DOMContentLoaded", function () {

      document
        .querySelectorAll("[data-password-target]")
        .forEach(function (toggle) {

          const targetId =
            toggle.getAttribute("data-password-target");

          const input =
            document.getElementById(targetId);

          const icon =
            toggle.querySelector("i");

          if (!input || !icon) {
            return;
          }

          toggle.addEventListener("click", function () {

            const isPassword =
              input.type === "password";

            input.type =
              isPassword ? "text" : "password";

            toggle.setAttribute(
              "aria-label",
              isPassword
                ? "Hide password"
                : "Show password"
            );

            icon.classList.toggle(
              "fa-eye",
              !isPassword
            );

            icon.classList.toggle(
              "fa-eye-slash",
              isPassword
            );

          });

        });

    });

  </script>

</body>

</html>