<!-- ============================================================
     JHARKHAND TOURISM — PREMIUM FOOTER
============================================================ -->

<footer class="jt-footer" role="contentinfo">

    <div class="jt-container">

        <!-- ====================================================
             FOOTER MAIN
        ===================================================== -->

        <div class="jt-footer-main">

            <!-- BRAND -->
            <div class="jt-footer-brand">

                <a
                    href="/"
                    class="jt-footer-logo"
                    aria-label="Jharkhand Tourism home"
                >

                    <span
                        class="jt-footer-logo-mark"
                        aria-hidden="true"
                    >
                        <i class="fa-solid fa-tree"></i>
                    </span>

                    <span>
                        <strong>JHARKHAND</strong>
                        <small>Tourism</small>
                    </span>

                </a>


                <p class="jt-footer-description">
                    Discover forests, waterfalls, wildlife, culture,
                    heritage and unforgettable journeys across Jharkhand.
                    Plan your experience with a modern digital tourism
                    platform built around discovery, sustainability and
                    local experiences.
                </p>


                <!-- PLATFORM STATUS -->

                <div
                    class="jt-footer-status"
                    aria-label="Jharkhand Tourism platform status"
                >

                    <span
                        class="jt-status-dot"
                        aria-hidden="true"
                    ></span>

                    <span>
                        Tourism platform online
                    </span>

                </div>


                <!-- SOCIAL / DIGITAL PRESENCE -->

                <div
                    class="jt-footer-socials"
                    aria-label="Digital links"
                >

                    <a
                        href="/sitemap.xml"
                        aria-label="Website sitemap"
                        title="Sitemap"
                    >
                        <i class="fa-solid fa-sitemap"></i>
                    </a>

                    <a
                        href="/gallery"
                        aria-label="Jharkhand Tourism gallery"
                        title="Gallery"
                    >
                        <i class="fa-regular fa-images"></i>
                    </a>

                    <a
                        href="/contact"
                        aria-label="Contact Jharkhand Tourism"
                        title="Contact"
                    >
                        <i class="fa-regular fa-envelope"></i>
                    </a>

                    <a
                        href="/chatbot"
                        aria-label="Open AI Tourism Assistant"
                        title="AI Tourism Assistant"
                    >
                        <i class="fa-solid fa-robot"></i>
                    </a>

                </div>

            </div>


            <!-- =================================================
                 EXPLORE
            ================================================== -->

            <div class="jt-footer-column">

                <h2>
                    Explore
                </h2>

                <ul>

                    <li>
                        <a href="/places">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Destinations</span>
                        </a>
                    </li>

                    <li>
                        <a href="/gallery">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Gallery</span>
                        </a>
                    </li>

                    <li>
                        <a href="/festivals">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Festivals</span>
                        </a>
                    </li>

                    <li>
                        <a href="/smart-tourism">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Smart Tourism</span>
                        </a>
                    </li>

                    <li>
                        <a href="/about">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>About Jharkhand</span>
                        </a>
                    </li>

                </ul>

            </div>


            <!-- =================================================
                 PLAN
            ================================================== -->

            <div class="jt-footer-column">

                <h2>
                    Plan
                </h2>

                <ul>

                    <li>
                        <a href="/planner">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>AI Trip Planner</span>
                        </a>
                    </li>

                    <li>
                        <a href="/hotels">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Find Hotels</span>
                        </a>
                    </li>

                    <li>
                        <a href="/places">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Explore Places</span>
                        </a>
                    </li>

                    <li>
                        <a href="/chatbot">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>AI Assistant</span>
                        </a>
                    </li>

                    <li>
                        <a href="/downloads">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Downloads</span>
                        </a>
                    </li>

                </ul>

            </div>


            <!-- =================================================
                 VISITOR SUPPORT
            ================================================== -->

            <div class="jt-footer-column">

                <h2>
                    Visitor Support
                </h2>

                <ul>

                    <li>
                        <a href="/contact">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Contact Us</span>
                        </a>
                    </li>

                    <li>
                        <a href="/feedback">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Share Feedback</span>
                        </a>
                    </li>

                    <li>
                        <a href="/accessibility">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Accessibility</span>
                        </a>
                    </li>

                    <li>
                        <a href="/sitemap.xml">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>Sitemap</span>
                        </a>
                    </li>

                    <li>
                        <a href="/health">
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>System Status</span>
                        </a>
                    </li>

                </ul>

            </div>

        </div>


        <!-- ====================================================
             FOOTER CTA
        ===================================================== -->

        <div class="jt-footer-cta">

            <div
                class="jt-footer-cta-icon"
                aria-hidden="true"
            >
                <i class="fa-solid fa-route"></i>
            </div>


            <div class="jt-footer-cta-copy">

                <span>
                    READY TO EXPLORE?
                </span>

                <strong>
                    Build your Jharkhand journey.
                </strong>

            </div>


            <a
                href="/planner"
                class="jt-footer-cta-button"
            >

                <span>
                    Plan Your Trip
                </span>

                <i
                    class="fa-solid fa-arrow-right"
                    aria-hidden="true"
                ></i>

            </a>

        </div>


        <!-- ====================================================
             FOOTER BOTTOM
        ===================================================== -->

        <div class="jt-footer-bottom">

            <div class="jt-footer-copyright">

                &copy;
                <%= new Date().getFullYear() %>
                Jharkhand Tourism.
                All rights reserved.

            </div>


            <div class="jt-footer-legal">

                <a href="/privacy">
                    Privacy
                </a>

                <span aria-hidden="true">
                    ·
                </span>

                <a href="/terms">
                    Terms
                </a>

                <span aria-hidden="true">
                    ·
                </span>

                <a href="/accessibility">
                    Accessibility
                </a>

                <span aria-hidden="true">
                    ·
                </span>

                <a href="/sitemap.xml">
                    Sitemap
                </a>

            </div>


            <div class="jt-footer-tagline">

                Made for travellers
                <i
                    class="fa-solid fa-heart"
                    aria-hidden="true"
                ></i>
                exploring Jharkhand.

            </div>

        </div>

    </div>

</footer>