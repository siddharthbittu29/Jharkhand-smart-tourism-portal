<%
  /*
   * ============================================================
   * BRAVO — SHARED HEAD CONTENT
   * ============================================================
   *
   * This partial intentionally does NOT contain:
   *
   * - <html>
   * - <head>
   * - <body>
   * - Bootstrap
   * - Font Awesome
   * - Global CSS
   * - Global JavaScript
   *
   * Those resources are owned by layout.ejs.
   *
   * This file is responsible only for optional metadata
   * and page-specific head information.
   * ============================================================
   */

  const bravoTitle =
    typeof title !== "undefined" && title
      ? title + " | Bravo – Jharkhand Tourism"
      : "Bravo – Jharkhand Tourism";

  const bravoDescription =
    typeof metaDescription !== "undefined" && metaDescription
      ? metaDescription
      : "Discover Jharkhand through destinations, culture, wildlife, smart tourism and AI-powered travel planning.";

  const bravoKeywords =
    typeof metaKeywords !== "undefined" && metaKeywords
      ? metaKeywords
      : "Jharkhand Tourism, Jharkhand Travel, Tourism, Ranchi, Netarhat, Waterfalls, Wildlife, Smart Tourism, AI Travel Planner";

  const bravoCanonical =
    typeof canonicalUrl !== "undefined" && canonicalUrl
      ? canonicalUrl
      : null;
%>


<!-- ============================================================
     BRAVO PAGE METADATA
============================================================= -->

<meta
  name="description"
  content="<%= bravoDescription %>"
>

<meta
  name="keywords"
  content="<%= bravoKeywords %>"
>

<meta
  name="author"
  content="Bravo – Jharkhand Tourism"
>


<!-- ============================================================
     CANONICAL URL
     Only rendered when explicitly supplied by the page.
============================================================= -->

<% if (bravoCanonical) { %>

<link
  rel="canonical"
  href="<%= bravoCanonical %>"
>

<% } %>


<!-- ============================================================
     OPEN GRAPH
============================================================= -->

<meta
  property="og:title"
  content="<%= bravoTitle %>"
>

<meta
  property="og:description"
  content="<%= bravoDescription %>"
>

<meta
  property="og:type"
  content="website"
>

<% if (bravoCanonical) { %>

<meta
  property="og:url"
  content="<%= bravoCanonical %>"
>

<% } %>


<!-- ============================================================
     TWITTER / SOCIAL PREVIEW
============================================================= -->

<meta
  name="twitter:card"
  content="summary_large_image"
>

<meta
  name="twitter:title"
  content="<%= bravoTitle %>"
>

<meta
  name="twitter:description"
  content="<%= bravoDescription %>"
>


<!-- ============================================================
     FAVICON
     Uses the existing public asset when available.
============================================================= -->

<link
  rel="icon"
  type="image/png"
  href="/images/logo.png"
>


<!-- ============================================================
     PAGE-SPECIFIC EXTRA HEAD CONTENT
     
     Individual routes may provide additional safe metadata
     through `extraHead`.
============================================================= -->

<% if (typeof extraHead !== "undefined" && extraHead) { %>

  <%- extraHead %>

<% } %>