<%
/*
 * ============================================================
 * JHARKHAND TOURISM
 * SMART TOURISM — OBJECTIVES PARTIAL
 * File: init/views/partials/smart/objectives.ejs
 *
 * Purpose:
 * Reusable objectives section for Smart Tourism pages.
 * ============================================================
 */

const objectiveItems = [
  {
    number: "01",
    title: "Digital First",
    icon: "fa-mobile-screen-button",
    text:
      "Create a stronger digital layer for destination discovery, information access, planning and visitor interaction."
  },
  {
    number: "02",
    title: "Sustainable Growth",
    icon: "fa-leaf",
    text:
      "Keep responsible travel, eco-tourism and sustainability visible within the tourism experience."
  },
  {
    number: "03",
    title: "Inclusive Tourism",
    icon: "fa-universal-access",
    text:
      "Reduce information and accessibility barriers so more visitors can participate in tourism experiences."
  },
  {
    number: "04",
    title: "Smart Operations",
    icon: "fa-gears",
    text:
      "Support connected tourism workflows through structured information, digital services and technology."
  },
  {
    number: "05",
    title: "Safety & Trust",
    icon: "fa-shield-halved",
    text:
      "Keep trustworthy information, visitor confidence and safer tourism interactions central to the platform."
  },
  {
    number: "06",
    title: "Brand Jharkhand",
    icon: "fa-mountain-sun",
    text:
      "Strengthen Jharkhand's digital tourism identity through nature, culture, heritage and adventure."
  }
];
%>


<!-- ============================================================
     OBJECTIVES SECTION
============================================================ -->

<section
  class="jt-smart-section"
  id="objectives"
  aria-labelledby="smartObjectivesTitle"
>

  <div class="jt-smart-shell">


    <!-- ========================================================
         SECTION HEADER
    ========================================================= -->

    <header class="jt-smart-section-head">

      <span class="jt-smart-section-kicker">

        <i
          class="fa-solid fa-bullseye"
          aria-hidden="true">
        </i>

        Strategic Objectives

      </span>


      <h2 id="smartObjectivesTitle">
        Six pillars shape the Smart Tourism direction.
      </h2>


      <p>
        The Smart Tourism framework connects digital discovery,
        sustainability, inclusion, smarter operations, trust and
        Jharkhand's destination identity.
      </p>

    </header>


    <!-- ========================================================
         OBJECTIVES GRID
    ========================================================= -->

    <div class="jt-objectives-grid">


      <% objectiveItems.forEach((objective) => { %>

        <article
          class="jt-objective-card"
        >


          <!-- ==================================================
               NUMBER
          =================================================== -->

          <span
            class="jt-objective-number"
            aria-hidden="true"
          >
            <%= objective.number %>
          </span>


          <!-- ==================================================
               ICON
          =================================================== -->

          <div
            class="jt-objective-icon"
            aria-hidden="true"
          >

            <i
              class="fa-solid <%= objective.icon %>"
            ></i>

          </div>


          <!-- ==================================================
               CONTENT
          =================================================== -->

          <h3>
            <%= objective.title %>
          </h3>


          <p>
            <%= objective.text %>
          </p>


        </article>

      <% }); %>


    </div>


    <!-- ========================================================
         VISION NOTE
    ========================================================= -->

    <div class="jt-vision-banner">

      <div class="banner-top">

        <h3>
          Strategy first. Technology in service of the journey.
        </h3>


        <span class="jt-vision-tag">

          <i
            class="fa-solid fa-compass"
            aria-hidden="true">
          </i>

          Vision Framework

        </span>

      </div>


      <p>
        These objectives describe the strategic direction of Smart
        Tourism. Individual capabilities may exist at different stages
        of implementation as the wider platform evolves.
      </p>

    </div>


  </div>

</section>