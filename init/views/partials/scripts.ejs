~<%
  /*
   * ============================================================
   * BRAVO — SHARED FRONTEND SCRIPTS
   * ============================================================
   *
   * Central script loader.
   *
   * IMPORTANT:
   * This file should contain reusable libraries only.
   *
   * Page-specific JavaScript belongs to pageScripts and is
   * loaded by layout.ejs when required.
   *
   * This keeps the application modular and prevents duplicate
   * library loading across EJS pages.
   * ============================================================
   */
%>


<!-- ============================================================
     BOOTSTRAP
     Required by navbar dropdowns, mobile navigation, modals,
     tooltips and other existing Bootstrap functionality.
============================================================= -->

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  defer
></script>


<!-- ============================================================
     BRAVO GLOBAL UI SCRIPT
     
     This file is intentionally loaded only when it exists.
     It will contain global interactions such as:
       - navbar scroll behavior
       - mobile UI helpers
       - accessibility helpers
       - global toast handling
============================================================= -->

<script
  src="/js/global.js"
  defer
></script>


<!-- ============================================================
     OPTIONAL PAGE-SPECIFIC SCRIPTS
     
     Routes may provide:
     
     pageScripts: [
       "/js/example.js"
     ]
     
     through the layout.
============================================================= -->

<% if (typeof pageScripts !== "undefined" && Array.isArray(pageScripts)) { %>

  <% pageScripts.forEach(function(script) { %>

    <% if (script) { %>

      <script
        src="<%= script %>"
        defer
      ></script>

    <% } %>

  <% }); %>

<% } %>